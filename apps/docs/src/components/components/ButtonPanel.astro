---
import ComponentPanel from "@/components/panels/ComponentPanel.astro";
import CanvasToolbar from "@/components/panels/CanvasToolbar.astro";
import Canvas from "@/components/panels/Canvas.astro";
import Variants from "@/components/panels/Variants.astro";
import VariantRow from "@/components/panels/VariantRow.astro";
import { sectionNumber } from "@/lib/sections";
import { Button as ButtonReact } from "@/generated/react/Button.tsx";

const usage = `import { Button } from "@/components/ui/Button";

export default function App() {
  return (
    <Button theme="gray" variant="subtle" size="sm">
      Get started
    </Button>
  );
}
`;
---

<ComponentPanel
  id="button"
  num={sectionNumber("button")}
  label="Button"
  desc="Action control matching frappe-ui v1: four themes, solid/subtle/outline/ghost variants, four sizes, loading state, and icon slots."
  status="stable"
  code={usage}
>
  <CanvasToolbar title="Preview" meta="solid · subtle · outline · ghost" />
  <Canvas>
    <ButtonReact client:load theme="gray" variant="solid">Solid</ButtonReact>
    <ButtonReact client:load theme="blue" variant="subtle">Subtle</ButtonReact>
    <ButtonReact client:load theme="green" variant="outline">Outline</ButtonReact>
    <ButtonReact client:load theme="red" variant="ghost">Ghost</ButtonReact>
  </Canvas>

  <Variants>
    <VariantRow label="Themes" sub="gray · blue · green · red">
      <ButtonReact client:load theme="gray" variant="solid">Gray</ButtonReact>
      <ButtonReact client:load theme="blue" variant="solid">Blue</ButtonReact>
      <ButtonReact client:load theme="green" variant="solid">Green</ButtonReact>
      <ButtonReact client:load theme="red" variant="solid">Red</ButtonReact>
    </VariantRow>

    <VariantRow label="Sizes" sub="24 / 28 / 32 / 40 px">
      <ButtonReact client:load size="xs" variant="solid">Extra small</ButtonReact>
      <ButtonReact client:load size="sm" variant="solid">Small</ButtonReact>
      <ButtonReact client:load size="md" variant="solid">Medium</ButtonReact>
      <ButtonReact client:load size="lg" variant="solid">Large</ButtonReact>
    </VariantRow>

    <VariantRow label="Loading" sub="spinner replaces the leading icon">
      <ButtonReact client:load loading>Loading</ButtonReact>
      <ButtonReact client:load loading loadingText="Saving…">Save</ButtonReact>
      <ButtonReact client:load theme="blue" loading>Deploy</ButtonReact>
    </VariantRow>

    <VariantRow label="Disabled" sub="reduced emphasis, no pointer events">
      <ButtonReact client:load variant="solid" disabled>Disabled</ButtonReact>
      <ButtonReact client:load variant="outline" disabled>Disabled</ButtonReact>
    </VariantRow>
  </Variants>
</ComponentPanel>
