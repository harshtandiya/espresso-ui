---
import ComponentPanel from "@/components/panels/ComponentPanel.astro";
import CanvasToolbar from "@/components/panels/CanvasToolbar.astro";
import Canvas from "@/components/panels/Canvas.astro";
import Variants from "@/components/panels/Variants.astro";
import VariantRow from "@/components/panels/VariantRow.astro";
import { sectionNumber } from "@/lib/sections";
import { Label as LabelReact } from "@/generated/react/Label.tsx";

const usage = `import { Label } from "@/components/ui/Label";

export default function App() {
  return <Label htmlFor="email" required>Email address</Label>;
}
`;
---

<ComponentPanel
  id="label"
  num={sectionNumber("label")}
  label="Label"
  desc="Form label matching frappe-ui v1 FormLabel: 13px regular text, an optional required asterisk with a hidden screen-reader note, and a disabled state."
  status="stable"
  code={usage}
>
  <CanvasToolbar title="Preview" meta="default · required · disabled" />
  <Canvas>
    <LabelReact client:load htmlFor="demo-email">Email address</LabelReact>
    <LabelReact client:load htmlFor="demo-name" required>Full name</LabelReact>
    <LabelReact client:load disabled>Disabled label</LabelReact>
  </Canvas>

  <Variants>
    <VariantRow label="With input" sub="htmlFor association">
      <Canvas grid={false} class="label-field-canvas">
        <div class="field">
          <LabelReact client:load htmlFor="react-name" required>Full name</LabelReact>
          <input id="react-name" type="text" placeholder="Jane Doe" class="demo-input" />
        </div>
      </Canvas>
    </VariantRow>

    <VariantRow label="Label prop" sub="text passed as data">
      <LabelReact client:load label="Workspace name" required />
      <LabelReact client:load label="Slug" />
    </VariantRow>
  </Variants>
</ComponentPanel>

<style>
  :global(.label-field-canvas) {
    flex-direction: column !important;
    align-items: flex-start !important;
    gap: 0 !important;
    padding: 28px 32px !important;
    width: 100%;
  }
  .field {
    display: flex;
    flex-direction: column;
    gap: 6px;
    max-width: 280px;
  }
  .demo-input {
    height: 32px;
    padding: 0 10px;
    border: 1px solid var(--outline-gray-2);
    border-radius: var(--radius-4);
    background: var(--surface-base);
    font-family: var(--font-sans);
    font-size: 14px;
    color: var(--ink-gray-9);
  }
  .demo-input::placeholder {
    color: var(--ink-gray-4);
  }
  .demo-input:focus-visible {
    outline: var(--focus-outline-default);
  }

  @media (max-width: 768px) {
    :global(.label-field-canvas) {
      margin: 0 !important;
      padding: 0 !important;
      min-height: 0 !important;
      border: none !important;
      background: transparent !important;
    }
  }
</style>
