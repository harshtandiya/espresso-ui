---
import ComponentPanel from "@/components/panels/ComponentPanel.astro";
import CanvasToolbar from "@/components/panels/CanvasToolbar.astro";
import Canvas from "@/components/panels/Canvas.astro";
import { sectionNumber } from "@/lib/sections";
import { LoadingTextDemo } from "@/components/examples/LoadingTextDemo.tsx";

const usage = `import { LoadingText } from "@/components/ui/LoadingText";

export default function App() {
  return <LoadingText text="Fetching results…" />;
}
`;

const usageVue = `\u003Cscript setup>
import LoadingText from "@/components/ui/LoadingText.vue";
\u003C/script>

<template>
  <LoadingText text="Fetching results…" />
</template>
`;
---

<ComponentPanel
  id="loading-text"
  num={sectionNumber("loading-text")}
  label="Loading Text"
  desc="A small spinner and a line of text, for the places where a whole loading state would be too much."
  status="new"
  code={usage}
  codeFile="loading-text.tsx"
  codeVue={usageVue}
  codeVueFile="loading-text.vue"
>
  <CanvasToolbar title="Preview" meta="spinner · text" />
  <Canvas class="shortcut-stack">
    <LoadingTextDemo client:load />
  </Canvas>
</ComponentPanel>

<style>
  :global(.shortcut-stack) {
    padding: 28px 32px !important;
  }
  :global(.shortcut-stack .canvas-content) {
    flex-direction: column !important;
    align-items: flex-start !important;
    gap: 14px !important;
    width: min(100%, 320px);
  }
  :global(.shortcut-stack astro-island) {
    display: block;
    width: 100%;
  }
  :global(.shortcut-demo-stack) {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 12px;
    width: 100%;
  }
</style>
