---
import ComponentPanel from "@/components/panels/ComponentPanel.astro";
import CanvasToolbar from "@/components/panels/CanvasToolbar.astro";
import Canvas from "@/components/panels/Canvas.astro";
import Variants from "@/components/panels/Variants.astro";
import VariantRow from "@/components/panels/VariantRow.astro";
import { sectionNumber } from "@/lib/sections";
import { Badge as BadgeReact } from "@/generated/react/Badge.tsx";
import { BadgeWithIcons } from "@/components/examples/BadgeWithIcons.tsx";

const usageReact = `import { Badge } from "@/components/ui/Badge";
import { Sparkles } from "lucide-react";

export default function App() {
  return (
    <Badge
      theme="green"
      variant="subtle"
      prefix={<Sparkles aria-hidden="true" />}
    >
      Active
    </Badge>
  );
}
`;

const usageVue = `<script setup>
import Badge from "@/components/ui/Badge.vue";
import { Sparkles } from "@lucide/vue";
</script>

<template>
  <Badge theme="green" variant="subtle">
    <template #prefix><Sparkles aria-hidden="true" /></template>
    Active
  </Badge>
</template>
`;
---

<ComponentPanel
  id="badge"
  num={sectionNumber("badge")}
  label="Badge"
  desc="Compact status label matching frappe-ui v1: six themes, four variants, three sizes, and prefix/suffix adornments."
  status="new"
  code={usageReact}
  codeFile="badge.tsx"
  codeVue={usageVue}
  codeVueFile="badge.vue"
>
  <CanvasToolbar title="Preview" meta="solid · subtle · outline · ghost" />
  <Canvas>
    <BadgeReact client:load theme="gray" variant="solid">Label</BadgeReact>
    <BadgeReact client:load theme="green" variant="subtle">Active</BadgeReact>
    <BadgeReact client:load theme="red" variant="outline">Failed</BadgeReact>
    <BadgeReact client:load theme="blue" variant="ghost">Draft</BadgeReact>
  </Canvas>

  <Variants>
    <VariantRow label="Themes" sub="gray · blue · green · amber · red · violet">
      <BadgeReact client:load theme="gray" variant="solid">Gray</BadgeReact>
      <BadgeReact client:load theme="blue" variant="solid">Blue</BadgeReact>
      <BadgeReact client:load theme="green" variant="solid">Green</BadgeReact>
      <BadgeReact client:load theme="amber" variant="solid">Amber</BadgeReact>
      <BadgeReact client:load theme="red" variant="solid">Red</BadgeReact>
      <BadgeReact client:load theme="violet" variant="solid">Violet</BadgeReact>
    </VariantRow>

    <VariantRow label="Variants" sub="solid · subtle · outline · ghost">
      <BadgeReact client:load theme="gray" variant="solid">Solid</BadgeReact>
      <BadgeReact client:load theme="gray" variant="subtle">Subtle</BadgeReact>
      <BadgeReact client:load theme="gray" variant="outline">Outline</BadgeReact>
      <BadgeReact client:load theme="gray" variant="ghost">Ghost</BadgeReact>
    </VariantRow>

    <VariantRow label="Sizes" sub="16 / 20 / 24 px">
      <BadgeReact client:load size="sm" theme="gray" variant="solid">Small</BadgeReact>
      <BadgeReact client:load size="md" theme="gray" variant="solid">Medium</BadgeReact>
      <BadgeReact client:load size="lg" theme="gray" variant="solid">Large</BadgeReact>
    </VariantRow>

    <VariantRow label="Prefix & suffix" sub="icons sized via badge tokens">
      <BadgeWithIcons client:load />
    </VariantRow>
  </Variants>
</ComponentPanel>
