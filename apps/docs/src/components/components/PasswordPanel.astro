---
import ComponentPanel from "@/components/panels/ComponentPanel.astro";
import CanvasToolbar from "@/components/panels/CanvasToolbar.astro";
import Canvas from "@/components/panels/Canvas.astro";
import { sectionNumber } from "@/lib/sections";
import { PasswordDemo } from "@/components/examples/PasswordDemo.tsx";

const usage = `import { Password } from "@/components/ui/Password";

export default function App() {
  return <Password label="Password" placeholder="Enter your password" />;
}
`;

const usageVue = `\u003Cscript setup>
import Password from "@/components/ui/Password.vue";
\u003C/script>

<template>
  <Password label="Password" placeholder="Enter your password" />
</template>
`;
---

<ComponentPanel
  id="password"
  num={sectionNumber("password")}
  label="Password"
  desc="A text field for a secret, with a button that reveals the value. The button carries a tooltip with the shortcut that does the same thing, and the shortcut works while the field has focus."
  status="new"
  code={usage}
  codeFile="password.tsx"
  codeVue={usageVue}
  codeVueFile="password.vue"
>
  <CanvasToolbar title="Preview" meta="reveal · shortcut" />
  <Canvas class="password-stack">
    <PasswordDemo client:load />
  </Canvas>
</ComponentPanel>

<style>
  :global(.password-stack) {
    padding: 28px 32px !important;
  }
  :global(.password-stack .canvas-content) {
    flex-direction: column !important;
    align-items: stretch !important;
    gap: 18px !important;
    width: min(100%, 320px);
  }
  :global(.password-stack astro-island) {
    display: block;
    width: 100%;
  }
  :global(.password-demo-stack) {
    display: flex;
    flex-direction: column;
    gap: 16px;
    width: 100%;
  }

  @media (max-width: 768px) {
    :global(.password-stack) {
      margin: 0 !important;
      padding: 0 !important;
      min-height: 0 !important;
      border: none !important;
      background: transparent !important;
    }
  }
</style>
