---
import ComponentPanel from "@/components/panels/ComponentPanel.astro";
import CanvasToolbar from "@/components/panels/CanvasToolbar.astro";
import Canvas from "@/components/panels/Canvas.astro";
import Variants from "@/components/panels/Variants.astro";
import VariantRow from "@/components/panels/VariantRow.astro";
import { sectionNumber } from "@/lib/sections";
import { Avatar as AvatarReact } from "@/generated/react/Avatar.tsx";
import { AvatarStatusRow } from "@/components/examples/AvatarStatusRow.tsx";

const usageReact = `import { Avatar } from "@/components/ui/Avatar";
import { Circle } from "lucide-react";

export default function App() {
  return (
    <Avatar
      label="Jane Cooper"
      size="md"
      theme="blue"
      shape="circle"
      indicator={
        <Circle className="size-full fill-green-500 text-green-500" />
      }
    />
  );
}
`;

const usageVue = `\u003Cscript setup>
import Avatar from "@/components/ui/Avatar.vue";
import { Circle } from "@lucide/vue";
\u003C/script>

<template>
  <Avatar label="Jane Cooper" size="md" theme="blue" shape="circle">
    <template #indicator>
      <Circle class="size-full fill-green-500 text-green-500" />
    </template>
  </Avatar>
</template>
`;
---

<ComponentPanel
  id="avatar"
  num={sectionNumber("avatar")}
  label="Avatar"
  desc="User or workspace avatar matching frappe-ui v1: image with initial fallback, six themes, seven sizes, circle or square shape, and an indicator slot."
  status="new"
  code={usageReact}
  codeFile="avatar.tsx"
  codeVue={usageVue}
  codeVueFile="avatar.vue"
>
  <CanvasToolbar title="Preview" meta="initials · image · indicator" />
  <Canvas>
    <AvatarReact client:load label="Jane Cooper" size="md" theme="blue" />
    <AvatarReact client:load label="Growth" size="md" theme="green" shape="square" />
    <AvatarReact
      client:load
      image="https://i.pravatar.cc/96?img=12"
      label="Demo user"
      size="md"
    />
  </Canvas>

  <Variants>
    <VariantRow label="Themes" sub="gray · blue · green · amber · red · violet">
      <AvatarReact client:load label="Gray" theme="gray" size="lg" />
      <AvatarReact client:load label="Blue" theme="blue" size="lg" />
      <AvatarReact client:load label="Green" theme="green" size="lg" />
      <AvatarReact client:load label="Amber" theme="amber" size="lg" />
      <AvatarReact client:load label="Red" theme="red" size="lg" />
      <AvatarReact client:load label="Violet" theme="violet" size="lg" />
    </VariantRow>

    <VariantRow label="Shapes" sub="circle vs square">
      <AvatarReact client:load label="Circle" size="lg" shape="circle" />
      <AvatarReact client:load label="Square" size="lg" shape="square" />
    </VariantRow>

    <VariantRow label="Sizes" sub="xs → 3xl">
      <Canvas grid={false} class="avatar-size-row">
        <AvatarReact client:load size="xs" label="A" />
        <AvatarReact client:load size="sm" label="B" />
        <AvatarReact client:load size="md" label="C" />
        <AvatarReact client:load size="lg" label="D" />
        <AvatarReact client:load size="xl" label="E" />
        <AvatarReact client:load size="2xl" label="F" />
        <AvatarReact client:load size="3xl" label="G" />
      </Canvas>
    </VariantRow>

    <VariantRow label="Content" sub="image · initial · icon">
      <AvatarReact
        client:load
        image="https://i.pravatar.cc/96?img=32"
        label="Photo avatar"
        size="xl"
      />
      <AvatarReact client:load label="Jane Cooper" size="xl" theme="violet" />
      <AvatarReact client:load size="xl" />
    </VariantRow>

    <VariantRow label="Indicator" sub="slot content fills the positioned shell">
      <Canvas grid={false} class="avatar-status-row">
        <AvatarStatusRow client:load />
      </Canvas>
    </VariantRow>
  </Variants>
</ComponentPanel>

<style>
  :global(.avatar-size-row),
  :global(.avatar-status-row) {
    display: flex !important;
    flex-wrap: wrap;
    align-items: center;
    justify-content: flex-start !important;
    gap: 12px !important;
    padding: 28px 32px !important;
    width: 100%;
  }

  @media (max-width: 768px) {
    :global(.avatar-size-row),
    :global(.avatar-status-row) {
      margin: 0 !important;
      padding: 0 !important;
      min-height: 0 !important;
      border: none !important;
      background: transparent !important;
    }
  }
</style>
