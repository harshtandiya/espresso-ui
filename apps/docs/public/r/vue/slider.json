{
  "name": "slider",
  "type": "registry:ui",
  "title": "Slider",
  "description": "espresso-ui Slider component (Vue)",
  "dependencies": [
    "@ark-ui/vue",
    "clsx",
    "tailwind-merge"
  ],
  "registryDependencies": [
    "label",
    "error-message"
  ],
  "files": [
    {
      "path": "components/ui/Slider.vue",
      "content": "<script setup lang=\"ts\">\nimport { computed, ref, useId } from \"vue\";\nimport {\n  SliderControl,\n  SliderHiddenInput,\n  SliderRange,\n  SliderRoot,\n  SliderThumb,\n  SliderTrack,\n} from \"@ark-ui/vue/slider\";\nimport { cn } from \"@/lib/utils\";\nimport ErrorMessage from \"./ErrorMessage.vue\";\nimport Label from \"./Label.vue\";\n\ntype SliderSize = \"sm\" | \"md\";\ntype SliderValue = number[];\ntype SliderError = string | string[] | (Error & { messages?: string | string[] }) | null;\n\nconst props = withDefaults(\n  defineProps<{\n    modelValue?: SliderValue;\n    defaultValue?: SliderValue;\n    min?: number;\n    max?: number;\n    step?: number;\n    size?: SliderSize;\n    disabled?: boolean;\n    label?: string;\n    description?: string;\n    error?: SliderError;\n    required?: boolean;\n    class?: string;\n  }>(),\n  {\n    min: 0,\n    max: 100,\n    step: 1,\n    size: \"sm\",\n    disabled: false,\n    label: \"\",\n    description: \"\",\n    error: null,\n    required: false,\n  },\n);\n\nconst emit = defineEmits<{\n  \"update:modelValue\": [value: SliderValue];\n  \"value-commit\": [value: SliderValue];\n}>();\n\nconst baseId = useId().replace(/:/g, \"\");\nconst labelId = `${baseId}-label`;\nconst descriptionId = `${baseId}-description`;\nconst errorId = `${baseId}-error`;\nconst rootRef = ref<HTMLElement | null>(null);\n\nconst hasError = computed(() => {\n  const error = props.error;\n  if (!error) return false;\n  if (Array.isArray(error)) return error.filter(Boolean).length > 0;\n  if (error instanceof Error) return Boolean(error.message);\n  return Boolean(error);\n});\nconst hasLabeling = computed(() =>\n  Boolean(props.label || props.description || hasError.value),\n);\n\nconst values = computed(() => props.modelValue ?? props.defaultValue ?? [props.min]);\nconst thumbCount = computed(() => Math.max(1, values.value.length));\nconst isRange = computed(() => thumbCount.value > 1);\nconst parts = computed(() =>\n  isRange.value\n    ? thumbCount.value === 2\n      ? [\"minimum\", \"maximum\"]\n      : Array.from(\n          { length: thumbCount.value },\n          (_, index) => `value ${index + 1} of ${thumbCount.value}`,\n        )\n    : [],\n);\n\nconst thumbNameIds = computed(() =>\n  Array.from({ length: thumbCount.value }, (_, index) => `${baseId}-name-${index}`),\n);\n\nconst thumbNames = computed(() =>\n  parts.value.map((part) => {\n    const text = props.label ? `${props.label} ${part}` : part;\n    return text.charAt(0).toUpperCase() + text.slice(1);\n  }),\n);\n\nconst defaultAriaLabel = computed(() =>\n  isRange.value\n    ? thumbNames.value\n    : props.label\n      ? [props.label]\n      : [\"Value\"],\n);\n\nconst resolvedAriaLabelledBy = computed(() =>\n  isRange.value ? thumbNameIds.value : props.label ? [labelId] : undefined,\n);\n\nconst describedBy = computed(\n  () =>\n    [\n      props.description && !hasError.value ? descriptionId : null,\n      hasError.value ? errorId : null,\n    ]\n      .filter(Boolean)\n      .join(\" \") || undefined,\n);\n\nconst sizeClasses = {\n  sm: {\n    control: \"h-4\",\n    track: \"h-1\",\n    thumb: \"size-4\",\n  },\n  md: {\n    control: \"h-5\",\n    track: \"h-1.5\",\n    thumb: \"size-5\",\n  },\n};\n\nconst thumbClasses = computed(() =>\n  cn(\n    \"block rounded-full bg-surface-base shadow-md ring-1 ring-outline-gray-3 transition-shadow duration-150 ease-out hover:ring-4 hover:ring-outline-gray-3/50 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ink-gray-8 focus-visible:ring-offset-2 focus-visible:ring-offset-surface-base\",\n    sizeClasses[props.size].thumb,\n    props.disabled ? \"cursor-not-allowed\" : \"cursor-grab active:cursor-grabbing\",\n  ),\n);\n\nconst thumbIds = computed(() => ({\n  thumb: (index: number) => `${baseId}-thumb-${index}`,\n}));\n\nfunction focusFirstThumb(): void {\n  rootRef.value?.querySelector<HTMLElement>('[role=\"slider\"]')?.focus();\n}\n\nfunction onUpdateModelValue(next: number[]): void {\n  emit(\"update:modelValue\", next);\n}\n\nfunction onValueChangeEnd(details: { value: number[] }): void {\n  emit(\"value-commit\", details.value);\n}\n</script>\n\n<template>\n  <div :class=\"cn(hasLabeling && 'flex flex-col gap-1.5', hasLabeling && props.class)\">\n    <Label v-if=\"props.label\" :id=\"labelId\" :required=\"props.required\" @click=\"focusFirstThumb\">\n      {{ props.label }}\n    </Label>\n\n    <div ref=\"rootRef\" :class=\"cn(!hasLabeling && props.class)\">\n      <span\n        v-for=\"(name, index) in thumbNames\"\n        v-show=\"isRange\"\n        :key=\"thumbNameIds[index]\"\n        :id=\"thumbNameIds[index]\"\n        class=\"sr-only\"\n      >\n        {{ name }}\n      </span>\n      <SliderRoot\n        :model-value=\"props.modelValue\"\n        :default-value=\"props.modelValue === undefined ? (props.defaultValue ?? [props.min]) : undefined\"\n        :min=\"props.min\"\n        :max=\"props.max\"\n        :step=\"props.step\"\n        :disabled=\"props.disabled\"\n        :invalid=\"hasError\"\n        :origin=\"props.min < 0 && props.max > 0 ? 'center' : 'start'\"\n        :aria-label=\"resolvedAriaLabelledBy ? undefined : defaultAriaLabel\"\n        :aria-labelledby=\"resolvedAriaLabelledBy\"\n        :ids=\"thumbIds\"\n        data-slot=\"slider\"\n        :data-size=\"props.size\"\n        :data-state=\"hasError ? 'invalid' : 'valid'\"\n        class=\"w-full\"\n        @update:model-value=\"onUpdateModelValue\"\n        @value-change-end=\"onValueChangeEnd\"\n      >\n        <SliderControl\n          data-slot=\"control\"\n          :class=\"cn('relative flex w-full touch-none select-none items-center', sizeClasses[props.size].control)\"\n        >\n          <SliderTrack\n            data-slot=\"track\"\n            :class=\"\n              cn(\n                'relative w-full grow rounded-4',\n                sizeClasses[props.size].track,\n                props.disabled ? 'bg-surface-gray-2' : 'bg-surface-gray-3',\n              )\n            \"\n          >\n            <SliderRange\n              data-slot=\"range\"\n              :class=\"\n                cn(\n                  'absolute h-full rounded-4',\n                  props.disabled ? 'bg-surface-gray-4' : 'bg-surface-gray-10',\n                )\n              \"\n            />\n          </SliderTrack>\n          <SliderThumb\n            v-for=\"index in thumbCount\"\n            :key=\"index\"\n            :index=\"index - 1\"\n            data-slot=\"thumb\"\n            :aria-describedby=\"describedBy\"\n            :aria-invalid=\"hasError || undefined\"\n            :aria-errormessage=\"hasError ? errorId : undefined\"\n            :class=\"thumbClasses\"\n          >\n            <SliderHiddenInput />\n          </SliderThumb>\n        </SliderControl>\n      </SliderRoot>\n    </div>\n\n    <p\n      v-if=\"props.description && !hasError\"\n      :id=\"descriptionId\"\n      class=\"[font-size:var(--input-description-font-size)] leading-tighter text-ink-gray-5\"\n    >\n      {{ props.description }}\n    </p>\n    <ErrorMessage v-if=\"hasError\" :id=\"errorId\" :message=\"props.error\" />\n  </div>\n</template>\n",
      "type": "registry:ui"
    },
    {
      "path": "components/ui/slider.css",
      "content": "/* The handle is positioned by Ark UI; only the drag affordance is ours. */\n[data-slot=\"thumb\"] {\n  touch-action: none;\n  user-select: none;\n  -webkit-tap-highlight-color: transparent;\n}\n\n@media (prefers-reduced-motion: reduce) {\n  [data-slot=\"thumb\"] {\n    transition: none;\n  }\n}\n",
      "type": "registry:style"
    }
  ]
}