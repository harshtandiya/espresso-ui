{
  "name": "tooltip",
  "type": "registry:ui",
  "title": "Tooltip",
  "description": "espresso-ui Tooltip component (Vue)",
  "dependencies": [
    "@ark-ui/vue"
  ],
  "registryDependencies": [],
  "files": [
    {
      "path": "components/ui/Tooltip.vue",
      "content": "<script setup lang=\"ts\">\nimport { Tooltip as ArkTooltip } from \"@ark-ui/vue/tooltip\";\n\ntype TooltipSide = \"top\" | \"right\" | \"bottom\" | \"left\";\n\nconst props = withDefaults(\n  defineProps<{\n    text?: string;\n    hoverDelay?: number;\n    side?: TooltipSide;\n    offset?: number;\n    bare?: boolean;\n    disabled?: boolean;\n  }>(),\n  {\n    text: \"\",\n    hoverDelay: 500,\n    side: \"top\",\n    offset: 4,\n    bare: false,\n    disabled: false,\n  },\n);\n\nconst slots = defineSlots<{\n  default?: () => unknown;\n  content?: () => unknown;\n}>();\n</script>\n\n<template>\n  <slot v-if=\"props.disabled\" />\n  <ArkTooltip.Root\n    v-else\n    :open-delay=\"props.hoverDelay\"\n    :close-delay=\"75\"\n    :positioning=\"{ placement: props.side, gutter: props.offset }\"\n  >\n    <ArkTooltip.Trigger as-child data-slot=\"trigger\">\n      <slot />\n    </ArkTooltip.Trigger>\n    <Teleport v-if=\"props.text || slots.content\" to=\"body\">\n      <ArkTooltip.Positioner class=\"z-[100]\">\n        <ArkTooltip.Content data-slot=\"tooltip-content\" class=\"z-[100]\">\n          <slot v-if=\"props.bare\" name=\"content\" />\n          <div\n            v-else\n            data-slot=\"bubble\"\n            class=\"rounded-(--radius-4) bg-surface-gray-10 px-2 py-1 text-xs text-ink-base shadow-xl\"\n          >\n            <slot name=\"content\">{{ props.text }}</slot>\n          </div>\n          <ArkTooltip.Arrow data-slot=\"tooltip-arrow\">\n            <ArkTooltip.ArrowTip data-slot=\"tooltip-arrow-tip\" />\n          </ArkTooltip.Arrow>\n        </ArkTooltip.Content>\n      </ArkTooltip.Positioner>\n    </Teleport>\n  </ArkTooltip.Root>\n</template>\n",
      "type": "registry:ui"
    },
    {
      "path": "components/ui/tooltip.css",
      "content": "/* Tooltip enters from its trigger with a short, origin-aware scale. */\n[data-slot=\"tooltip-content\"] {\n  transform-origin: var(--transform-origin);\n  transition:\n    opacity 125ms ease-out,\n    transform 125ms ease-out;\n}\n\n[data-slot=\"tooltip-content\"][data-state=\"closed\"] {\n  opacity: 0;\n  transform: scale(0.97);\n}\n\n[data-slot=\"tooltip-arrow\"] {\n  --arrow-size: 8px;\n  --arrow-background: var(--surface-gray-10);\n}\n\n[data-slot=\"tooltip-arrow-tip\"] {\n  width: var(--arrow-size);\n  height: var(--arrow-size);\n  border-radius: 2px;\n  background: var(--arrow-background);\n  transform: rotate(45deg);\n}\n\n@media (prefers-reduced-motion: reduce) {\n  [data-slot=\"tooltip-content\"] {\n    transition: opacity 125ms ease;\n  }\n\n  [data-slot=\"tooltip-content\"][data-state=\"closed\"] {\n    transform: none;\n  }\n}\n",
      "type": "registry:style"
    }
  ]
}