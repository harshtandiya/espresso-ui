{
  "name": "dialog",
  "type": "registry:ui",
  "title": "Dialog",
  "description": "espresso-ui Dialog component (Vue)",
  "dependencies": [
    "@ark-ui/vue",
    "clsx",
    "tailwind-merge",
    "@lucide/vue"
  ],
  "registryDependencies": [
    "button"
  ],
  "files": [
    {
      "path": "components/ui/Dialog.vue",
      "content": "<script setup lang=\"ts\">\nimport { computed, ref, useId, type Component } from \"vue\";\nimport { Portal } from \"@ark-ui/vue/portal\";\nimport {\n  DialogBackdrop,\n  DialogCloseTrigger,\n  DialogContent,\n  DialogDescription,\n  DialogPositioner,\n  DialogRoot,\n  DialogTitle,\n  DialogTrigger,\n} from \"@ark-ui/vue/dialog\";\nimport { X } from \"@lucide/vue\";\nimport { cn } from \"@/lib/utils\";\nimport Button from \"./Button.vue\";\n\ntype DialogSize =\n  | \"xs\"\n  | \"sm\"\n  | \"md\"\n  | \"lg\"\n  | \"xl\"\n  | \"2xl\"\n  | \"3xl\"\n  | \"4xl\"\n  | \"5xl\"\n  | \"6xl\"\n  | \"7xl\";\ntype DialogTheme = \"gray\" | \"blue\" | \"green\" | \"amber\" | \"red\";\ntype DialogPosition = \"center\" | \"top\";\ntype DialogAction = {\n  label: string;\n  theme?: \"gray\" | \"blue\" | \"green\" | \"red\";\n  variant?: \"solid\" | \"subtle\" | \"outline\" | \"ghost\" | \"link\";\n  size?: \"xs\" | \"sm\" | \"md\" | \"lg\";\n  disabled?: boolean;\n  onClick?: () => void | Promise<void>;\n};\n\nconst props = withDefaults(\n  defineProps<{\n    open?: boolean;\n    modelValue?: boolean;\n    title?: string;\n    message?: string;\n    icon?: string | Component;\n    theme?: DialogTheme;\n    size?: DialogSize;\n    position?: DialogPosition;\n    dismissible?: boolean;\n    showCloseButton?: boolean;\n    bare?: boolean;\n    actions?: DialogAction[];\n    class?: string;\n  }>(),\n  {\n    theme: \"gray\",\n    size: \"lg\",\n    position: \"center\",\n    dismissible: true,\n    showCloseButton: true,\n    bare: false,\n    actions: () => [],\n  },\n);\n\nconst emit = defineEmits<{\n  \"update:open\": [value: boolean];\n  \"update:modelValue\": [value: boolean];\n  close: [];\n}>();\n\nconst slots = defineSlots<{\n  default?: (props: { close: () => void }) => unknown;\n  title?: (props: { close: () => void }) => unknown;\n  actions?: (props: { close: () => void; actions: DialogAction[] }) => unknown;\n}>();\n\nconst internalOpen = ref(false);\nconst loadingIndex = ref<number | null>(null);\nconst baseId = useId().replace(/:/g, \"\");\n\nconst isOpen = computed(() => {\n  if (props.open !== undefined) return props.open;\n  if (props.modelValue !== undefined) return props.modelValue;\n  return internalOpen.value;\n});\n\nconst sizeClasses: Record<DialogSize, string> = {\n  xs: \"max-w-xs\",\n  sm: \"max-w-sm\",\n  md: \"max-w-md\",\n  lg: \"max-w-lg\",\n  xl: \"max-w-xl\",\n  \"2xl\": \"max-w-2xl\",\n  \"3xl\": \"max-w-3xl\",\n  \"4xl\": \"max-w-4xl\",\n  \"5xl\": \"max-w-5xl\",\n  \"6xl\": \"max-w-6xl\",\n  \"7xl\": \"max-w-7xl\",\n};\n\nconst iconBadgeClasses: Record<DialogTheme, string> = {\n  gray: \"bg-surface-gray-2 text-ink-gray-7\",\n  blue: \"bg-surface-blue-2 text-ink-blue-7\",\n  green: \"bg-surface-green-2 text-ink-green-7\",\n  amber: \"bg-surface-amber-2 text-ink-amber-7\",\n  red: \"bg-surface-red-2 text-ink-red-7\",\n};\n\nfunction setOpen(value: boolean) {\n  if (props.open === undefined && props.modelValue === undefined) internalOpen.value = value;\n  emit(\"update:open\", value);\n  emit(\"update:modelValue\", value);\n  if (!value) emit(\"close\");\n}\n\nfunction close() {\n  setOpen(false);\n}\n\nasync function runAction(action: DialogAction, index: number) {\n  if (!action.onClick) return;\n  const result = action.onClick();\n  if (!result || typeof (result as Promise<void>).then !== \"function\") return;\n  loadingIndex.value = index;\n  try {\n    await result;\n  } finally {\n    loadingIndex.value = null;\n  }\n}\n</script>\n\n<template>\n  <DialogRoot\n    :open=\"isOpen\"\n    :lazy-mount=\"true\"\n    :unmount-on-exit=\"true\"\n    :close-on-escape=\"props.dismissible\"\n    :close-on-interact-outside=\"props.dismissible\"\n    @open-change=\"(details: { open: boolean }) => setOpen(details.open)\"\n  >\n    <slot name=\"trigger\">\n      <DialogTrigger as-child>\n        <Button label=\"Open dialog\" />\n      </DialogTrigger>\n    </slot>\n\n    <Portal>\n      <DialogBackdrop\n        data-slot=\"dialog-overlay\"\n        class=\"fixed inset-0 z-50 [--z-index:50]! bg-black-overlay-200 outline-none\"\n      />\n      <DialogPositioner\n        data-slot=\"dialog-positioner\"\n        :class=\"\n          cn(\n            'fixed inset-0 z-50 [--z-index:50]! flex justify-center overflow-y-auto p-4',\n            props.position === 'top' ? 'items-start pt-16' : 'items-center',\n          )\n        \"\n      >\n        <DialogContent\n          data-slot=\"dialog-content\"\n          :class=\"\n            cn(\n              'w-full rounded-7 bg-surface-elevation-1 text-start shadow-xl outline-none',\n              sizeClasses[props.size],\n              props.class,\n            )\n          \"\n        >\n          <slot v-if=\"props.bare\" :close=\"close\" />\n          <template v-else>\n            <div class=\"px-4 pb-6 pt-5 sm:px-6\">\n              <div class=\"flex items-center justify-between gap-2\">\n                <div class=\"flex flex-1 items-center gap-2\">\n                  <span\n                    v-if=\"props.icon\"\n                    data-slot=\"dialog-icon\"\n                    :class=\"\n                      cn(\n                        'flex size-7 shrink-0 items-center justify-center rounded-full',\n                        iconBadgeClasses[props.theme],\n                      )\n                    \"\n                  >\n                    <span v-if=\"typeof props.icon === 'string'\" :class=\"[props.icon, 'size-4']\" />\n                    <component v-else :is=\"props.icon\" class=\"size-4\" />\n                  </span>\n                  <DialogTitle as-child>\n                    <h3 :id=\"`${baseId}-title`\" class=\"flex-1 text-lg font-semibold leading-6 text-ink-gray-8\">\n                      <slot name=\"title\" :close=\"close\">{{ props.title }}</slot>\n                    </h3>\n                  </DialogTitle>\n                </div>\n                <DialogCloseTrigger v-if=\"props.showCloseButton\" as-child>\n                  <Button variant=\"ghost\" theme=\"gray\" aria-label=\"Close\">\n                    <template #icon>\n                      <X aria-hidden=\"true\" class=\"size-4 text-ink-gray-9\" />\n                    </template>\n                  </Button>\n                </DialogCloseTrigger>\n              </div>\n\n              <DialogDescription v-if=\"props.message\" as-child>\n                <p :id=\"`${baseId}-description`\" class=\"mt-2 text-sm text-ink-gray-7\">\n                  {{ props.message }}\n                </p>\n              </DialogDescription>\n\n              <slot :close=\"close\" />\n            </div>\n\n            <div\n              v-if=\"props.actions.length || slots.actions\"\n              data-slot=\"dialog-actions\"\n              class=\"flex justify-end gap-2 px-4 pb-7 pt-4 sm:px-6\"\n            >\n              <slot name=\"actions\" :close=\"close\" :actions=\"props.actions\">\n                <Button\n                  v-for=\"(action, index) in props.actions\"\n                  :key=\"action.label\"\n                  :theme=\"action.theme ?? 'gray'\"\n                  :variant=\"action.variant ?? 'subtle'\"\n                  :size=\"action.size ?? 'sm'\"\n                  :label=\"action.label\"\n                  :disabled=\"action.disabled\"\n                  :loading=\"loadingIndex === index\"\n                  @click=\"runAction(action, index)\"\n                />\n              </slot>\n            </div>\n          </template>\n        </DialogContent>\n      </DialogPositioner>\n    </Portal>\n  </DialogRoot>\n</template>\n",
      "type": "registry:ui"
    },
    {
      "path": "components/ui/dialog.css",
      "content": "/* The dialog enters on a short scale-and-lift, and the scrim fades. */\n@keyframes espresso-dialog-overlay-in {\n  from {\n    opacity: 0;\n  }\n  to {\n    opacity: 1;\n  }\n}\n\n@keyframes espresso-dialog-content-in {\n  from {\n    opacity: 0;\n    transform: translateY(8px) scale(0.98);\n  }\n  to {\n    opacity: 1;\n    transform: none;\n  }\n}\n\n/* The scrim is heavier in the dark theme, so the card still reads as the\n   surface in front. */\n[data-theme=\"dark\"] [data-slot=\"dialog-overlay\"] {\n  background-color: var(--color-black-overlay-700);\n}\n\n[data-slot=\"dialog-overlay\"][data-state=\"open\"] {\n  animation: espresso-dialog-overlay-in 150ms ease-out;\n}\n\n[data-slot=\"dialog-overlay\"][data-state=\"closed\"] {\n  animation: espresso-dialog-overlay-in 150ms ease-out reverse;\n}\n\n[data-slot=\"dialog-content\"][data-state=\"open\"] {\n  animation: espresso-dialog-content-in 180ms cubic-bezier(0.23, 1, 0.32, 1);\n}\n\n[data-slot=\"dialog-content\"][data-state=\"closed\"] {\n  animation: espresso-dialog-content-in 180ms cubic-bezier(0.23, 1, 0.32, 1) reverse;\n}\n\n@media (prefers-reduced-motion: reduce) {\n  [data-slot=\"dialog-overlay\"],\n  [data-slot=\"dialog-content\"] {\n    animation: none;\n  }\n}\n",
      "type": "registry:style"
    }
  ]
}