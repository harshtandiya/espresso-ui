      "path": "components/ui/Rating.vue",
      "content": "<script setup lang=\"ts\">\nimport { computed, nextTick, ref, useId, type Component } from \"vue\";\nimport { cn } from \"@/lib/utils\";\nimport ErrorMessage from \"./ErrorMessage.vue\";\nimport Label from \"./Label.vue\";\n\ntype RatingSize = \"xs\" | \"sm\" | \"md\" | \"lg\";\ntype RatingStep = 1 | 0.5;\ntype RatingStarState = \"filled\" | \"preview\" | \"removing\" | \"empty\";\ntype RatingError = string | string[] | (Error & { messages?: string | string[] }) | null;\n\ntype RatingIconSlotProps = {\n  index: number;\n  side: \"left\" | \"right\";\n  state: RatingStarState;\n  leftState: RatingStarState;\n  rightState: RatingStarState;\n  value: number;\n  previewValue: number | null;\n  max: number;\n};\n\nconst props = withDefaults(\n  defineProps<{\n    modelValue?: number;\n    defaultValue?: number;\n    max?: number;\n    step?: RatingStep;\n    disabled?: boolean;\n    size?: RatingSize;\n    label?: string;\n    description?: string;\n    error?: RatingError;\n    required?: boolean;\n    icon?: string | Component;\n    class?: string;\n  }>(),\n  {\n    defaultValue: 0,\n    max: 5,\n    step: 1,\n    disabled: false,\n    size: \"sm\",\n    label: \"\",\n    description: \"\",\n    error: null,\n    required: false,\n  },\n);\n\nconst emit = defineEmits<{\n  \"update:modelValue\": [value: number];\n}>();\n\nconst slots = defineSlots<{\n  label?: (props: { required: boolean }) => unknown;\n  description?: () => unknown;\n  icon?: (props: RatingIconSlotProps) => unknown;\n}>();\n\nconst internalValue = ref(props.defaultValue);\nconst hovered = ref<number | null>(null);\nconst focused = ref(1);\nconst groupRef = ref<HTMLElement | null>(null);\nconst baseId = useId().replace(/:/g, \"\");\nconst labelId = `${baseId}-label`;\nconst descriptionId = `${baseId}-description`;\nconst errorId = `${baseId}-error`;\nconst starCount = computed(() => Math.max(1, props.max));\nconst isSlider = computed(() => props.step === 0.5);\n\nconst current = computed(() =>\n  Math.max(0, Math.min(props.max, props.modelValue ?? internalValue.value)),\n);\nconst saved = computed(() => Math.round(current.value / props.step) * props.step);\n\nconst hasError = computed(() => {\n  const error = props.error;\n  if (!error) return false;\n  if (Array.isArray(error)) return error.filter(Boolean).length > 0;\n  if (error instanceof Error) return Boolean(error.message);\n  return Boolean(error);\n});\nconst hasLabeling = computed(() =>\n  Boolean(props.label || slots.label || props.description || slots.description || hasError.value),\n);\n\nconst sizeClasses = {\n  xs: \"size-3.5\",\n  sm: \"size-4\",\n  md: \"size-5\",\n  lg: \"size-6\",\n};\n\nconst colorClasses = {\n  filled: \"text-ink-amber-6\",\n  preview: \"text-ink-amber-3\",\n  removing: \"text-ink-amber-4\",\n  empty: \"text-outline-gray-3\",\n};\n\nfunction setValue(next: number) {\n  const clamped = Math.max(0, Math.min(props.max, Math.round(next / props.step) * props.step));\n  if (props.modelValue === undefined) internalValue.value = clamped;\n  emit(\"update:modelValue\", clamped);\n}\n\nfunction halfState(half: number): RatingStarState {\n  if (hovered.value === null) return half <= saved.value ? \"filled\" : \"empty\";\n  if (half <= Math.min(saved.value, hovered.value)) return \"filled\";\n  if (half <= hovered.value) return \"preview\";\n  if (half <= saved.value) return \"removing\";\n  return \"empty\";\n}\n\nfunction hitValue(event: MouseEvent, index: number) {\n  if (props.step !== 0.5) return index;\n  const rect = (event.currentTarget as HTMLElement).getBoundingClientRect();\n  return event.clientX - rect.left < rect.width / 2 ? index - 0.5 : index;\n}\n\nfunction commit(next: number) {\n  const candidate = Math.max(0, Math.min(props.max, Math.round(next / props.step) * props.step));\n  setValue(candidate === saved.value ? 0 : candidate);\n}\n\nfunction focusStar(index: number) {\n  focused.value = index;\n  nextTick(() => {\n    groupRef.value\n      ?.querySelector<HTMLButtonElement>(`[data-index=\"${index}\"]`)\n      ?.focus();\n  });\n}\n\nfunction formatValue(value: number) {\n  if (value === 0) return `No rating, out of ${props.max} stars`;\n  const display = value % 1 === 0 ? String(value) : value.toFixed(1);\n  return `${display} of ${props.max} stars`;\n}\n\nfunction iconSlotProps(index: number, side: \"left\" | \"right\"): RatingIconSlotProps {\n  return {\n    index,\n    side,\n    state: halfState(side === \"left\" ? index - 0.5 : index),\n    leftState: halfState(index - 0.5),\n    rightState: halfState(index),\n    value: saved.value,\n    previewValue: hovered.value,\n    max: props.max,\n  };\n}\n\nfunction handleKeydown(event: KeyboardEvent) {\n  if (props.disabled) return;\n  const key = event.key;\n\n  if (isSlider.value) {\n    let next: number | null = null;\n    if (key === \"ArrowRight\" || key === \"ArrowUp\") next = Math.min(props.max, saved.value + props.step);\n    else if (key === \"ArrowLeft\" || key === \"ArrowDown\") next = Math.max(0, saved.value - props.step);\n    else if (key === \"Home\") next = 0;\n    else if (key === \"End\") next = props.max;\n    else if (key === \"PageUp\") next = Math.min(props.max, saved.value + 1);\n    else if (key === \"PageDown\") next = Math.max(0, saved.value - 1);\n    else if (/^[0-9]$/.test(key)) next = Math.min(props.max, Number(key));\n    if (next !== null) {\n      event.preventDefault();\n      setValue(next);\n    }\n    return;\n  }\n\n  const active = focused.value || Math.max(1, Math.min(props.max, Math.ceil(saved.value) || 1));\n  let next: number | null = null;\n  if (key === \"ArrowRight\" || key === \"ArrowDown\") next = Math.min(props.max, active + 1);\n  else if (key === \"ArrowLeft\" || key === \"ArrowUp\") next = Math.max(1, active - 1);\n  else if (key === \"Home\") next = 1;\n  else if (key === \"End\") next = props.max;\n  else if (key === \" \" || key === \"Enter\") next = active;\n  else if (/^[0-9]$/.test(key)) {\n    event.preventDefault();\n    setValue(key === \"0\" ? 0 : Math.min(props.max, Number(key)));\n    return;\n  }\n  if (next !== null) {\n    event.preventDefault();\n    setValue(next);\n    focusStar(next);\n  }\n}\n</script>\n\n<template>\n  <div\n    data-slot=\"rating\"\n    :data-size=\"props.size\"\n    :class=\"cn(hasLabeling && 'space-y-1', props.class)\"\n  >\n    <Label v-if=\"props.label || slots.label\" :id=\"labelId\" :required=\"props.required\">\n      <slot name=\"label\" :required=\"props.required\">{{ props.label }}</slot>\n    </Label>\n\n    <div\n      ref=\"groupRef\"\n      :id=\"`${baseId}-control`\"\n      :role=\"isSlider ? 'slider' : 'radiogroup'\"\n      :aria-labelledby=\"props.label || slots.label ? labelId : undefined\"\n      :aria-describedby=\"\n        [props.description || slots.description ? descriptionId : undefined, hasError ? errorId : undefined]\n          .filter(Boolean)\n          .join(' ') || undefined\n      \"\n      :aria-errormessage=\"hasError ? errorId : undefined\"\n      :aria-invalid=\"hasError || undefined\"\n      :aria-required=\"!isSlider && props.required ? true : undefined\"\n      :aria-disabled=\"props.disabled || undefined\"\n      :aria-orientation=\"isSlider ? 'horizontal' : undefined\"\n      :aria-valuemin=\"isSlider ? 0 : undefined\"\n      :aria-valuemax=\"isSlider ? props.max : undefined\"\n      :aria-valuenow=\"isSlider ? saved : undefined\"\n      :aria-valuetext=\"isSlider ? formatValue(saved) : undefined\"\n      :tabindex=\"isSlider ? (props.disabled ? -1 : 0) : undefined\"\n      data-slot=\"control\"\n      :class=\"\n        cn(\n          'inline-flex shrink-0 items-center gap-0.5 rounded-(--radius-1) leading-none outline-none focus-visible:ring-2 focus-visible:ring-outline-gray-4',\n          props.disabled ? 'cursor-default' : 'cursor-pointer',\n        )\n      \"\n      @pointerleave=\"hovered = null\"\n      @keydown=\"handleKeydown\"\n    >\n      <button\n        v-for=\"index in starCount\"\n        :key=\"index\"\n        type=\"button\"\n        :role=\"isSlider ? undefined : 'radio'\"\n        :aria-checked=\"isSlider ? undefined : index === saved\"\n        :aria-posinset=\"isSlider ? undefined : index\"\n        :aria-setsize=\"isSlider ? undefined : starCount\"\n        :aria-label=\"isSlider ? undefined : `${index} of ${starCount}`\"\n        data-slot=\"star\"\n        :data-index=\"index\"\n        :data-state=\"halfState(index)\"\n        :tabindex=\"isSlider || props.disabled ? -1 : index === (Math.ceil(saved) || 1) ? 0 : -1\"\n        :disabled=\"props.disabled && !isSlider\"\n        :class=\"\n          cn(\n            'relative inline-flex shrink-0 rounded-(--radius-1) outline-none focus-visible:ring-2 focus-visible:ring-outline-gray-4',\n            sizeClasses[props.size],\n            props.disabled ? 'cursor-default' : 'cursor-pointer',\n          )\n        \"\n        @pointermove=\"!props.disabled && (hovered = hitValue($event, index))\"\n        @click=\"!props.disabled && commit(hitValue($event, index))\"\n        @focus=\"focused = index\"\n      >\n        <span\n          data-slot=\"half-left\"\n          aria-hidden=\"true\"\n          :class=\"['absolute inset-0 inline-flex items-center justify-center', colorClasses[halfState(index - 0.5)]]\"\n        >\n          <slot name=\"icon\" v-bind=\"iconSlotProps(index, 'left')\">\n            <span v-if=\"typeof props.icon === 'string'\" :class=\"[props.icon, 'size-full']\" />\n            <component v-else-if=\"props.icon\" :is=\"props.icon\" class=\"size-full\" />\n            <svg\n              v-else\n              viewBox=\"0 0 24 24\"\n              fill=\"currentColor\"\n              stroke=\"currentColor\"\n              stroke-width=\"2\"\n              stroke-linecap=\"round\"\n              stroke-linejoin=\"round\"\n              aria-hidden=\"true\"\n              class=\"size-full\"\n            >\n              <path d=\"M11.525 2.295a.53.53 0 0 1 .95 0l2.31 4.679a2.123 2.123 0 0 0 1.595 1.16l5.166.756a.53.53 0 0 1 .294.904l-3.736 3.638a2.123 2.123 0 0 0-.611 1.878l.882 5.14a.53.53 0 0 1-.771.56l-4.618-2.428a2.122 2.122 0 0 0-1.973 0L6.396 21.01a.53.53 0 0 1-.77-.56l.881-5.139a2.122 2.122 0 0 0-.611-1.879L2.16 9.795a.53.53 0 0 1 .294-.906l5.165-.755a2.122 2.122 0 0 0 1.597-1.16z\" />\n            </svg>\n          </slot>\n        </span>\n        <span\n          data-slot=\"half-right\"\n          aria-hidden=\"true\"\n          :class=\"['absolute inset-0 inline-flex items-center justify-center', colorClasses[halfState(index)]]\"\n        >\n          <slot name=\"icon\" v-bind=\"iconSlotProps(index, 'right')\">\n            <span v-if=\"typeof props.icon === 'string'\" :class=\"[props.icon, 'size-full']\" />\n            <component v-else-if=\"props.icon\" :is=\"props.icon\" class=\"size-full\" />\n            <svg\n              v-else\n              viewBox=\"0 0 24 24\"\n              fill=\"currentColor\"\n              stroke=\"currentColor\"\n              stroke-width=\"2\"\n              stroke-linecap=\"round\"\n              stroke-linejoin=\"round\"\n              aria-hidden=\"true\"\n              class=\"size-full\"\n            >\n              <path d=\"M11.525 2.295a.53.53 0 0 1 .95 0l2.31 4.679a2.123 2.123 0 0 0 1.595 1.16l5.166.756a.53.53 0 0 1 .294.904l-3.736 3.638a2.123 2.123 0 0 0-.611 1.878l.882 5.14a.53.53 0 0 1-.771.56l-4.618-2.428a2.122 2.122 0 0 0-1.973 0L6.396 21.01a.53.53 0 0 1-.77-.56l.881-5.139a2.122 2.122 0 0 0-.611-1.879L2.16 9.795a.53.53 0 0 1 .294-.906l5.165-.755a2.122 2.122 0 0 0 1.597-1.16z\" />\n            </svg>\n          </slot>\n        </span>\n      </button>\n    </div>\n\n    <p\n      v-if=\"(props.description || slots.description) && !hasError\"\n      :id=\"descriptionId\"\n      class=\"text-sm text-ink-gray-5\"\n    >\n      <slot name=\"description\">{{ props.description }}</slot>\n    </p>\n    <ErrorMessage v-if=\"hasError\" :id=\"errorId\" :message=\"props.error\" />\n  </div>\n</template>\n",
      "type": "registry:ui"
    },
    {
      "path": "components/ui/rating.css",
      "content": "/* Each star is drawn twice, clipped at the midline, so half stars work. */\n[data-slot=\"star\"] {\n  background: transparent;\n  padding: 0;\n  border: 0;\n}\n\n[data-slot=\"half-left\"] {\n  clip-path: inset(0 50% 0 0);\n}\n\n[data-slot=\"half-right\"] {\n  clip-path: inset(0 0 0 50%);\n}\n",
      "type": "registry:style"
    }
  ]
