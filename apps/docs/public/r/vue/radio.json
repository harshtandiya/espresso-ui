{
  "name": "radio",
  "type": "registry:ui",
  "title": "Radio",
  "description": "espresso-ui Radio component (Vue)",
  "dependencies": [
    "clsx",
    "tailwind-merge"
  ],
  "registryDependencies": [
    "radio-group"
  ],
  "files": [
    {
      "path": "components/ui/Radio.vue",
      "content": "<script setup lang=\"ts\">\nimport { computed, inject, ref, useAttrs, useId, useSlots } from \"vue\";\nimport type { ComputedRef, InjectionKey } from \"vue\";\nimport { cn } from \"@/lib/utils\";\n\ndefineOptions({ inheritAttrs: false });\n\ntype RadioSize = \"xs\" | \"sm\" | \"md\";\ntype RadioValue = string | number | boolean;\ntype RadioGroupContext = {\n  name: ComputedRef<string>;\n  value: ComputedRef<RadioValue | undefined>;\n  size: ComputedRef<RadioSize>;\n  padded: ComputedRef<boolean>;\n  disabled: ComputedRef<boolean>;\n  required: ComputedRef<boolean>;\n  hasError: ComputedRef<boolean>;\n  errorId: string;\n  onSelect: (value: RadioValue) => void;\n};\nconst RADIO_GROUP_KEY = Symbol.for(\"espresso-ui.radio-group\") as InjectionKey<RadioGroupContext>;\n\nconst sizeClasses: Record<\n  RadioSize,\n  { circle: string; selected: string; offset: string }\n> = {\n  xs: {\n    circle: \"size-(--radio-xs-size)\",\n    selected: \"[border-width:var(--radio-xs-checked-border)]\",\n    offset: \"[margin-top:var(--radio-xs-offset)]\",\n  },\n  sm: {\n    circle: \"size-(--radio-sm-size)\",\n    selected: \"[border-width:var(--radio-sm-checked-border)]\",\n    offset: \"[margin-top:var(--radio-sm-offset)]\",\n  },\n  md: {\n    circle: \"size-(--radio-md-size)\",\n    selected: \"[border-width:var(--radio-md-checked-border)]\",\n    offset: \"[margin-top:var(--radio-md-offset)]\",\n  },\n};\n\nconst props = withDefaults(\n  defineProps<{\n    value: RadioValue;\n    label?: string;\n    description?: string;\n    disabled?: boolean;\n    id?: string;\n    class?: string;\n  }>(),\n  {\n    label: \"\",\n    description: \"\",\n    disabled: false,\n  },\n);\n\nconst slots = useSlots();\nconst attrs = useAttrs();\nconst group = inject(RADIO_GROUP_KEY, null);\nif (!group) {\n  throw new Error(\"[espresso-ui] <Radio> must be used inside a <RadioGroup>.\");\n}\n\nconst inputRef = ref<HTMLInputElement | null>(null);\nconst fallbackId = useId();\nconst inputId = computed(() => props.id ?? fallbackId);\nconst labelId = computed(() => `${inputId.value}-label`);\nconst descriptionId = computed(() => `${inputId.value}-description`);\nconst hasLabel = computed(() => Boolean(props.label || slots.label));\nconst hasDescription = computed(() => Boolean(props.description || slots.description));\nconst isDisabled = computed(() => group.disabled.value || props.disabled);\nconst isSelected = computed(() => group.value.value === props.value);\nconst sizing = computed(() => sizeClasses[group.size.value]);\n\nconst rowClasses = computed(() =>\n  cn(\n    \"group flex items-start gap-2 rounded-(--radio-padded-radius) text-start transition-colors [&:has(:focus-visible)]:ring-2 [&:has(:focus-visible)]:ring-ink-gray-8 [&:has(:focus-visible)]:ring-offset-2 [&:has(:focus-visible)]:ring-offset-surface-base\",\n    isDisabled.value ? \"cursor-not-allowed\" : \"cursor-pointer\",\n    group.padded.value &&\n      !isDisabled.value &&\n      \"hover:bg-surface-gray-3 active:bg-surface-gray-4\",\n    group.padded.value &&\n      (hasDescription.value\n        ? group.size.value === \"md\"\n          ? \"px-3 py-2\"\n          : \"px-1.5 py-1.5\"\n        : group.size.value === \"md\"\n          ? \"h-8 items-center px-3\"\n          : group.size.value === \"sm\"\n            ? \"h-7 items-center px-1.5\"\n            : \"h-6 items-center px-1.5\"),\n    props.class,\n  ),\n);\n\nconst circleClasses = computed(() =>\n  cn(\n    \"box-border shrink-0 rounded-full transition-colors\",\n    sizing.value.circle,\n    isSelected.value ? sizing.value.selected : \"border\",\n    hasDescription.value || !group.padded.value ? sizing.value.offset : \"\",\n    isDisabled.value\n      ? isSelected.value\n        ? \"bg-surface-base border-[color:var(--surface-gray-5)]\"\n        : \"bg-surface-base border-outline-gray-3\"\n      : isSelected.value\n        ? \"bg-surface-base border-[color:var(--surface-gray-10)] group-hover:border-[color:var(--surface-gray-9)] group-active:border-[color:var(--surface-gray-8)]\"\n        : \"bg-surface-base border-outline-gray-4 group-hover:border-outline-gray-5 group-active:border-outline-gray-6\",\n  ),\n);\n\nfunction focus(options?: FocusOptions): void {\n  inputRef.value?.focus(options);\n}\n\ndefineExpose({ focus });\n</script>\n\n<template>\n  <label\n    v-bind=\"attrs\"\n    :for=\"inputId\"\n    data-slot=\"control\"\n    :data-state=\"isSelected ? 'checked' : 'unchecked'\"\n    :data-size=\"group.size.value\"\n    :data-disabled=\"isDisabled ? 'true' : undefined\"\n    :class=\"rowClasses\"\n  >\n    <input\n      ref=\"inputRef\"\n      :id=\"inputId\"\n      type=\"radio\"\n      :name=\"group.name.value\"\n      :value=\"String(props.value)\"\n      :checked=\"isSelected\"\n      :disabled=\"isDisabled\"\n      :required=\"group.required.value\"\n      :aria-required=\"group.required.value || undefined\"\n      :aria-labelledby=\"hasLabel ? labelId : undefined\"\n      :aria-describedby=\"hasDescription ? descriptionId : undefined\"\n      :aria-invalid=\"group.hasError.value || undefined\"\n      :aria-errormessage=\"group.hasError.value ? group.errorId : undefined\"\n      class=\"peer sr-only\"\n      data-slot=\"input\"\n      @change=\"group.onSelect(props.value)\"\n    />\n    <span :class=\"circleClasses\" aria-hidden=\"true\" />\n    <span class=\"flex flex-col items-start gap-0.5 text-start\">\n      <span\n        v-if=\"hasLabel\"\n        :id=\"labelId\"\n        data-slot=\"label\"\n        :class=\"\n          cn(\n            'block select-none text-base leading-normal',\n            isDisabled ? 'text-ink-gray-4' : 'text-ink-gray-7',\n          )\n        \"\n      >\n        <slot name=\"label\">{{ props.label }}</slot>\n      </span>\n      <span\n        v-if=\"hasDescription\"\n        :id=\"descriptionId\"\n        data-slot=\"description\"\n        :class=\"\n          cn(\n            'block select-none text-sm leading-normal',\n            isDisabled ? 'text-ink-gray-3' : 'text-ink-gray-5',\n          )\n        \"\n      >\n        <slot name=\"description\">{{ props.description }}</slot>\n      </span>\n    </span>\n  </label>\n</template>\n",
      "type": "registry:ui"
    },
    {
      "path": "components/ui/radio.css",
      "content": "/* Radio inherits geometry from the radio-group tokens. */\n",
      "type": "registry:style"
    }
  ]
}