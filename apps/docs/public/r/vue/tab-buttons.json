      "path": "components/ui/TabButtons.vue",
      "content": "<script setup lang=\"ts\">\nimport { computed, nextTick, onBeforeUnmount, onMounted, ref, useId, watch, type Component } from \"vue\";\nimport { cn } from \"@/lib/utils\";\n\ntype TabButtonValue = string | number;\ntype TabButtonsVariant = \"subtle\" | \"ghost\" | \"underline\" | \"browser-tab\";\ntype TabButtonsSize = \"sm\" | \"md\";\n\ntype TabButtonOption = {\n  value: TabButtonValue;\n  label: string;\n  icon?: string | Component;\n  iconLeft?: string | Component;\n  disabled?: boolean;\n  href?: string;\n};\n\nconst props = withDefaults(\n  defineProps<{\n    modelValue?: TabButtonValue;\n    defaultValue?: TabButtonValue;\n    options?: TabButtonOption[];\n    variant?: TabButtonsVariant;\n    size?: TabButtonsSize;\n    vertical?: boolean;\n    fluid?: boolean;\n    class?: string;\n  }>(),\n  {\n    options: () => [],\n    variant: \"subtle\",\n    size: \"sm\",\n    vertical: false,\n    fluid: false,\n  },\n);\n\nconst emit = defineEmits<{\n  \"update:modelValue\": [value: TabButtonValue];\n}>();\n\nconst trackRef = ref<HTMLElement | null>(null);\nconst internalValue = ref<TabButtonValue | undefined>(props.defaultValue);\nconst selected = computed(() =>\n  props.modelValue !== undefined ? props.modelValue : internalValue.value,\n);\nconst indicator = ref<{ x: number; y: number; width: number; height: number } | null>(null);\nconst animated = ref(false);\nconst isPill = computed(() => props.variant === \"subtle\" || props.variant === \"ghost\");\nconst baseId = useId().replace(/:/g, \"\");\n\nconst trackClasses: Record<TabButtonsVariant, string> = {\n  subtle: \"bg-surface-gray-2 gap-1 p-px\",\n  ghost: \"bg-surface-base gap-1 p-px\",\n  underline: \"gap-6 border-b border-outline-gray-1\",\n  \"browser-tab\": \"gap-1 border-b border-outline-gray-1\",\n};\n\nconst trackRadiusClasses: Record<TabButtonsVariant, string> = {\n  subtle: \"rounded-4\",\n  ghost: \"rounded-4\",\n  underline: \"\",\n  \"browser-tab\": \"\",\n};\n\nconst indicatorSurfaceClasses: Record<TabButtonsVariant, string> = {\n  subtle: \"bg-surface-elevation-3 shadow-base rounded-[7px]\",\n  ghost: \"bg-surface-gray-2 rounded-[7px]\",\n  underline: \"bg-outline-gray-8\",\n  \"browser-tab\": \"\",\n};\n\nfunction pillSizeClasses(variant: TabButtonsVariant, size: TabButtonsSize, iconOnly: boolean) {\n  if (iconOnly) return size === \"sm\" ? \"size-6.5 p-[5px]\" : \"size-7 p-[5px]\";\n  if (variant === \"underline\") {\n    if (props.vertical) return size === \"sm\" ? \"h-6.5 gap-2 px-2\" : \"h-7 gap-2 px-2\";\n    return size === \"sm\" ? \"h-7 gap-2\" : \"h-8 gap-2\";\n  }\n  if (variant === \"browser-tab\") {\n    if (props.vertical) return size === \"sm\" ? \"h-6.5 gap-2 px-2\" : \"h-7 gap-2 px-2.5\";\n    return size === \"sm\" ? \"h-7 gap-2 px-2 py-[5px]\" : \"h-8 gap-2 px-2.5 py-[7px]\";\n  }\n  return size === \"sm\" ? \"h-6.5 gap-2 px-2 py-[5px]\" : \"h-7 gap-2 px-2.5 py-1.5\";\n}\n\nfunction pillRadiusClasses(variant: TabButtonsVariant, size: TabButtonsSize) {\n  if (variant === \"underline\") return \"\";\n  if (variant === \"subtle\") return size === \"sm\" ? \"rounded-[7px]\" : \"rounded-[9px]\";\n  if (variant === \"browser-tab\") return \"rounded-t-4\";\n  return size === \"sm\" ? \"rounded-[7px]\" : \"rounded-4\";\n}\n\nfunction isIconOnly(option: TabButtonOption) {\n  return Boolean(option.icon) && !option.iconLeft;\n}\n\nfunction measure() {\n  const track = trackRef.value;\n  if (!track) {\n    indicator.value = null;\n    return;\n  }\n  const active = track.querySelector<HTMLElement>(\n    '[data-slot=\"tab-button\"][data-state=\"active\"]',\n  );\n  if (!active) {\n    indicator.value = null;\n    return;\n  }\n\n  const trackRect = track.getBoundingClientRect();\n  const rect = active.getBoundingClientRect();\n  const style = getComputedStyle(track);\n  const border = {\n    top: parseFloat(style.borderTopWidth) || 0,\n    bottom: parseFloat(style.borderBottomWidth) || 0,\n    left: parseFloat(style.borderLeftWidth) || 0,\n    right: parseFloat(style.borderRightWidth) || 0,\n  };\n  const x = rect.left - trackRect.left - border.left;\n  const y = rect.top - trackRect.top - border.top;\n\n  if (props.variant === \"underline\") {\n    if (props.vertical) {\n      const innerWidth = trackRect.width - border.left - border.right;\n      indicator.value = { x: innerWidth, y, width: 1, height: rect.height };\n    } else {\n      const innerHeight = trackRect.height - border.top - border.bottom;\n      indicator.value = { x, y: innerHeight, width: rect.width, height: 1 };\n    }\n    return;\n  }\n\n  indicator.value = { x, y, width: rect.width, height: rect.height };\n}\n\nconst indicatorStyle = computed(() => {\n  const rect = indicator.value;\n  if (!rect) return { display: \"none\" };\n  return {\n    width: `${rect.width}px`,\n    height: `${rect.height}px`,\n    transform: `translate(${rect.x}px, ${rect.y}px)`,\n  };\n});\n\nconst rootClasses = computed(() =>\n  cn(\n    \"flex\",\n    props.fluid ? \"w-full\" : \"inline-flex shrink-0\",\n    props.vertical ? \"flex-col\" : \"items-center\",\n    isPill.value && \"relative isolate\",\n    props.variant === \"underline\" && \"relative\",\n    trackClasses[props.variant],\n    trackRadiusClasses[props.variant],\n    props.class,\n  ),\n);\n\nlet observer: ResizeObserver | undefined;\n\nonMounted(() => {\n  measure();\n  if (trackRef.value && typeof ResizeObserver !== \"undefined\") {\n    observer = new ResizeObserver(() => measure());\n    observer.observe(trackRef.value);\n  }\n  requestAnimationFrame(() => {\n    requestAnimationFrame(() => {\n      animated.value = true;\n    });\n  });\n});\n\nonBeforeUnmount(() => {\n  observer?.disconnect();\n  observer = undefined;\n});\n\nwatch(\n  [selected, () => props.variant, () => props.size, () => props.vertical, () => props.fluid, () => props.options],\n  () => nextTick(measure),\n);\n\nfunction select(value: TabButtonValue) {\n  if (props.modelValue === undefined) internalValue.value = value;\n  emit(\"update:modelValue\", value);\n}\n\nfunction onKeydown(event: KeyboardEvent) {\n  const enabled = props.options.filter((option) => !option.disabled);\n  if (!enabled.length) return;\n  const currentIndex = enabled.findIndex((option) => option.value === selected.value);\n  const forwardKey = props.vertical ? \"ArrowDown\" : \"ArrowRight\";\n  const backwardKey = props.vertical ? \"ArrowUp\" : \"ArrowLeft\";\n  let nextIndex = currentIndex;\n\n  if (event.key === \"Home\") nextIndex = 0;\n  else if (event.key === \"End\") nextIndex = enabled.length - 1;\n  else if (event.key === forwardKey || event.key === backwardKey) {\n    const step = event.key === forwardKey ? 1 : -1;\n    nextIndex = (Math.max(currentIndex, 0) + step + enabled.length) % enabled.length;\n  } else {\n    return;\n  }\n\n  event.preventDefault();\n  const next = enabled[nextIndex];\n  select(next.value);\n  nextTick(() => {\n    trackRef.value\n      ?.querySelector<HTMLElement>(\n        `[data-slot=\"tab-button\"][data-value=\"${String(next.value)}\"]`,\n      )\n      ?.focus();\n  });\n}\n\nfunction isActive(option: TabButtonOption) {\n  return option.value === selected.value;\n}\n\nfunction tabbable(option: TabButtonOption, index: number) {\n  if (option.disabled) return -1;\n  if (isActive(option)) return 0;\n  const firstEnabled = props.options.find((item) => !item.disabled);\n  return selected.value === undefined && firstEnabled?.value === option.value ? 0 : -1;\n}\n</script>\n\n<template>\n  <div\n    ref=\"trackRef\"\n    role=\"radiogroup\"\n    :aria-orientation=\"props.vertical ? 'vertical' : 'horizontal'\"\n    data-slot=\"tab-buttons\"\n    :data-variant=\"props.variant\"\n    :data-size=\"props.size\"\n    :data-orientation=\"props.vertical ? 'vertical' : 'horizontal'\"\n    :class=\"rootClasses\"\n    @keydown=\"onKeydown\"\n  >\n    <div\n      v-if=\"isPill\"\n      aria-hidden=\"true\"\n      :class=\"cn('pointer-events-none absolute inset-0 overflow-hidden', trackRadiusClasses[props.variant])\"\n    >\n      <div\n        data-slot=\"tab-indicator\"\n        :class=\"\n          cn(\n            'absolute left-0 top-0 -z-10 motion-reduce:transition-none',\n            animated && 'transition-[width,height,transform] duration-200 ease-[cubic-bezier(0.23,1,0.32,1)]',\n            indicatorSurfaceClasses[props.variant],\n          )\n        \"\n        :style=\"indicatorStyle\"\n      />\n    </div>\n    <div\n      v-else-if=\"props.variant === 'underline'\"\n      aria-hidden=\"true\"\n      data-slot=\"tab-indicator\"\n      :class=\"\n        cn(\n          'absolute left-0 top-0 motion-reduce:transition-none',\n          animated && 'transition-[width,height,transform] duration-200 ease-[cubic-bezier(0.23,1,0.32,1)]',\n        )\n      \"\n      :style=\"indicatorStyle\"\n    />\n\n    <component\n      :is=\"option.href ? 'a' : 'button'\"\n      v-for=\"(option, index) in props.options\"\n      :key=\"String(option.value)\"\n      v-bind=\"option.href ? { href: option.href, target: '_blank', rel: 'noreferrer noopener' } : { type: 'button', disabled: option.disabled }\"\n      role=\"radio\"\n      :aria-checked=\"isActive(option)\"\n      :aria-label=\"isIconOnly(option) ? option.label : undefined\"\n      :tabindex=\"tabbable(option, index)\"\n      data-slot=\"tab-button\"\n      :data-state=\"isActive(option) ? 'active' : 'inactive'\"\n      :data-value=\"String(option.value)\"\n      :class=\"\n        cn(\n          'inline-flex appearance-none p-0 text-inherit no-underline focus-visible:ring-0',\n          props.variant === 'browser-tab'\n            ? isActive(option)\n              ? 'relative -mb-px rounded-t-4 border border-outline-gray-1 border-b-transparent bg-surface-base'\n              : 'border border-transparent'\n            : 'border-0 bg-transparent',\n          props.vertical && 'w-full',\n          props.fluid && 'flex-1 min-w-0',\n          option.disabled && 'pointer-events-none opacity-60',\n        )\n      \"\n      @click=\"!option.disabled && select(option.value)\"\n    >\n      <span\n        :class=\"\n          cn(\n            'inline-flex box-border shrink-0 select-none items-center justify-center whitespace-nowrap outline-none transition-[background-color,color,box-shadow] duration-150 ease-out motion-reduce:transition-none',\n            props.variant === 'subtle' ? 'text-sm leading-[16.1px]' : 'text-base leading-tighter',\n            isActive(option) ? 'text-ink-gray-8' : 'text-ink-gray-5',\n            props.size === 'md' && props.variant !== 'underline' && props.variant !== 'subtle'\n              ? 'font-medium tracking-[0.015em]'\n              : '',\n            pillSizeClasses(props.variant, props.size, isIconOnly(option)),\n            pillRadiusClasses(props.variant, props.size),\n            !isActive(option) && 'hover:text-ink-gray-8',\n          )\n        \"\n      >\n        <span\n          v-if=\"option.icon\"\n          :class=\"\n            cn(\n              'inline-flex shrink-0 items-center justify-center [&_svg]:size-full',\n              props.size === 'sm' ? 'size-4' : 'size-4.5',\n            )\n          \"\n        >\n          <span v-if=\"typeof option.icon === 'string'\" :class=\"option.icon\" />\n          <component v-else :is=\"option.icon\" />\n        </span>\n        <span\n          v-else-if=\"option.iconLeft\"\n          :class=\"\n            cn(\n              'inline-flex shrink-0 items-center justify-center [&_svg]:size-full',\n              props.size === 'sm' ? 'size-4' : 'size-4.5',\n            )\n          \"\n        >\n          <span v-if=\"typeof option.iconLeft === 'string'\" :class=\"option.iconLeft\" />\n          <component v-else :is=\"option.iconLeft\" />\n        </span>\n        <span :class=\"isIconOnly(option) ? 'sr-only' : 'min-w-0 truncate'\">\n          {{ option.label }}\n        </span>\n      </span>\n    </component>\n  </div>\n</template>\n",
      "type": "registry:ui"
    },
    {
      "path": "components/ui/tab-buttons.css",
      "content": "/* The active surface slides between options; the track keeps the motion short. */\n[data-slot=\"tab-indicator\"] {\n  will-change: transform, width, height;\n}\n\n[data-slot=\"tab-button\"] {\n  -webkit-tap-highlight-color: transparent;\n}\n\n@media (prefers-reduced-motion: reduce) {\n  [data-slot=\"tab-indicator\"] {\n    transition: none;\n  }\n}\n",
      "type": "registry:style"
    }
  ]
