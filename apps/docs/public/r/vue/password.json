{
  "name": "password",
  "type": "registry:ui",
  "title": "Password",
  "description": "espresso-ui Password component (Vue)",
  "dependencies": [
    "clsx",
    "tailwind-merge",
    "@lucide/vue"
  ],
  "registryDependencies": [
    "text-input",
    "tooltip",
    "keyboard-shortcut"
  ],
  "files": [
    {
      "path": "components/ui/Password.vue",
      "content": "<script setup lang=\"ts\">\nimport { computed, ref } from \"vue\";\nimport { Eye, EyeOff } from \"@lucide/vue\";\nimport KeyboardShortcut from \"./KeyboardShortcut.vue\";\nimport TextInput from \"./TextInput.vue\";\nimport Tooltip from \"./Tooltip.vue\";\n\ndefineOptions({ inheritAttrs: false });\n\nconst props = withDefaults(\n  defineProps<{\n    defaultVisible?: boolean;\n    showEye?: boolean;\n  }>(),\n  {\n    defaultVisible: false,\n    showEye: true,\n  },\n);\n\nconst visible = ref(props.defaultVisible);\nconst toggleLabel = computed(() => (visible.value ? \"Hide password\" : \"Show password\"));\n\nfunction toggle() {\n  visible.value = !visible.value;\n}\n\nfunction onKeydown(event: KeyboardEvent) {\n  if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === \"i\") {\n    event.preventDefault();\n    toggle();\n  }\n}\n</script>\n\n<template>\n  <TextInput\n    v-bind=\"$attrs\"\n    :type=\"visible ? 'text' : 'password'\"\n    @keydown=\"onKeydown\"\n  >\n    <template v-if=\"props.showEye\" #suffix>\n      <Tooltip>\n        <template #content>\n          <span class=\"flex items-center gap-1.5\">\n            {{ toggleLabel }}\n            <KeyboardShortcut combo=\"Mod+I\" />\n          </span>\n        </template>\n        <button\n          type=\"button\"\n          data-slot=\"password-toggle\"\n          :aria-label=\"toggleLabel\"\n          :disabled=\"$attrs.disabled as boolean | undefined\"\n          class=\"grid size-5 place-items-center rounded-3 text-ink-gray-5 hover:bg-surface-gray-3 hover:text-ink-gray-7 disabled:pointer-events-none\"\n          @pointerdown.prevent\n          @click=\"toggle\"\n        >\n          <EyeOff v-if=\"visible\" aria-hidden=\"true\" class=\"size-3.5\" />\n          <Eye v-else aria-hidden=\"true\" class=\"size-3.5\" />\n        </button>\n      </Tooltip>\n    </template>\n  </TextInput>\n</template>\n",
      "type": "registry:ui"
    },
    {
      "path": "components/ui/password.css",
      "content": "/* The reveal button sits inside the field's end padding, so it never covers\n   the value. */\n[data-slot=\"password-toggle\"] {\n  -webkit-tap-highlight-color: transparent;\n}\n",
      "type": "registry:style"
    }
  ]
}