{
  "name": "badge",
  "type": "registry:ui",
  "title": "Badge",
  "description": "espresso-ui Badge component (Vue)",
  "dependencies": [
    "@ark-ui/vue",
    "clsx",
    "tailwind-merge",
    "class-variance-authority"
  ],
  "registryDependencies": [],
  "files": [
    {
      "path": "components/ui/Badge.vue",
      "content": "<script setup lang=\"ts\">\nimport { computed } from \"vue\";\nimport { ark } from \"@ark-ui/vue/factory\";\nimport { cva, type VariantProps } from \"class-variance-authority\";\nimport { cn } from \"@/lib/utils\";\n\nconst badgeVariants = cva(\n  \"inline-flex shrink-0 select-none items-center gap-(--badge-gap) overflow-clip whitespace-nowrap rounded-(--badge-radius) leading-tighter [&_svg]:pointer-events-none [&_svg]:shrink-0\",\n  {\n    variants: {\n      theme: { gray: \"\", blue: \"\", green: \"\", amber: \"\", red: \"\", violet: \"\" },\n      variant: {\n        solid: \"\",\n        subtle: \"\",\n        outline: \"border bg-transparent\",\n        ghost: \"bg-transparent\",\n      },\n      size: {\n        sm: \"h-(--badge-sm-height) px-(--badge-sm-px) [font-size:var(--badge-sm-font-size)] [&_svg]:size-(--badge-sm-icon-size)\",\n        md: \"h-(--badge-md-height) px-(--badge-md-px) [font-size:var(--badge-md-font-size)] [&_svg]:size-(--badge-md-icon-size)\",\n        lg: \"h-(--badge-lg-height) px-(--badge-lg-px) [font-size:var(--badge-lg-font-size)] [&_svg]:size-(--badge-lg-icon-size)\",\n      },\n    },\n    compoundVariants: [\n      { theme: \"gray\", variant: \"solid\", class: \"bg-surface-gray-10 text-ink-base\" },\n      { theme: \"gray\", variant: \"subtle\", class: \"bg-surface-gray-2 text-ink-gray-6\" },\n      { theme: \"gray\", variant: \"outline\", class: \"border-outline-gray-2 text-ink-gray-6\" },\n      { theme: \"gray\", variant: \"ghost\", class: \"text-ink-gray-6\" },\n      { theme: \"blue\", variant: \"solid\", class: \"bg-surface-blue-7 text-white\" },\n      { theme: \"blue\", variant: \"subtle\", class: \"bg-surface-blue-2 text-ink-blue-7\" },\n      { theme: \"blue\", variant: \"outline\", class: \"border-outline-blue-3 text-ink-blue-7\" },\n      { theme: \"blue\", variant: \"ghost\", class: \"text-ink-blue-7\" },\n      { theme: \"green\", variant: \"solid\", class: \"bg-surface-green-7 text-white\" },\n      { theme: \"green\", variant: \"subtle\", class: \"bg-surface-green-2 text-ink-green-7\" },\n      { theme: \"green\", variant: \"outline\", class: \"border-outline-green-3 text-ink-green-7\" },\n      { theme: \"green\", variant: \"ghost\", class: \"text-ink-green-7\" },\n      { theme: \"amber\", variant: \"solid\", class: \"bg-surface-amber-7 text-white\" },\n      { theme: \"amber\", variant: \"subtle\", class: \"bg-surface-amber-2 text-ink-amber-7\" },\n      { theme: \"amber\", variant: \"outline\", class: \"border-outline-amber-3 text-ink-amber-7\" },\n      { theme: \"amber\", variant: \"ghost\", class: \"text-ink-amber-7\" },\n      { theme: \"red\", variant: \"solid\", class: \"bg-surface-red-7 text-white\" },\n      { theme: \"red\", variant: \"subtle\", class: \"bg-surface-red-2 text-ink-red-7\" },\n      { theme: \"red\", variant: \"outline\", class: \"border-outline-red-3 text-ink-red-7\" },\n      { theme: \"red\", variant: \"ghost\", class: \"text-ink-red-7\" },\n      { theme: \"violet\", variant: \"solid\", class: \"bg-surface-violet-7 text-white\" },\n      { theme: \"violet\", variant: \"subtle\", class: \"bg-surface-violet-2 text-ink-violet-7\" },\n      { theme: \"violet\", variant: \"outline\", class: \"border-outline-violet-3 text-ink-violet-7\" },\n      { theme: \"violet\", variant: \"ghost\", class: \"text-ink-violet-7\" },\n    ],\n    defaultVariants: { theme: \"gray\", variant: \"subtle\", size: \"md\" },\n  },\n);\n\nconst themeAliases = {\n  default: \"gray\",\n  error: \"red\",\n  warning: \"amber\",\n  success: \"green\",\n  info: \"blue\",\n} as const;\n\ntype CanonicalBadgeTheme = NonNullable<VariantProps<typeof badgeVariants>[\"theme\"]>;\ntype BadgeTheme = CanonicalBadgeTheme | keyof typeof themeAliases;\n\nconst props = withDefaults(\n  defineProps<{\n    theme?: BadgeTheme;\n    variant?: VariantProps<typeof badgeVariants>[\"variant\"];\n    size?: VariantProps<typeof badgeVariants>[\"size\"];\n    label?: string | number;\n    class?: string;\n  }>(),\n  {\n    theme: \"gray\",\n    variant: \"subtle\",\n    size: \"md\",\n  },\n);\n\nconst resolvedTheme = computed(\n  () => ((themeAliases as Record<string, string>)[props.theme] ?? props.theme) as CanonicalBadgeTheme,\n);\n\nconst classes = computed(() =>\n  cn(\n    badgeVariants({ theme: resolvedTheme.value, variant: props.variant, size: props.size }),\n    props.class,\n  ),\n);\n</script>\n\n<template>\n  <component :is=\"ark.span\" :class=\"classes\" v-bind=\"$attrs\">\n    <span v-if=\"$slots.prefix\" class=\"inline-flex shrink-0 items-center justify-center\">\n      <slot name=\"prefix\" />\n    </span>\n    <slot>{{ props.label }}</slot>\n    <span v-if=\"$slots.suffix\" class=\"inline-flex shrink-0 items-center justify-center\">\n      <slot name=\"suffix\" />\n    </span>\n  </component>\n</template>\n",
      "type": "registry:ui"
    },
    {
      "path": "components/ui/badge.css",
      "content": "/* Badge component tokens — override these to customise badges. */\n:root {\n  --badge-gap: 4px;\n  --badge-radius: var(--radius-full);\n\n  /* Size: sm */\n  --badge-sm-height: 16px;\n  --badge-sm-px: 6px;\n  --badge-sm-font-size: 12px;\n  --badge-sm-icon-size: 10px;\n\n  /* Size: md */\n  --badge-md-height: 20px;\n  --badge-md-px: 6px;\n  --badge-md-font-size: 12px;\n  --badge-md-icon-size: 10px;\n\n  /* Size: lg */\n  --badge-lg-height: 24px;\n  --badge-lg-px: 8px;\n  --badge-lg-font-size: 13px;\n  --badge-lg-icon-size: 12px;\n}\n",
      "type": "registry:style"
    }
  ]
}