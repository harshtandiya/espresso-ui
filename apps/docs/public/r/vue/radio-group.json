      "path": "components/ui/RadioGroup.vue",
      "content": "<script lang=\"ts\">\nimport type { ComputedRef, InjectionKey } from \"vue\";\n\nexport type RadioSize = \"xs\" | \"sm\" | \"md\";\nexport type RadioOrientation = \"vertical\" | \"horizontal\";\nexport type RadioValue = string | number | boolean;\nexport type RadioGroupError =\n  | string\n  | string[]\n  | (Error & { messages?: string | string[] })\n  | null;\n\nexport type RadioGroupContext = {\n  name: ComputedRef<string>;\n  value: ComputedRef<RadioValue | undefined>;\n  size: ComputedRef<RadioSize>;\n  padded: ComputedRef<boolean>;\n  disabled: ComputedRef<boolean>;\n  required: ComputedRef<boolean>;\n  hasError: ComputedRef<boolean>;\n  errorId: string;\n  onSelect: (value: RadioValue) => void;\n};\n\nexport const RADIO_GROUP_KEY: InjectionKey<RadioGroupContext> = Symbol.for(\n  \"espresso-ui.radio-group\",\n);\n</script>\n\n<script setup lang=\"ts\">\nimport { computed, provide, ref, useAttrs, useId } from \"vue\";\nimport { cn } from \"@/lib/utils\";\n\ndefineOptions({ inheritAttrs: false });\n\nconst props = withDefaults(\n  defineProps<{\n    modelValue?: RadioValue;\n    defaultValue?: RadioValue;\n    size?: RadioSize;\n    padded?: boolean;\n    disabled?: boolean;\n    orientation?: RadioOrientation;\n    loop?: boolean;\n    name?: string;\n    label?: string;\n    description?: string;\n    error?: RadioGroupError;\n    required?: boolean;\n    class?: string;\n  }>(),\n  {\n    size: \"sm\",\n    padded: false,\n    disabled: false,\n    orientation: \"vertical\",\n    loop: true,\n    label: \"\",\n    description: \"\",\n    error: \"\",\n    required: false,\n  },\n);\n\nconst emit = defineEmits<{\n  \"update:modelValue\": [value: RadioValue];\n}>();\n\nconst attrs = useAttrs();\nconst slots = defineSlots<{\n  default?: () => unknown;\n  label?: (props: { required: boolean }) => unknown;\n  description?: () => unknown;\n}>();\n\nconst fallbackId = useId();\nconst labelId = computed(() => `radio-group-${fallbackId}-label`);\nconst descriptionId = computed(() => `radio-group-${fallbackId}-description`);\nconst errorId = computed(() => `radio-group-${fallbackId}-error`);\nconst groupName = computed(() => props.name ?? `radio-group-${fallbackId.replace(/:/g, \"\")}`);\n\nconst internalValue = ref<RadioValue | undefined>(props.defaultValue);\nconst isControlled = computed(() => props.modelValue !== undefined);\nconst currentValue = computed(() =>\n  isControlled.value ? props.modelValue : internalValue.value,\n);\n\nconst errorLines = computed(() => {\n  const value = props.error;\n  if (!value) return [];\n  if (typeof value === \"string\") return [value];\n  if (Array.isArray(value)) return value.filter(Boolean).map(String);\n  if (value instanceof Error) {\n    const messages = value.messages;\n    if (Array.isArray(messages) && messages.length) return messages.filter(Boolean).map(String);\n    if (typeof messages === \"string\" && messages) return [messages];\n    return value.message ? [value.message] : [];\n  }\n  return [String(value)];\n});\nconst hasError = computed(() => errorLines.value.length > 0);\nconst hasLabel = computed(() => Boolean(props.label || slots.label));\nconst hasDescription = computed(() => Boolean(props.description || slots.description));\nconst stacked = computed(() => props.orientation === \"vertical\");\n\nconst externalDescribedBy = computed(() => attrs[\"aria-describedby\"] as string | undefined);\nconst describedBy = computed(\n  () =>\n    [\n      props.description && !hasError.value ? descriptionId.value : null,\n      hasError.value ? errorId.value : null,\n      externalDescribedBy.value,\n    ]\n      .filter(Boolean)\n      .join(\" \") || undefined,\n);\n\nconst controlAttrs = computed(() =>\n  Object.fromEntries(\n    Object.entries(attrs).filter(\n      ([key]) => key !== \"class\" && key !== \"style\" && key !== \"aria-describedby\",\n    ),\n  ),\n);\n\nfunction select(next: RadioValue): void {\n  if (!isControlled.value) internalValue.value = next;\n  emit(\"update:modelValue\", next);\n}\n\nprovide(RADIO_GROUP_KEY, {\n  name: groupName,\n  value: currentValue,\n  size: computed(() => props.size),\n  padded: computed(() => props.padded),\n  disabled: computed(() => props.disabled),\n  required: computed(() => props.required),\n  hasError,\n  errorId: errorId.value,\n  onSelect: select,\n});\n</script>\n\n<template>\n  <div :class=\"cn('flex flex-col', props.class)\">\n    <div\n      v-if=\"hasLabel\"\n      :id=\"labelId\"\n      class=\"block [font-size:var(--label-font-size,13px)] [font-weight:var(--label-font-weight,420)] leading-tighter [color:var(--label-color,var(--ink-gray-6))]\"\n    >\n      <slot v-if=\"$slots.label\" name=\"label\" :required=\"props.required\" />\n      <template v-else>\n        {{ props.label }}\n        <template v-if=\"props.required\">\n          <span class=\"select-none [color:var(--label-required-color,var(--ink-red-5))]\" aria-hidden=\"true\">*</span>\n          <span class=\"sr-only\">(required)</span>\n        </template>\n      </template>\n    </div>\n    <div\n      role=\"radiogroup\"\n      :aria-labelledby=\"hasLabel ? labelId : undefined\"\n      :aria-describedby=\"describedBy\"\n      :aria-required=\"props.required || undefined\"\n      :aria-orientation=\"props.orientation\"\n      :aria-invalid=\"hasError || undefined\"\n      :aria-errormessage=\"hasError ? errorId : undefined\"\n      data-slot=\"group\"\n      :data-size=\"props.size\"\n      :data-padded=\"props.padded ? 'true' : undefined\"\n      :data-orientation=\"props.orientation\"\n      :data-disabled=\"props.disabled ? 'true' : undefined\"\n      :data-loop=\"props.loop ? 'true' : 'false'\"\n      :class=\"\n        cn(\n          'flex',\n          stacked ? 'flex-col' : 'flex-row flex-wrap items-center',\n          props.padded ? '' : stacked ? 'gap-y-1.5' : 'gap-x-4',\n          hasLabel ? 'mt-1.5' : '',\n        )\n      \"\n      v-bind=\"controlAttrs\"\n    >\n      <slot />\n    </div>\n    <p\n      v-if=\"hasDescription && (!hasError || $slots.description)\"\n      :id=\"descriptionId\"\n      class=\"mt-1 [font-size:var(--input-description-font-size)] leading-tighter text-ink-gray-5\"\n    >\n      <slot name=\"description\">{{ props.description }}</slot>\n    </p>\n    <div\n      v-if=\"hasError\"\n      :id=\"errorId\"\n      role=\"alert\"\n      class=\"mt-1 [font-size:var(--input-description-font-size)] leading-tighter text-ink-red-7\"\n    >\n      <p v-for=\"(line, index) in errorLines\" :key=\"index\">{{ line }}</p>\n    </div>\n  </div>\n</template>\n",
      "type": "registry:ui"
    },
    {
      "path": "components/ui/radio-group.css",
      "content": "/* RadioGroup and Radio tokens — frappe-ui v1 control geometry. */\n:root {\n  /* Control diameter: xs 13px / sm 14px / md 16px */\n  --radio-xs-size: 13px;\n  --radio-sm-size: 14px;\n  --radio-md-size: 16px;\n\n  /* Selected ring width leaves a surface-base hole in the centre. */\n  --radio-xs-checked-border: 3.7px;\n  --radio-sm-checked-border: 4px;\n  --radio-md-checked-border: 4.5px;\n\n  /* Optical offset from the first line of the label. */\n  --radio-xs-offset: 4px;\n  --radio-sm-offset: 3.5px;\n  --radio-md-offset: 2.5px;\n\n  --radio-padded-radius: var(--radius-4);\n}\n",
      "type": "registry:style"
    }
