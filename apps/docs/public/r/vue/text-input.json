{
  "name": "text-input",
  "type": "registry:ui",
  "title": "TextInput",
  "description": "espresso-ui TextInput component (Vue)",
  "dependencies": [
    "clsx",
    "tailwind-merge"
  ],
  "registryDependencies": [],
  "files": [
    {
      "path": "components/ui/TextInput.vue",
      "content": "<script setup lang=\"ts\">\nimport { computed, ref, useId, useSlots } from \"vue\";\nimport { cn } from \"@/lib/utils\";\n\nconst sizeClasses: Record<string, string> = {\n  xs: \"h-(--input-xs-height) rounded-(--input-xs-radius) [font-size:var(--input-xs-font-size)]\",\n  sm: \"h-(--input-sm-height) rounded-(--input-sm-radius) [font-size:var(--input-sm-font-size)]\",\n  md: \"h-(--input-md-height) rounded-(--input-md-radius) [font-size:var(--input-md-font-size)]\",\n  lg: \"h-(--input-lg-height) rounded-(--input-lg-radius) [font-size:var(--input-lg-font-size)]\",\n};\n\nconst prefixPadding: Record<string, string> = {\n  xs: \"ps-1.5\",\n  sm: \"ps-2\",\n  md: \"ps-2.5\",\n  lg: \"ps-3\",\n};\n\nconst suffixPadding: Record<string, string> = {\n  xs: \"pe-1.5\",\n  sm: \"pe-2\",\n  md: \"pe-2.5\",\n  lg: \"pe-3\",\n};\n\nconst paddingClasses: Record<string, { plain: string; prefix: string; suffix: string; both: string }> = {\n  xs: { plain: \"px-1.5\", prefix: \"ps-7 pe-1.5\", suffix: \"ps-1.5 pe-7\", both: \"ps-7 pe-7\" },\n  sm: { plain: \"px-2\", prefix: \"ps-8 pe-2\", suffix: \"ps-2 pe-8\", both: \"ps-8 pe-8\" },\n  md: { plain: \"px-2.5\", prefix: \"ps-9 pe-2.5\", suffix: \"ps-2.5 pe-9\", both: \"ps-9 pe-9\" },\n  lg: { plain: \"px-3\", prefix: \"ps-10 pe-3\", suffix: \"ps-3 pe-10\", both: \"ps-10 pe-10\" },\n};\n\nconst variantClasses: Record<string, string> = {\n  subtle:\n    \"border-surface-gray-2 bg-surface-gray-2 hover:border-outline-elevation-2 hover:bg-surface-gray-3 focus:border-outline-gray-4 focus:bg-surface-base focus:shadow-sm\",\n  outline:\n    \"border-outline-gray-2 bg-surface-base hover:border-outline-gray-3 hover:shadow-sm focus:border-outline-gray-4 focus:bg-surface-base focus:shadow-sm\",\n  ghost: \"border-transparent bg-transparent focus:outline-none\",\n};\n\nconst props = withDefaults(\n  defineProps<{\n    modelValue?: string | number;\n    type?: string;\n    size?: \"xs\" | \"sm\" | \"md\" | \"lg\";\n    variant?: \"subtle\" | \"outline\" | \"ghost\";\n    label?: string;\n    description?: string;\n    error?: string;\n    required?: boolean;\n    disabled?: boolean;\n    id?: string;\n    class?: string;\n  }>(),\n  {\n    modelValue: \"\",\n    type: \"text\",\n    size: \"sm\",\n    variant: \"subtle\",\n    label: \"\",\n    description: \"\",\n    error: \"\",\n    required: false,\n    disabled: false,\n  },\n);\n\nconst emit = defineEmits<{\n  \"update:modelValue\": [value: string];\n}>();\n\nconst slots = useSlots();\nconst fallbackId = useId();\nconst inputId = computed(() => props.id || fallbackId);\nconst descriptionId = computed(() => `${inputId.value}-description`);\nconst errorId = computed(() => `${inputId.value}-error`);\nconst hasError = computed(() => Boolean(props.error));\nconst hasLabeling = computed(() => Boolean(props.label || props.description || props.error));\nconst describedBy = computed(() =>\n  [props.description && !hasError.value ? descriptionId.value : null, hasError.value ? errorId.value : null]\n    .filter(Boolean)\n    .join(\" \") || undefined,\n);\nconst paddingClass = computed(() => {\n  const padding = paddingClasses[props.size];\n  const hasPrefix = Boolean(slots.prefix);\n  const hasSuffix = Boolean(slots.suffix);\n  if (hasPrefix && hasSuffix) return padding.both;\n  if (hasPrefix) return padding.prefix;\n  if (hasSuffix) return padding.suffix;\n  return padding.plain;\n});\nconst controlClasses = computed(() =>\n  cn(\n    \"w-full border leading-tighter text-ink-gray-8 transition-colors outline-none placeholder:text-ink-gray-4 disabled:cursor-not-allowed disabled:border-surface-gray-2 disabled:bg-surface-gray-1 disabled:text-ink-gray-5 disabled:placeholder:text-ink-gray-3\",\n    sizeClasses[props.size],\n    paddingClass.value,\n    variantClasses[props.variant],\n    !hasLabeling.value && props.class,\n  ),\n);\n\nconst inputRef = ref<HTMLInputElement | null>(null);\n\nfunction onInput(event: Event): void {\n  emit(\"update:modelValue\", (event.target as HTMLInputElement).value);\n}\n\nfunction focus(options?: FocusOptions): void {\n  inputRef.value?.focus(options);\n}\n\ndefineExpose({ focus });\n</script>\n\n<template>\n  <div :class=\"cn(hasLabeling && 'flex flex-col gap-1.5', hasLabeling && props.class)\">\n    <label\n      v-if=\"props.label\"\n      :for=\"inputId\"\n      class=\"block [font-size:var(--label-font-size,13px)] [font-weight:var(--label-font-weight,420)] leading-tighter [color:var(--label-color,var(--ink-gray-6))]\"\n    >\n      {{ props.label }}\n      <template v-if=\"props.required\">\n        <span class=\"select-none [color:var(--label-required-color,var(--ink-red-5))]\" aria-hidden=\"true\">*</span>\n        <span class=\"sr-only\">(required)</span>\n      </template>\n    </label>\n    <div :class=\"cn('relative flex items-center', !hasLabeling && props.class)\">\n      <span\n        v-if=\"$slots.prefix\"\n        :class=\"cn(\n          'pointer-events-none absolute inset-y-0 start-0 flex items-center',\n          prefixPadding[props.size],\n          props.disabled ? 'text-ink-gray-5' : 'text-ink-gray-8',\n        )\"\n      >\n        <slot name=\"prefix\" />\n      </span>\n      <input\n        ref=\"inputRef\"\n        :id=\"inputId\"\n        :type=\"props.type\"\n        :value=\"props.modelValue\"\n        :required=\"props.required\"\n        :disabled=\"props.disabled\"\n        :aria-required=\"props.required || undefined\"\n        :aria-invalid=\"hasError || undefined\"\n        :aria-errormessage=\"hasError ? errorId : undefined\"\n        :aria-describedby=\"describedBy\"\n        data-slot=\"control\"\n        :data-size=\"props.size\"\n        :data-variant=\"props.variant\"\n        :data-state=\"hasError ? 'invalid' : 'valid'\"\n        :data-disabled=\"props.disabled ? 'true' : undefined\"\n        :data-required=\"props.required ? 'true' : undefined\"\n        :class=\"controlClasses\"\n        v-bind=\"$attrs\"\n        @input=\"onInput\"\n      />\n      <span\n        v-if=\"$slots.suffix\"\n        :class=\"cn(\n          'pointer-events-none absolute inset-y-0 end-0 flex items-center',\n          suffixPadding[props.size],\n          props.disabled ? 'text-ink-gray-5' : 'text-ink-gray-8',\n        )\"\n      >\n        <slot name=\"suffix\" />\n      </span>\n    </div>\n    <p\n      v-if=\"props.description && !hasError\"\n      :id=\"descriptionId\"\n      class=\"[font-size:var(--input-description-font-size)] leading-tighter text-ink-gray-5\"\n    >\n      {{ props.description }}\n    </p>\n    <p\n      v-if=\"hasError\"\n      :id=\"errorId\"\n      role=\"alert\"\n      class=\"[font-size:var(--input-description-font-size)] leading-tighter text-ink-red-7\"\n    >\n      {{ props.error }}\n    </p>\n  </div>\n</template>\n",
      "type": "registry:ui"
    },
    {
      "path": "components/ui/text-input.css",
      "content": "/* TextInput component tokens — mirrors frappe-ui v1 control geometry. */\n:root {\n  /* Size: xs (24px) */\n  --input-xs-height: 24px;\n  --input-xs-radius: var(--radius-3);\n  --input-xs-font-size: 12px;\n\n  /* Size: sm (28px) */\n  --input-sm-height: 28px;\n  --input-sm-radius: var(--radius-4);\n  --input-sm-font-size: 14px;\n\n  /* Size: md (32px) */\n  --input-md-height: 32px;\n  --input-md-radius: var(--radius-4);\n  --input-md-font-size: 14px;\n\n  /* Size: lg (40px) */\n  --input-lg-height: 40px;\n  --input-lg-radius: var(--radius-5);\n  --input-lg-font-size: 16px;\n\n  --input-description-font-size: 13px;\n}\n",
      "type": "registry:style"
    }
  ]
}