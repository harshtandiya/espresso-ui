{
  "name": "checkbox",
  "type": "registry:ui",
  "title": "Checkbox",
  "description": "espresso-ui Checkbox component (Vue)",
  "dependencies": [
    "clsx",
    "tailwind-merge",
    "@lucide/vue"
  ],
  "registryDependencies": [],
  "files": [
    {
      "path": "components/ui/Checkbox.vue",
      "content": "<script setup lang=\"ts\">\nimport { computed, ref, useAttrs, useId, useSlots, watch, watchEffect } from \"vue\";\nimport { Check, Minus } from \"@lucide/vue\";\nimport { cn } from \"@/lib/utils\";\n\ndefineOptions({ inheritAttrs: false });\n\nconst sizeClasses: Record<string, string> = {\n  xs: \"size-(--checkbox-xs-size)\",\n  sm: \"size-(--checkbox-sm-size)\",\n  md: \"size-(--checkbox-md-size)\",\n};\n\nconst iconSizeClasses: Record<string, string> = {\n  xs: \"size-2\",\n  sm: \"size-2.5\",\n  md: \"size-3\",\n};\n\nconst paddedSizeClasses: Record<string, string> = {\n  xs: \"h-(--checkbox-xs-height) px-1.5\",\n  sm: \"h-(--checkbox-sm-height) px-1.5\",\n  md: \"h-(--checkbox-md-height) px-3\",\n};\n\nconst props = withDefaults(\n  defineProps<{\n    size?: \"xs\" | \"sm\" | \"md\";\n    padded?: boolean;\n    indeterminate?: boolean;\n    label?: string;\n    description?: string;\n    error?: string;\n    required?: boolean;\n    disabled?: boolean;\n    id?: string;\n    class?: string;\n  }>(),\n  {\n    size: \"sm\",\n    padded: false,\n    indeterminate: false,\n    label: \"\",\n    description: \"\",\n    error: \"\",\n    required: false,\n    disabled: false,\n  },\n);\n\nconst model = defineModel<boolean | 1 | 0>();\nconst attrs = useAttrs();\nconst slots = useSlots();\nconst fallbackId = useId();\nconst inputRef = ref<HTMLInputElement | null>(null);\nconst inputId = computed(() => props.id || fallbackId);\nconst descriptionId = computed(() => `${inputId.value}-description`);\nconst errorId = computed(() => `${inputId.value}-error`);\nconst hasError = computed(() => Boolean(props.error));\nconst hasLabel = computed(() => Boolean(props.label || slots.label));\nconst hasDescription = computed(() => Boolean(props.description || slots.description));\nconst hasDetail = computed(() => Boolean(hasDescription.value || props.error));\nconst checked = computed(() => Boolean(model.value));\nconst mixed = ref(props.indeterminate);\nconst describedBy = computed(\n  () =>\n    [props.description && !hasError.value ? descriptionId.value : null, hasError.value ? errorId.value : null]\n      .filter(Boolean)\n      .join(\" \") || undefined,\n);\n\nconst controlAttrs = computed(() =>\n  Object.fromEntries(Object.entries(attrs).filter(([key]) => key !== \"class\" && key !== \"style\")),\n);\n\nconst rootClasses = computed(() =>\n  cn(\n    \"flex-col\",\n    props.padded ? \"flex\" : \"inline-flex\",\n    props.padded && \"group rounded-(--checkbox-padded-radius) transition-colors\",\n    props.padded &&\n      !props.disabled &&\n      \"cursor-pointer hover:bg-surface-gray-3 active:bg-surface-gray-4 [&:has(:focus-visible)]:[outline:var(--focus-outline-default)]\",\n    props.padded && props.disabled && \"cursor-not-allowed opacity-70\",\n    props.padded && (hasDetail.value ? (props.size === \"md\" ? \"px-3 py-2\" : \"px-1.5 py-1.5\") : paddedSizeClasses[props.size]),\n    props.class,\n  ),\n);\n\nconst inputClasses = computed(() =>\n  cn(\n    \"peer shrink-0 appearance-none rounded-(--checkbox-radius) border bg-surface-base text-surface-base transition-colors outline-none\",\n    sizeClasses[props.size],\n    props.disabled\n      ? \"cursor-not-allowed border-outline-gray-3 text-surface-gray-5\"\n      : \"cursor-pointer border-outline-gray-4 hover:border-outline-gray-5 checked:border-surface-gray-10 checked:bg-surface-gray-10 indeterminate:border-surface-gray-10 indeterminate:bg-surface-gray-10 focus-visible:[outline:var(--focus-outline-default)]\",\n  ),\n);\n\nconst labelClasses = computed(() =>\n  cn(\n    \"select-none [font-size:var(--label-font-size,13px)] [font-weight:var(--label-font-weight,420)] leading-tighter [color:var(--label-color,var(--ink-gray-6))]\",\n    props.disabled\n      ? \"cursor-not-allowed [color:var(--label-disabled-color,var(--ink-gray-4))]\"\n      : \"cursor-pointer\",\n  ),\n);\n\nwatch(\n  () => props.indeterminate,\n  (value) => {\n    mixed.value = value;\n  },\n);\n\nwatchEffect(() => {\n  if (inputRef.value) inputRef.value.indeterminate = mixed.value;\n});\n\nfunction onChange(event: Event): void {\n  const target = event.target as HTMLInputElement;\n  model.value = target.checked;\n  mixed.value = false;\n  if (inputRef.value) inputRef.value.indeterminate = false;\n}\n\nfunction onContainerClick(event: MouseEvent): void {\n  if (!props.padded || props.disabled) return;\n  const target = event.target as HTMLElement;\n  if (target.closest('input[type=\"checkbox\"]') || target.closest(\"label\")) return;\n  inputRef.value?.click();\n}\n\nfunction focus(options?: FocusOptions): void {\n  inputRef.value?.focus(options);\n}\n\ndefineExpose({ focus });\n</script>\n\n<template>\n  <div :class=\"rootClasses\" :style=\"$attrs.style as any\" @click=\"onContainerClick\">\n    <div class=\"inline-flex items-center gap-(--checkbox-label-gap)\">\n      <span class=\"relative inline-flex shrink-0 items-center justify-center\">\n        <input\n          ref=\"inputRef\"\n          :id=\"inputId\"\n          type=\"checkbox\"\n          :checked=\"checked\"\n          :disabled=\"props.disabled\"\n          :required=\"props.required\"\n          :aria-required=\"props.required || undefined\"\n          :aria-invalid=\"hasError || undefined\"\n          :aria-errormessage=\"hasError ? errorId : undefined\"\n          :aria-describedby=\"describedBy\"\n          :aria-checked=\"mixed ? 'mixed' : undefined\"\n          data-slot=\"control\"\n          :data-size=\"props.size\"\n          :data-state=\"mixed ? 'indeterminate' : checked ? 'checked' : 'unchecked'\"\n          :data-disabled=\"props.disabled ? 'true' : undefined\"\n          :data-required=\"props.required ? 'true' : undefined\"\n          :class=\"inputClasses\"\n          v-bind=\"controlAttrs\"\n          @change=\"onChange\"\n        />\n        <Minus\n          v-if=\"mixed\"\n          aria-hidden=\"true\"\n          :class=\"cn('pointer-events-none absolute text-surface-base', iconSizeClasses[props.size])\"\n          :stroke-width=\"3\"\n        />\n        <Check\n          v-else\n          aria-hidden=\"true\"\n          :class=\"\n            cn(\n              'pointer-events-none absolute text-surface-base opacity-0 peer-checked:opacity-100',\n              iconSizeClasses[props.size],\n            )\n          \"\n          :stroke-width=\"3\"\n        />\n      </span>\n      <label v-if=\"hasLabel\" :for=\"inputId\" :class=\"labelClasses\">\n        <slot v-if=\"$slots.label\" name=\"label\" :required=\"props.required\" />\n        <template v-else>\n          {{ props.label }}\n          <template v-if=\"props.required\">\n            <span\n              class=\"select-none [color:var(--label-required-color,var(--ink-red-5))]\"\n              aria-hidden=\"true\"\n              >*</span\n            >\n            <span class=\"sr-only\">(required)</span>\n          </template>\n        </template>\n      </label>\n    </div>\n    <div v-if=\"hasDetail\" :class=\"cn('ps-[1.35rem] mt-1', !hasLabel && 'ps-0')\">\n      <p\n        v-if=\"hasDescription && !hasError\"\n        :id=\"descriptionId\"\n        class=\"[font-size:var(--input-description-font-size)] leading-tighter text-ink-gray-5\"\n      >\n        <slot name=\"description\">{{ props.description }}</slot>\n      </p>\n      <p\n        v-if=\"hasError\"\n        :id=\"errorId\"\n        role=\"alert\"\n        class=\"[font-size:var(--input-description-font-size)] leading-tighter text-ink-red-7\"\n      >\n        {{ props.error }}\n      </p>\n    </div>\n  </div>\n</template>\n",
      "type": "registry:ui"
    },
    {
      "path": "components/ui/checkbox.css",
      "content": "/* Checkbox component tokens — mirrors frappe-ui v1 toggle geometry. */\n:root {\n  --checkbox-xs-size: 13px;\n  --checkbox-sm-size: 14px;\n  --checkbox-md-size: 16px;\n  --checkbox-radius: var(--radius-1);\n  --checkbox-padded-radius: var(--radius-4);\n  --checkbox-label-gap: 8px;\n\n  --checkbox-xs-height: 24px;\n  --checkbox-sm-height: 28px;\n  --checkbox-md-height: 32px;\n\n  --input-description-font-size: 13px;\n}\n",
      "type": "registry:style"
    }
  ]
}