{
  "name": "textarea",
  "type": "registry:ui",
  "title": "Textarea",
  "description": "espresso-ui Textarea component (Vue)",
  "dependencies": [
    "clsx",
    "tailwind-merge"
  ],
  "registryDependencies": [],
  "files": [
    {
      "path": "components/ui/Textarea.vue",
      "content": "<script setup lang=\"ts\">\nimport { computed, ref, useId } from \"vue\";\nimport { cn } from \"@/lib/utils\";\n\nconst sizeClasses: Record<string, string> = {\n  xs: \"min-h-(--textarea-xs-min-height) rounded-(--input-xs-radius) px-1.5 py-1\",\n  sm: \"min-h-(--textarea-sm-min-height) rounded-(--input-sm-radius) px-2 py-1.5\",\n  md: \"min-h-(--textarea-md-min-height) rounded-(--input-md-radius) px-2.5 py-1.5\",\n  lg: \"min-h-(--textarea-lg-min-height) rounded-(--input-lg-radius) px-3 py-1.5\",\n};\n\nconst variantClasses: Record<string, string> = {\n  subtle:\n    \"border-surface-gray-2 bg-surface-gray-2 hover:border-outline-elevation-2 hover:bg-surface-gray-3 focus:border-outline-gray-4 focus:bg-surface-base focus:shadow-sm\",\n  outline:\n    \"border-outline-gray-2 bg-surface-base hover:border-outline-gray-3 hover:shadow-sm focus:border-outline-gray-4 focus:bg-surface-base focus:shadow-sm\",\n  ghost: \"border-transparent bg-transparent focus:outline-none\",\n};\n\nconst props = withDefaults(\n  defineProps<{\n    modelValue?: string;\n    size?: \"xs\" | \"sm\" | \"md\" | \"lg\";\n    variant?: \"subtle\" | \"outline\" | \"ghost\";\n    label?: string;\n    description?: string;\n    error?: string;\n    required?: boolean;\n    disabled?: boolean;\n    rows?: number;\n    id?: string;\n    class?: string;\n  }>(),\n  {\n    modelValue: \"\",\n    size: \"sm\",\n    variant: \"subtle\",\n    label: \"\",\n    description: \"\",\n    error: \"\",\n    required: false,\n    disabled: false,\n    rows: 3,\n  },\n);\n\nconst emit = defineEmits<{\n  \"update:modelValue\": [value: string];\n}>();\n\nconst fallbackId = useId();\nconst textareaRef = ref<HTMLTextAreaElement | null>(null);\nconst inputId = computed(() => props.id || fallbackId);\nconst descriptionId = computed(() => `${inputId.value}-description`);\nconst errorId = computed(() => `${inputId.value}-error`);\nconst hasError = computed(() => Boolean(props.error));\nconst hasLabeling = computed(() => Boolean(props.label || props.description || props.error));\nconst describedBy = computed(() =>\n  [props.description && !hasError.value ? descriptionId.value : null, hasError.value ? errorId.value : null]\n    .filter(Boolean)\n    .join(\" \") || undefined,\n);\nconst classes = computed(() =>\n  cn(\n    \"block w-full resize-y border [font-size:var(--textarea-font-size)] leading-tighter text-ink-gray-8 transition-colors outline-none placeholder:text-ink-gray-4 disabled:cursor-not-allowed disabled:border-surface-gray-2 disabled:bg-surface-gray-1 disabled:text-ink-gray-5 disabled:placeholder:text-ink-gray-3\",\n    sizeClasses[props.size],\n    variantClasses[props.variant],\n    !hasLabeling.value && props.class,\n  ),\n);\n\nfunction onInput(event: Event): void {\n  emit(\"update:modelValue\", (event.target as HTMLTextAreaElement).value);\n}\n\nfunction focus(options?: FocusOptions): void {\n  textareaRef.value?.focus(options);\n}\n\ndefineExpose({ focus });\n</script>\n\n<template>\n  <div :class=\"cn(hasLabeling && 'flex flex-col gap-1.5', hasLabeling && props.class)\">\n    <label\n      v-if=\"props.label\"\n      :for=\"inputId\"\n      class=\"block [font-size:var(--label-font-size,13px)] [font-weight:var(--label-font-weight,420)] leading-tighter [color:var(--label-color,var(--ink-gray-6))]\"\n    >\n      {{ props.label }}\n      <template v-if=\"props.required\">\n        <span class=\"select-none [color:var(--label-required-color,var(--ink-red-5))]\" aria-hidden=\"true\">*</span>\n        <span class=\"sr-only\">(required)</span>\n      </template>\n    </label>\n    <textarea\n      ref=\"textareaRef\"\n      :id=\"inputId\"\n      :value=\"props.modelValue\"\n      :rows=\"props.rows\"\n      :required=\"props.required\"\n      :disabled=\"props.disabled\"\n      :aria-required=\"props.required || undefined\"\n      :aria-invalid=\"hasError || undefined\"\n      :aria-errormessage=\"hasError ? errorId : undefined\"\n      :aria-describedby=\"describedBy\"\n      data-slot=\"control\"\n      :data-size=\"props.size\"\n      :data-variant=\"props.variant\"\n      :data-state=\"hasError ? 'invalid' : 'valid'\"\n      :data-disabled=\"props.disabled ? 'true' : undefined\"\n      :data-required=\"props.required ? 'true' : undefined\"\n      :class=\"classes\"\n      v-bind=\"$attrs\"\n      @input=\"onInput\"\n    />\n    <p\n      v-if=\"props.description && !hasError\"\n      :id=\"descriptionId\"\n      class=\"[font-size:var(--input-description-font-size)] leading-tighter text-ink-gray-5\"\n    >\n      {{ props.description }}\n    </p>\n    <p\n      v-if=\"hasError\"\n      :id=\"errorId\"\n      role=\"alert\"\n      class=\"[font-size:var(--input-description-font-size)] leading-tighter text-ink-red-7\"\n    >\n      {{ props.error }}\n    </p>\n  </div>\n</template>\n",
      "type": "registry:ui"
    },
    {
      "path": "components/ui/textarea.css",
      "content": "/* Textarea component tokens — mirrors frappe-ui v1 textarea geometry. */\n:root {\n  --input-xs-radius: var(--radius-3);\n  --input-sm-radius: var(--radius-4);\n  --input-md-radius: var(--radius-4);\n  --input-lg-radius: var(--radius-5);\n\n  --textarea-xs-min-height: 32px;\n  --textarea-sm-min-height: 36px;\n  --textarea-md-min-height: 40px;\n  --textarea-lg-min-height: 44px;\n  --textarea-font-size: 13px;\n\n  --input-description-font-size: 13px;\n}\n",
      "type": "registry:style"
    }
  ]
}