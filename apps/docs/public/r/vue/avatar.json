{
  "name": "avatar",
  "type": "registry:ui",
  "title": "Avatar",
  "description": "espresso-ui Avatar component (Vue)",
  "dependencies": [
    "clsx",
    "tailwind-merge",
    "class-variance-authority",
    "@lucide/vue"
  ],
  "registryDependencies": [],
  "files": [
    {
      "path": "components/ui/Avatar.vue",
      "content": "<script setup lang=\"ts\">\nimport { computed, ref, watch } from \"vue\";\nimport { cva, type VariantProps } from \"class-variance-authority\";\nimport { User } from \"@lucide/vue\";\nimport { cn } from \"@/lib/utils\";\n\nconst avatarFaceVariants = cva(\n  \"inline-flex shrink-0 items-center justify-center overflow-hidden font-medium\",\n  {\n    variants: {\n      size: {\n        xs: \"size-(--avatar-xs-size) [font-size:var(--avatar-xs-font-size)]\",\n        sm: \"size-(--avatar-sm-size) [font-size:var(--avatar-sm-font-size)]\",\n        md: \"size-(--avatar-md-size) [font-size:var(--avatar-md-font-size)]\",\n        lg: \"size-(--avatar-lg-size) [font-size:var(--avatar-lg-font-size)]\",\n        xl: \"size-(--avatar-xl-size) [font-size:var(--avatar-xl-font-size)]\",\n        \"2xl\": \"size-(--avatar-2xl-size) [font-size:var(--avatar-2xl-font-size)]\",\n        \"3xl\": \"size-(--avatar-3xl-size) [font-size:var(--avatar-3xl-font-size)]\",\n      },\n      shape: {\n        squircle: \"\",\n        circle: \"rounded-full\",\n      },\n    },\n    compoundVariants: [\n      { shape: \"squircle\", size: \"xs\", class: \"rounded-(--avatar-xs-radius)\" },\n      { shape: \"squircle\", size: \"sm\", class: \"rounded-(--avatar-sm-radius)\" },\n      { shape: \"squircle\", size: \"md\", class: \"rounded-(--avatar-md-radius)\" },\n      { shape: \"squircle\", size: \"lg\", class: \"rounded-(--avatar-lg-radius)\" },\n      { shape: \"squircle\", size: \"xl\", class: \"rounded-(--avatar-xl-radius)\" },\n      { shape: \"squircle\", size: \"2xl\", class: \"rounded-(--avatar-2xl-radius)\" },\n      { shape: \"squircle\", size: \"3xl\", class: \"rounded-(--avatar-3xl-radius)\" },\n    ],\n    defaultVariants: {\n      size: \"md\",\n      shape: \"circle\",\n    },\n  },\n);\n\nconst avatarThemeClasses = {\n  gray: \"bg-surface-gray-2 text-ink-gray-5\",\n  blue: \"bg-surface-blue-2 text-ink-blue-7\",\n  green: \"bg-surface-green-2 text-ink-green-7\",\n  amber: \"bg-surface-amber-2 text-ink-amber-7\",\n  red: \"bg-surface-red-2 text-ink-red-7\",\n  violet: \"bg-surface-violet-2 text-ink-violet-7\",\n};\n\nconst fallbackIconSizeClasses: Record<NonNullable<VariantProps<typeof avatarFaceVariants>[\"size\"]>, string> = {\n  xs: \"[width:var(--avatar-xs-icon-size)] [height:var(--avatar-xs-icon-size)]\",\n  sm: \"[width:var(--avatar-sm-icon-size)] [height:var(--avatar-sm-icon-size)]\",\n  md: \"[width:var(--avatar-md-icon-size)] [height:var(--avatar-md-icon-size)]\",\n  lg: \"[width:var(--avatar-lg-icon-size)] [height:var(--avatar-lg-icon-size)]\",\n  xl: \"[width:var(--avatar-xl-icon-size)] [height:var(--avatar-xl-icon-size)]\",\n  \"2xl\": \"[width:var(--avatar-2xl-icon-size)] [height:var(--avatar-2xl-icon-size)]\",\n  \"3xl\": \"[width:var(--avatar-3xl-icon-size)] [height:var(--avatar-3xl-icon-size)]\",\n};\n\nconst indicatorShellClasses: Record<NonNullable<VariantProps<typeof avatarFaceVariants>[\"size\"]>, string> = {\n  xs: \"-mr-[.1rem] -mb-[.1rem] size-2\",\n  sm: \"-mr-[.1rem] -mb-[.1rem] size-[9px]\",\n  md: \"-mr-[.1rem] -mb-[.1rem] size-2.5\",\n  lg: \"-mr-[.1rem] -mb-[.1rem] size-3\",\n  xl: \"-mr-[.1rem] -mb-[.1rem] size-3\",\n  \"2xl\": \"-mr-[.1rem] -mb-[.1rem] size-3.5\",\n  \"3xl\": \"-mr-[.2rem] -mb-[.2rem] size-4\",\n};\n\ntype AvatarSize = NonNullable<VariantProps<typeof avatarFaceVariants>[\"size\"]>;\ntype AvatarShape = NonNullable<VariantProps<typeof avatarFaceVariants>[\"shape\"]> | \"square\";\ntype AvatarTheme = keyof typeof avatarThemeClasses;\n\nconst props = withDefaults(\n  defineProps<{\n    /** Image URL used for the avatar. */\n    image?: string;\n    /** Full name used for the fallback initial and the accessible label. */\n    label?: string;\n    /** Visual colour theme used for the fallback. */\n    theme?: AvatarTheme;\n    /** @deprecated Use `image`. */\n    src?: string;\n    /** @deprecated Use `label`. */\n    alt?: string;\n    /** @deprecated Use `label`. */\n    fallback?: string;\n    size?: AvatarSize;\n    shape?: AvatarShape;\n    /** Optional classes applied to the indicator shell. */\n    statusClass?: string;\n    class?: string;\n  }>(),\n  {\n    image: \"\",\n    label: \"\",\n    theme: \"gray\",\n    src: \"\",\n    alt: \"\",\n    fallback: \"\",\n    size: \"md\",\n    shape: \"circle\",\n    statusClass: \"\",\n  },\n);\n\nconst imageError = ref(false);\nconst imageSrc = computed(() => props.image || props.src);\nconst displayLabel = computed(() => props.label || props.fallback || props.alt);\nconst accessibleLabel = computed(() => displayLabel.value || \"User avatar\");\nconst initial = computed(() => displayLabel.value.trim().slice(0, 1).toUpperCase());\nconst showImage = computed(() => Boolean(imageSrc.value) && !imageError.value);\nconst shapeVariant = computed(() => (props.shape === \"square\" ? \"squircle\" : props.shape));\n\nconst rootClasses = computed(() => cn(\"relative inline-flex shrink-0 select-none\", props.class));\nconst faceClasses = computed(() =>\n  cn(\n    avatarFaceVariants({ size: props.size, shape: shapeVariant.value }),\n    !showImage.value && avatarThemeClasses[props.theme],\n  ),\n);\nconst indicatorClasses = computed(() =>\n  cn(\n    \"absolute bottom-0 right-0 grid place-items-center rounded-full bg-(--avatar-status-bg) [box-shadow:0_0_0_var(--avatar-status-ring-width)_var(--avatar-status-ring)]\",\n    indicatorShellClasses[props.size],\n    props.statusClass,\n  ),\n);\n\nwatch(imageSrc, () => {\n  imageError.value = false;\n});\n</script>\n\n<template>\n  <span\n    role=\"img\"\n    :aria-label=\"accessibleLabel\"\n    :data-size=\"props.size\"\n    :data-shape=\"props.shape\"\n    :data-theme=\"props.theme\"\n    :class=\"rootClasses\"\n    v-bind=\"$attrs\"\n  >\n    <span :class=\"faceClasses\">\n      <img\n        v-if=\"showImage\"\n        :src=\"imageSrc\"\n        alt=\"\"\n        class=\"size-full object-cover\"\n        @error=\"imageError = true\"\n      />\n      <span\n        v-else-if=\"$slots.default\"\n        :class=\"cn('inline-flex items-center justify-center', fallbackIconSizeClasses[props.size])\"\n      >\n        <slot />\n      </span>\n      <span v-else-if=\"initial\" aria-hidden=\"true\">{{ initial }}</span>\n      <User\n        v-else\n        :class=\"cn(fallbackIconSizeClasses[props.size], 'text-current')\"\n        aria-hidden=\"true\"\n      />\n    </span>\n    <span v-if=\"$slots.indicator || $slots.status\" aria-hidden=\"true\" :class=\"indicatorClasses\">\n      <span class=\"grid size-full place-items-center\">\n        <slot name=\"indicator\">\n          <slot name=\"status\" />\n        </slot>\n      </span>\n    </span>\n  </span>\n</template>\n",
      "type": "registry:ui"
    },
    {
      "path": "components/ui/avatar.css",
      "content": "/* Avatar component tokens — override these to customise avatars. */\n:root {\n  /* Per-size dimensions */\n  --avatar-xs-size: 16px;\n  --avatar-sm-size: 20px;\n  --avatar-md-size: 24px;\n  --avatar-lg-size: 28px;\n  --avatar-xl-size: 32px;\n  --avatar-2xl-size: 40px;\n  --avatar-3xl-size: 46px;\n\n  /* Per-size square radii (frappe-ui v1) */\n  --avatar-xs-radius: 4px;\n  --avatar-sm-radius: 5px;\n  --avatar-md-radius: 5px;\n  --avatar-lg-radius: 6px;\n  --avatar-xl-radius: 6px;\n  --avatar-2xl-radius: 8px;\n  --avatar-3xl-radius: 10px;\n\n  /* Per-size initials font sizes */\n  --avatar-xs-font-size: 11px;\n  --avatar-sm-font-size: 13px;\n  --avatar-md-font-size: 14px;\n  --avatar-lg-font-size: 14px;\n  --avatar-xl-font-size: 16px;\n  --avatar-2xl-font-size: 18px;\n  --avatar-3xl-font-size: 20px;\n\n  /* Per-size fallback icon sizes */\n  --avatar-xs-icon-size: 10px;\n  --avatar-sm-icon-size: 12px;\n  --avatar-md-icon-size: 14px;\n  --avatar-lg-icon-size: 16px;\n  --avatar-xl-icon-size: 18px;\n  --avatar-2xl-icon-size: 22px;\n  --avatar-3xl-icon-size: 24px;\n\n  /* Surfaces */\n  --avatar-bg: var(--surface-gray-2);\n  --avatar-fg: var(--ink-gray-5);\n\n  /* Indicator shell — slot content fills the shell */\n  --avatar-status-icon-size: 6px;\n  --avatar-status-bg: var(--surface-base);\n  --avatar-status-ring: var(--surface-base);\n  --avatar-status-ring-width: 2px;\n}\n",
      "type": "registry:style"
    }
  ]
}