{
  "name": "switch",
  "type": "registry:ui",
  "title": "Switch",
  "description": "espresso-ui Switch component (Vue)",
  "dependencies": [
    "clsx",
    "tailwind-merge"
  ],
  "registryDependencies": [],
  "files": [
    {
      "path": "components/ui/Switch.vue",
      "content": "<script setup lang=\"ts\">\nimport { computed, ref, useAttrs, useId, useSlots } from \"vue\";\nimport { cn } from \"@/lib/utils\";\n\ndefineOptions({ inheritAttrs: false });\n\nconst trackSizeClasses: Record<string, string> = {\n  xs: \"h-(--switch-xs-height) w-(--switch-xs-width) border-2\",\n  sm: \"h-(--switch-sm-height) w-(--switch-sm-width) border-2\",\n  md: \"h-(--switch-md-height) w-(--switch-md-width) border-[3px]\",\n};\n\nconst thumbSizeClasses: Record<string, string> = {\n  xs: \"size-(--switch-xs-thumb-size)\",\n  sm: \"size-(--switch-sm-thumb-size)\",\n  md: \"size-(--switch-md-thumb-size)\",\n};\n\nconst thumbTravelClasses: Record<string, string> = {\n  xs: \"translate-x-(--switch-xs-travel)\",\n  sm: \"translate-x-(--switch-sm-travel)\",\n  md: \"translate-x-(--switch-md-travel)\",\n};\n\nconst paddedSizeClasses: Record<string, string> = {\n  xs: \"h-(--switch-xs-height) px-1.5\",\n  sm: \"h-(--switch-sm-height) px-1.5\",\n  md: \"h-(--switch-md-height) px-3\",\n};\n\nconst gapClasses: Record<string, string> = {\n  xs: \"gap-x-2.5\",\n  sm: \"gap-x-2.5\",\n  md: \"gap-x-3.5\",\n};\n\nconst errorIndentClasses: Record<string, string> = {\n  xs: \"ps-8\",\n  sm: \"ps-9\",\n  md: \"ps-[42px]\",\n};\n\nconst props = withDefaults(\n  defineProps<{\n    size?: \"xs\" | \"sm\" | \"md\";\n    label?: string;\n    description?: string;\n    error?: string;\n    required?: boolean;\n    disabled?: boolean;\n    padded?: boolean;\n    controlPosition?: \"start\" | \"end\";\n    id?: string;\n    class?: string;\n  }>(),\n  {\n    size: \"sm\",\n    label: \"\",\n    description: \"\",\n    error: \"\",\n    required: false,\n    disabled: false,\n    padded: false,\n    controlPosition: \"end\",\n  },\n);\n\nconst model = defineModel<boolean>({ default: false });\nconst attrs = useAttrs();\nconst slots = useSlots();\nconst fallbackId = useId();\nconst switchRef = ref<HTMLButtonElement | null>(null);\nconst inputId = computed(() => props.id || fallbackId);\nconst descriptionId = computed(() => `${inputId.value}-description`);\nconst errorId = computed(() => `${inputId.value}-error`);\nconst hasError = computed(() => Boolean(props.error));\nconst hasLabel = computed(() => Boolean(props.label || slots.label));\nconst hasDescription = computed(() => Boolean(props.description || slots.description));\nconst hasDetail = computed(() => Boolean(hasDescription.value || props.error));\nconst checked = computed(() => Boolean(model.value));\nconst describedBy = computed(\n  () =>\n    [props.description && !hasError.value ? descriptionId.value : null, hasError.value ? errorId.value : null]\n      .filter(Boolean)\n      .join(\" \") || undefined,\n);\n\nconst controlAttrs = computed(() =>\n  Object.fromEntries(Object.entries(attrs).filter(([key]) => key !== \"class\" && key !== \"style\")),\n);\n\nconst rootClasses = computed(() =>\n  cn(\n    \"flex flex-col\",\n    props.padded && \"group rounded-(--switch-padded-radius) transition-colors\",\n    props.padded &&\n      !props.disabled &&\n      \"cursor-pointer hover:bg-surface-gray-3 active:bg-surface-gray-4 [&:has(:focus-visible)]:[outline:var(--focus-outline-default)]\",\n    props.padded && props.disabled && \"cursor-not-allowed opacity-70\",\n    props.padded &&\n      (hasDetail.value\n        ? props.size === \"md\"\n          ? \"px-3 py-2\"\n          : props.size === \"sm\"\n            ? \"px-2 py-1.5\"\n            : \"px-1.5 py-1.5\"\n        : paddedSizeClasses[props.size]),\n    props.padded && (props.controlPosition === \"start\" ? \"w-fit\" : \"w-full\"),\n    props.class,\n  ),\n);\n\nconst switchClasses = computed(() =>\n  cn(\n    \"relative inline-flex shrink-0 cursor-pointer items-center rounded-full border-transparent transition-colors duration-100 ease-in-out focus-visible:[outline:var(--focus-outline-default)]\",\n    trackSizeClasses[props.size],\n    props.disabled\n      ? \"cursor-not-allowed bg-surface-gray-3\"\n      : checked.value\n        ? \"bg-surface-gray-10 enabled:hover:bg-surface-gray-9 active:bg-surface-gray-8\"\n        : \"bg-surface-gray-4 enabled:hover:bg-surface-gray-5 active:bg-surface-gray-6\",\n  ),\n);\n\nconst thumbClasses = computed(() =>\n  cn(\n    \"pointer-events-none inline-block transform rounded-full bg-surface-base shadow ring-0 transition duration-100 ease-in-out\",\n    thumbSizeClasses[props.size],\n    checked.value ? thumbTravelClasses[props.size] : \"translate-x-0\",\n  ),\n);\n\nconst labelClasses = computed(() =>\n  cn(\n    \"select-none leading-tight [font-size:var(--label-font-size,13px)] [font-weight:var(--label-font-weight,420)] [color:var(--label-color,var(--ink-gray-6))]\",\n    props.disabled\n      ? \"cursor-not-allowed [color:var(--label-disabled-color,var(--ink-gray-4))]\"\n      : \"cursor-pointer\",\n  ),\n);\n\nfunction toggle(): void {\n  if (props.disabled) return;\n  model.value = !checked.value;\n}\n\nfunction onContainerClick(event: MouseEvent): void {\n  if (!props.padded || props.disabled) return;\n  const target = event.target as HTMLElement;\n  if (target.closest('button[role=\"switch\"]') || target.closest(\"label\")) return;\n  toggle();\n}\n\nfunction focus(options?: FocusOptions): void {\n  switchRef.value?.focus(options);\n}\n\ndefineExpose({ focus });\n</script>\n\n<template>\n  <div :class=\"rootClasses\" :style=\"$attrs.style as any\" @click=\"onContainerClick\">\n    <div\n      :class=\"\n        cn(\n          'flex items-center',\n          props.controlPosition === 'start' ? 'flex-row-reverse justify-end' : 'justify-between',\n          gapClasses[props.size],\n          !props.padded && 'py-1.5',\n        )\n      \"\n    >\n      <div class=\"flex min-w-0 flex-col gap-1\">\n        <div class=\"flex items-center\">\n          <span\n            v-if=\"$slots.icon\"\n            class=\"me-2 inline-flex size-4 shrink-0 items-center justify-center text-ink-gray-6\"\n            aria-hidden=\"true\"\n          >\n            <slot name=\"icon\" />\n          </span>\n          <label v-if=\"hasLabel\" :for=\"inputId\" :class=\"labelClasses\">\n            <slot v-if=\"$slots.label\" name=\"label\" :required=\"props.required\" />\n            <template v-else>\n              {{ props.label }}\n              <template v-if=\"props.required\">\n                <span\n                  class=\"select-none [color:var(--label-required-color,var(--ink-red-5))]\"\n                  aria-hidden=\"true\"\n                  >*</span\n                >\n                <span class=\"sr-only\">(required)</span>\n              </template>\n            </template>\n          </label>\n        </div>\n      </div>\n      <button\n        ref=\"switchRef\"\n        :id=\"inputId\"\n        type=\"button\"\n        role=\"switch\"\n        :aria-checked=\"checked\"\n        :aria-required=\"props.required || undefined\"\n        :aria-invalid=\"hasError || undefined\"\n        :aria-errormessage=\"hasError ? errorId : undefined\"\n        :aria-describedby=\"describedBy\"\n        :disabled=\"props.disabled\"\n        data-slot=\"control\"\n        :data-size=\"props.size\"\n        :data-state=\"checked ? 'checked' : 'unchecked'\"\n        :data-disabled=\"props.disabled ? 'true' : undefined\"\n        :data-required=\"props.required ? 'true' : undefined\"\n        :class=\"switchClasses\"\n        v-bind=\"controlAttrs\"\n        @click=\"toggle\"\n      >\n        <span aria-hidden=\"true\" :class=\"thumbClasses\" />\n      </button>\n    </div>\n    <div\n      v-if=\"hasDetail\"\n      :class=\"\n        cn(\n          'mt-1',\n          props.controlPosition === 'start' ? errorIndentClasses[props.size] : undefined,\n          !hasLabel && 'ps-0',\n        )\n      \"\n    >\n      <p\n        v-if=\"hasDescription && !hasError\"\n        :id=\"descriptionId\"\n        class=\"[font-size:var(--input-description-font-size)] leading-tighter text-ink-gray-5\"\n      >\n        <slot name=\"description\">{{ props.description }}</slot>\n      </p>\n      <p\n        v-if=\"hasError\"\n        :id=\"errorId\"\n        role=\"alert\"\n        class=\"[font-size:var(--input-description-font-size)] leading-tighter text-ink-red-7\"\n      >\n        {{ props.error }}\n      </p>\n    </div>\n  </div>\n</template>\n",
      "type": "registry:ui"
    },
    {
      "path": "components/ui/switch.css",
      "content": "/* Switch component tokens — mirrors frappe-ui v1 toggle geometry. */\n:root {\n  --switch-radius: var(--radius-full);\n  --switch-padded-radius: var(--radius-4);\n\n  --switch-xs-height: 14px;\n  --switch-xs-width: 24px;\n  --switch-xs-thumb-size: 10px;\n  --switch-xs-travel: 10px;\n\n  --switch-sm-height: 16px;\n  --switch-sm-width: 26px;\n  --switch-sm-thumb-size: 12px;\n  --switch-sm-travel: 10px;\n\n  --switch-md-height: 20px;\n  --switch-md-width: 32px;\n  --switch-md-thumb-size: 14px;\n  --switch-md-travel: 12px;\n\n  --input-description-font-size: 13px;\n}\n",
      "type": "registry:style"
    }
  ]
}