  "registryDependencies": [],
  "files": [
    {
      "path": "components/ui/ErrorMessage.vue",
      "content": "<script setup lang=\"ts\">\nimport { computed } from \"vue\";\n\ntype ErrorMessageValue =\n  | string\n  | string[]\n  | (Error & { messages?: string | string[] });\n\nconst props = defineProps<{\n  message?: ErrorMessageValue | null;\n}>();\n\nfunction errorLines(value?: ErrorMessageValue | null): string[] {\n  if (!value) return [];\n  if (typeof value === \"string\") return [value];\n  if (Array.isArray(value)) return value.filter(Boolean).map(String);\n  if (value instanceof Error) {\n    const messages = value.messages;\n    if (Array.isArray(messages) && messages.length) return messages.filter(Boolean).map(String);\n    if (typeof messages === \"string\" && messages) return [messages];\n    return value.message ? [value.message] : [];\n  }\n  return [String(value)];\n}\n\nconst lines = computed(() => errorLines(props.message));\n</script>\n\n<template>\n  <div\n    v-if=\"lines.length\"\n    role=\"alert\"\n    class=\"whitespace-pre-line text-sm text-ink-red-7\"\n  >\n    <p v-for=\"(line, index) in lines\" :key=\"index\">{{ line }}</p>\n  </div>\n</template>\n",
      "type": "registry:ui"
    },
    {
      "path": "components/ui/error-message.css",
      "content": "/* ErrorMessage uses the shared red ink token. */\n",
      "type": "registry:style"
    }
  ]
