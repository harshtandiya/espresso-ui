{
  "name": "select",
  "type": "registry:ui",
  "title": "Select",
  "description": "espresso-ui Select component (Vue)",
  "dependencies": [
    "clsx",
    "tailwind-merge",
    "@lucide/vue"
  ],
  "registryDependencies": [],
  "files": [
    {
      "path": "components/ui/Select.vue",
      "content": "<script setup lang=\"ts\">\nimport { computed, onBeforeUnmount, onMounted, ref, useAttrs, useId, useSlots } from \"vue\";\nimport { ChevronDown } from \"@lucide/vue\";\nimport { cn } from \"@/lib/utils\";\n\ndefineOptions({ inheritAttrs: false });\n\ntype SelectValue = string | number;\ntype SelectOption =\n  | string\n  | {\n      label: string;\n      value: SelectValue;\n      disabled?: boolean;\n    };\n\nconst sizeClasses: Record<string, string> = {\n  xs: \"h-(--input-xs-height) rounded-(--input-xs-radius) [font-size:var(--input-xs-font-size)]\",\n  sm: \"h-(--input-sm-height) rounded-(--input-sm-radius) [font-size:var(--input-sm-font-size)]\",\n  md: \"h-(--input-md-height) rounded-(--input-md-radius) [font-size:var(--input-md-font-size)]\",\n  lg: \"h-(--input-lg-height) rounded-(--input-lg-radius) [font-size:var(--input-lg-font-size)]\",\n};\n\nconst paddingClasses: Record<string, { plain: string; withPrefix: string }> = {\n  xs: { plain: \"ps-1.5\", withPrefix: \"ps-7\" },\n  sm: { plain: \"ps-2\", withPrefix: \"ps-8\" },\n  md: { plain: \"ps-2.5\", withPrefix: \"ps-9\" },\n  lg: { plain: \"ps-3\", withPrefix: \"ps-10\" },\n};\n\nconst prefixPadding: Record<string, string> = {\n  xs: \"ps-1.5\",\n  sm: \"ps-2\",\n  md: \"ps-2.5\",\n  lg: \"ps-3\",\n};\n\nconst suffixPadding: Record<string, string> = {\n  xs: \"pe-1.5\",\n  sm: \"pe-2\",\n  md: \"pe-2.5\",\n  lg: \"pe-3\",\n};\n\nconst variantClasses: Record<string, string> = {\n  subtle:\n    \"border-surface-gray-2 bg-surface-gray-2 hover:border-outline-elevation-2 hover:bg-surface-gray-3 focus:border-outline-gray-4 focus:bg-surface-base focus:shadow-sm\",\n  outline:\n    \"border-outline-gray-2 bg-surface-base hover:border-outline-gray-3 hover:shadow-sm focus:border-outline-gray-4 focus:bg-surface-base focus:shadow-sm\",\n  ghost:\n    \"border-transparent bg-transparent focus-visible:ring-2 focus-visible:ring-ink-gray-8 focus-visible:ring-offset-2 focus-visible:ring-offset-surface-base\",\n};\n\nconst chevronSizeClasses: Record<string, string> = {\n  xs: \"size-3\",\n  sm: \"size-3.5\",\n  md: \"size-4\",\n  lg: \"size-4\",\n};\n\nconst props = withDefaults(\n  defineProps<{\n    modelValue?: SelectValue | null;\n    options?: SelectOption[];\n    size?: \"xs\" | \"sm\" | \"md\" | \"lg\";\n    variant?: \"subtle\" | \"outline\" | \"ghost\";\n    placeholder?: string;\n    emptyText?: string;\n    label?: string;\n    description?: string;\n    error?: string;\n    required?: boolean;\n    disabled?: boolean;\n    id?: string;\n    class?: string;\n  }>(),\n  {\n    options: () => [],\n    size: \"sm\",\n    variant: \"subtle\",\n    placeholder: \"Select option\",\n    emptyText: \"No options\",\n    label: \"\",\n    description: \"\",\n    error: \"\",\n    required: false,\n    disabled: false,\n  },\n);\n\nconst model = defineModel<SelectValue | null>();\nconst attrs = useAttrs();\nconst slots = useSlots();\nconst fallbackId = useId();\nconst selectRef = ref<HTMLSelectElement | null>(null);\nconst selectId = computed(() => props.id || fallbackId);\nconst descriptionId = computed(() => `${selectId.value}-description`);\nconst errorId = computed(() => `${selectId.value}-error`);\nconst hasError = computed(() => Boolean(props.error));\nconst hasLabel = computed(() => Boolean(props.label || slots.label));\nconst hasDescription = computed(() => Boolean(props.description || slots.description));\nconst hasLabeling = computed(() => Boolean(hasLabel.value || hasDescription.value || hasError.value));\nconst currentValue = computed(() => model.value ?? null);\n\nconst normalizedOptions = computed(() =>\n  props.options\n    .map((option) => (typeof option === \"string\" ? { label: option, value: option } : option))\n    .filter((option) => option.value !== undefined && option.value !== null),\n);\n\nconst selectedIndex = computed(() =>\n  normalizedOptions.value.findIndex((option) => option.value === currentValue.value),\n);\nconst encodedValue = computed(() =>\n  selectedIndex.value >= 0 ? String(selectedIndex.value) : \"\",\n);\nconst hasValue = computed(() => selectedIndex.value >= 0);\nconst describedBy = computed(\n  () =>\n    [\n      props.description && !hasError.value ? descriptionId.value : null,\n      hasError.value ? errorId.value : null,\n      attrs[\"aria-describedby\"] as string | undefined,\n    ]\n      .filter(Boolean)\n      .join(\" \") || undefined,\n);\nconst paddingClass = computed(() =>\n  slots.prefix ? paddingClasses[props.size].withPrefix : paddingClasses[props.size].plain,\n);\n\nconst controlAttrs = computed(() =>\n  Object.fromEntries(\n    Object.entries(attrs).filter(\n      ([key]) => key !== \"class\" && key !== \"style\" && key !== \"aria-describedby\",\n    ),\n  ),\n);\n\nconst suffixRef = ref<HTMLElement | null>(null);\nconst suffixWidth = ref(0);\nlet suffixObserver: ResizeObserver | undefined;\n\nonMounted(() => {\n  const element = suffixRef.value;\n  if (!element) return;\n  const measure = () => {\n    suffixWidth.value = element.offsetWidth;\n  };\n  measure();\n  suffixObserver = new ResizeObserver(measure);\n  suffixObserver.observe(element);\n});\n\nonBeforeUnmount(() => {\n  suffixObserver?.disconnect();\n});\n\nconst selectClasses = computed(() =>\n  cn(\n    \"w-full cursor-pointer appearance-none border leading-tighter transition-colors outline-none data-[state=invalid]:border-outline-red-6 data-[state=invalid]:focus:border-outline-red-7 disabled:cursor-not-allowed disabled:border-surface-gray-2 disabled:bg-surface-gray-1 disabled:text-ink-gray-5\",\n    sizeClasses[props.size],\n    paddingClass.value,\n    variantClasses[props.variant],\n    hasValue.value ? \"text-ink-gray-8\" : \"text-ink-gray-6\",\n  ),\n);\n\nfunction onChange(event: Event): void {\n  const target = event.target as HTMLSelectElement;\n  const index = Number(target.value);\n  const next =\n    target.value === \"\" || Number.isNaN(index)\n      ? null\n      : (normalizedOptions.value[index]?.value ?? null);\n  model.value = next;\n}\n\nfunction focus(options?: FocusOptions): void {\n  selectRef.value?.focus(options);\n}\n\ndefineExpose({ focus });\n</script>\n\n<template>\n  <div :class=\"cn(hasLabeling && 'flex flex-col gap-1.5', hasLabeling && props.class)\">\n    <label\n      v-if=\"hasLabel\"\n      :for=\"selectId\"\n      class=\"block [font-size:var(--label-font-size,13px)] [font-weight:var(--label-font-weight,420)] leading-tighter [color:var(--label-color,var(--ink-gray-6))]\"\n    >\n      <slot v-if=\"$slots.label\" name=\"label\" :required=\"props.required\" />\n      <template v-else>\n        {{ props.label }}\n        <template v-if=\"props.required\">\n          <span class=\"ms-0.5 select-none [color:var(--label-required-color,var(--ink-red-5))]\" aria-hidden=\"true\">*</span>\n          <span class=\"sr-only\">(required)</span>\n        </template>\n      </template>\n    </label>\n    <div :class=\"cn('relative flex items-center', !hasLabeling && props.class)\">\n      <span\n        v-if=\"$slots.prefix\"\n        :class=\"\n          cn(\n            'pointer-events-none absolute inset-y-0 start-0 flex items-center',\n            prefixPadding[props.size],\n            props.disabled ? 'text-ink-gray-5' : 'text-ink-gray-8',\n          )\n        \"\n      >\n        <slot name=\"prefix\" />\n      </span>\n      <select\n        ref=\"selectRef\"\n        :id=\"selectId\"\n        :value=\"encodedValue\"\n        :required=\"props.required\"\n        :disabled=\"props.disabled\"\n        :aria-required=\"props.required || undefined\"\n        :aria-invalid=\"hasError || undefined\"\n        :aria-errormessage=\"hasError ? errorId : undefined\"\n        :aria-describedby=\"describedBy\"\n        data-slot=\"control\"\n        :data-size=\"props.size\"\n        :data-variant=\"props.variant\"\n        :data-state=\"hasError ? 'invalid' : 'valid'\"\n        :data-placeholder=\"!hasValue ? '' : undefined\"\n        :data-disabled=\"props.disabled ? 'true' : undefined\"\n        :data-required=\"props.required ? 'true' : undefined\"\n        :style=\"{ paddingInlineEnd: suffixWidth ? suffixWidth + 8 : undefined }\"\n        :class=\"selectClasses\"\n        v-bind=\"controlAttrs\"\n        @change=\"onChange\"\n      >\n        <option value=\"\" :disabled=\"props.required\">\n          {{ normalizedOptions.length === 0 ? props.emptyText : props.placeholder }}\n        </option>\n        <option\n          v-for=\"(option, index) in normalizedOptions\"\n          :key=\"`${option.value}-${index}`\"\n          :value=\"String(index)\"\n          :disabled=\"option.disabled\"\n        >\n          {{ option.label }}\n        </option>\n      </select>\n      <span\n        ref=\"suffixRef\"\n        :class=\"\n          cn(\n            'pointer-events-none absolute inset-y-0 end-0 flex items-center',\n            suffixPadding[props.size],\n            props.disabled ? 'text-ink-gray-5' : 'text-ink-gray-7',\n          )\n        \"\n      >\n        <slot name=\"suffix\">\n          <ChevronDown aria-hidden=\"true\" :class=\"chevronSizeClasses[props.size]\" />\n        </slot>\n      </span>\n    </div>\n    <p\n      v-if=\"hasDescription && !hasError\"\n      :id=\"descriptionId\"\n      class=\"[font-size:var(--input-description-font-size)] leading-tighter text-ink-gray-5\"\n    >\n      <slot name=\"description\">{{ props.description }}</slot>\n    </p>\n    <p\n      v-if=\"hasError\"\n      :id=\"errorId\"\n      role=\"alert\"\n      class=\"[font-size:var(--input-description-font-size)] leading-tighter text-ink-red-7\"\n    >\n      {{ props.error }}\n    </p>\n  </div>\n</template>\n",
      "type": "registry:ui"
    },
    {
      "path": "components/ui/select.css",
      "content": "/* TextInput component tokens — mirrors frappe-ui v1 control geometry. */\n:root {\n  /* Size: xs (24px) */\n  --input-xs-height: 24px;\n  --input-xs-radius: var(--radius-3);\n  --input-xs-font-size: 12px;\n\n  /* Size: sm (28px) */\n  --input-sm-height: 28px;\n  --input-sm-radius: var(--radius-4);\n  --input-sm-font-size: 14px;\n\n  /* Size: md (32px) */\n  --input-md-height: 32px;\n  --input-md-radius: var(--radius-4);\n  --input-md-font-size: 14px;\n\n  /* Size: lg (40px) */\n  --input-lg-height: 40px;\n  --input-lg-radius: var(--radius-5);\n  --input-lg-font-size: 16px;\n\n  --input-description-font-size: 13px;\n}\n",
      "type": "registry:style"
    }
  ]
}