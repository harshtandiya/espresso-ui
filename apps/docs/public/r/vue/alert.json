      "path": "components/ui/Alert.vue",
      "content": "<script setup lang=\"ts\">\nimport { computed, reactive, type Component } from \"vue\";\nimport Button from \"./Button.vue\";\n\ntype StatusTheme = \"gray\" | \"blue\" | \"green\" | \"amber\" | \"red\";\n\ntype AlertActionContext = {\n  dismiss: () => void;\n};\n\ntype AlertAction = {\n  label: string;\n  onClick?: (context: AlertActionContext) => void | Promise<void>;\n  theme?: \"gray\" | \"blue\" | \"green\" | \"red\";\n  variant?: \"solid\" | \"subtle\" | \"outline\" | \"ghost\" | \"link\";\n  size?: \"xs\" | \"sm\" | \"md\" | \"lg\";\n  disabled?: boolean;\n  loading?: boolean;\n  icon?: string | Component;\n  iconLeft?: string | Component;\n  iconRight?: string | Component;\n};\n\nconst props = withDefaults(\n  defineProps<{\n    title?: string;\n    description?: string;\n    theme?: StatusTheme;\n    icon?: boolean | string | Component;\n    primaryAction?: AlertAction;\n    secondaryAction?: AlertAction;\n    dismissible?: boolean;\n  }>(),\n  {\n    theme: \"gray\",\n    dismissible: false,\n  },\n);\n\nconst emit = defineEmits<{\n  dismiss: [];\n}>();\n\nconst slots = defineSlots<{\n  prefix?: () => unknown;\n  title?: () => unknown;\n  description?: () => unknown;\n  actions?: (props: { dismiss: () => void }) => unknown;\n}>();\n\nconst layout = computed(() =>\n  props.description || slots.description || props.secondaryAction ? \"banner\" : \"row\",\n);\nconst role = computed(() => (props.theme === \"red\" || props.theme === \"amber\" ? \"alert\" : \"status\"));\n\nconst iconColorClass = computed(\n  () =>\n    ({\n      gray: \"text-ink-gray-7\",\n      blue: \"text-ink-blue-5\",\n      green: \"text-ink-green-5\",\n      amber: \"text-ink-amber-5\",\n      red: \"text-ink-red-5\",\n    })[props.theme],\n);\n\nconst isAutoIcon = computed(() => props.icon === true || props.icon === undefined);\nconst isLucideIcon = computed(\n  () => typeof props.icon === \"string\" && props.icon.startsWith(\"lucide-\"),\n);\nconst customComponent = computed(() =>\n  props.icon && typeof props.icon !== \"boolean\" && typeof props.icon !== \"string\" ? props.icon : null,\n);\nconst customText = computed(() =>\n  typeof props.icon === \"string\" && !isLucideIcon.value ? props.icon : null,\n);\n\nconst showPrefix = computed(() => props.icon !== false);\nconst showTitle = computed(() => Boolean(props.title || slots.title));\nconst showDescription = computed(() => Boolean(props.description || slots.description));\nconst showBannerActions = computed(() =>\n  Boolean(slots.actions || props.primaryAction || props.secondaryAction),\n);\n\nconst pending = reactive({ primary: false, secondary: false });\nconst primaryLoading = computed(() => props.primaryAction?.loading ?? pending.primary);\nconst secondaryLoading = computed(() => props.secondaryAction?.loading ?? pending.secondary);\n\nconst rowActionProps = computed(() => {\n  if (!props.primaryAction) return undefined;\n  const { onClick, ...rest } = props.primaryAction;\n  return { variant: \"ghost\" as const, size: \"sm\" as const, theme: \"gray\" as const, ...rest };\n});\n\nconst rowActionLabelClass = computed(() => {\n  const action = props.primaryAction;\n  if (!action || action.variant || action.theme) return undefined;\n  return {\n    gray: \"text-ink-gray-7\",\n    blue: \"text-ink-blue-6\",\n    green: \"text-ink-green-6\",\n    amber: \"text-ink-amber-6\",\n    red: \"text-ink-red-6\",\n  }[props.theme];\n});\n\nconst bannerPrimaryProps = computed(() => {\n  if (!props.primaryAction) return undefined;\n  const { onClick, ...rest } = props.primaryAction;\n  return { variant: \"outline\" as const, theme: \"gray\" as const, size: \"md\" as const, ...rest };\n});\n\nconst bannerPrimaryClass = computed(() =>\n  props.primaryAction && !props.primaryAction.variant\n    ? \"border-transparent! shadow-sm\"\n    : undefined,\n);\n\nconst bannerSecondaryProps = computed(() => {\n  if (!props.secondaryAction) return undefined;\n  const { onClick, ...rest } = props.secondaryAction;\n  return { variant: \"ghost\" as const, theme: \"gray\" as const, size: \"md\" as const, ...rest };\n});\n\nconst bannerSecondaryClass = computed(() =>\n  props.secondaryAction && !props.secondaryAction.variant && !props.secondaryAction.theme\n    ? \"text-ink-gray-7\"\n    : undefined,\n);\n\nfunction dismiss() {\n  emit(\"dismiss\");\n}\n\nasync function handleAction(slot: \"primary\" | \"secondary\", action?: AlertAction) {\n  if (!action?.onClick || pending[slot]) return;\n  pending[slot] = true;\n  try {\n    await action.onClick({ dismiss });\n  } finally {\n    pending[slot] = false;\n  }\n}\n</script>\n\n<template>\n  <div\n    v-if=\"layout === 'row'\"\n    :role=\"role\"\n    data-layout=\"row\"\n    :data-color=\"props.theme\"\n    class=\"flex h-10 items-center rounded-(--alert-radius) bg-surface-gray-1 py-1.5 pl-3.5 pr-1.5\"\n  >\n    <div\n      v-if=\"showPrefix\"\n      data-slot=\"prefix\"\n      class=\"mr-2 flex size-4 shrink-0 items-center justify-center\"\n    >\n      <slot name=\"prefix\">\n        <svg\n          v-if=\"isAutoIcon\"\n          viewBox=\"0 0 16 16\"\n          fill=\"none\"\n          aria-hidden=\"true\"\n          class=\"size-4\"\n          :class=\"iconColorClass\"\n        >\n          <template v-if=\"props.theme === 'green'\">\n            <circle cx=\"8\" cy=\"8\" r=\"7\" fill=\"currentColor\" />\n            <path\n              d=\"M4.8 8.2l2.1 2.1 4.3-4.4\"\n              stroke=\"var(--surface-base)\"\n              stroke-width=\"1.5\"\n              stroke-linecap=\"round\"\n              stroke-linejoin=\"round\"\n            />\n          </template>\n          <template v-else-if=\"props.theme === 'amber'\">\n            <path\n              d=\"M7.1 1.7L1.1 12a1.7 1.7 0 001.5 2.5h10.8a1.7 1.7 0 001.5-2.5L8.9 1.7a1.1 1.1 0 00-1.8 0z\"\n              fill=\"currentColor\"\n            />\n            <path\n              d=\"M8 5.2v3.6\"\n              stroke=\"var(--surface-base)\"\n              stroke-width=\"1.5\"\n              stroke-linecap=\"round\"\n            />\n            <circle cx=\"8\" cy=\"11.4\" r=\".9\" fill=\"var(--surface-base)\" />\n          </template>\n          <template v-else-if=\"props.theme === 'red'\">\n            <circle cx=\"8\" cy=\"8\" r=\"7\" fill=\"currentColor\" />\n            <path\n              d=\"M5.5 5.5l5 5m0-5l-5 5\"\n              stroke=\"var(--surface-base)\"\n              stroke-width=\"1.5\"\n              stroke-linecap=\"round\"\n            />\n          </template>\n          <template v-else>\n            <circle cx=\"8\" cy=\"8\" r=\"7\" fill=\"currentColor\" />\n            <path\n              d=\"M8 7.2v4\"\n              stroke=\"var(--surface-base)\"\n              stroke-width=\"1.5\"\n              stroke-linecap=\"round\"\n            />\n            <circle cx=\"8\" cy=\"4.7\" r=\".9\" fill=\"var(--surface-base)\" />\n          </template>\n        </svg>\n        <span\n          v-else-if=\"isLucideIcon\"\n          class=\"size-4\"\n          :class=\"[props.icon, iconColorClass]\"\n          aria-hidden=\"true\"\n        />\n        <component\n          v-else-if=\"customComponent\"\n          :is=\"customComponent\"\n          class=\"size-4\"\n          :class=\"iconColorClass\"\n        />\n        <span v-else-if=\"customText\">{{ customText }}</span>\n      </slot>\n    </div>\n\n    <div\n      v-if=\"showTitle\"\n      data-slot=\"title\"\n      class=\"min-w-0 flex-1 truncate text-sm font-medium text-ink-gray-8\"\n    >\n      <slot name=\"title\">{{ props.title }}</slot>\n    </div>\n\n    <div\n      v-if=\"slots.actions || props.primaryAction\"\n      data-slot=\"actions\"\n      class=\"ml-1.5 flex shrink-0 items-center gap-1\"\n    >\n      <slot name=\"actions\" :dismiss=\"dismiss\">\n        <Button\n          v-if=\"props.primaryAction\"\n          v-bind=\"rowActionProps\"\n          :loading=\"primaryLoading\"\n          :class=\"rowActionLabelClass\"\n          @click=\"handleAction('primary', props.primaryAction)\"\n        />\n      </slot>\n    </div>\n\n    <Button\n      v-if=\"props.dismissible\"\n      data-slot=\"dismiss\"\n      class=\"ml-1.5 shrink-0\"\n      variant=\"ghost\"\n      theme=\"gray\"\n      size=\"sm\"\n      aria-label=\"Dismiss\"\n      @click=\"dismiss\"\n    >\n      <svg viewBox=\"0 0 16 16\" fill=\"none\" aria-hidden=\"true\" class=\"size-4\">\n        <path\n          d=\"M4 4l8 8m0-8l-8 8\"\n          stroke=\"currentColor\"\n          stroke-width=\"1.5\"\n          stroke-linecap=\"round\"\n        />\n      </svg>\n    </Button>\n  </div>\n\n  <div\n    v-else\n    :role=\"role\"\n    data-layout=\"banner\"\n    :data-color=\"props.theme\"\n    class=\"relative rounded-(--alert-radius) bg-surface-gray-1 p-3\"\n  >\n    <div class=\"flex items-center gap-1.5\" :class=\"props.dismissible ? 'pr-8' : ''\">\n      <div\n        v-if=\"showPrefix\"\n        data-slot=\"prefix\"\n        class=\"flex size-4 shrink-0 items-center justify-center\"\n      >\n        <slot name=\"prefix\">\n          <svg\n            v-if=\"isAutoIcon\"\n            viewBox=\"0 0 16 16\"\n            fill=\"none\"\n            aria-hidden=\"true\"\n            class=\"size-4\"\n            :class=\"iconColorClass\"\n          >\n            <template v-if=\"props.theme === 'green'\">\n              <circle cx=\"8\" cy=\"8\" r=\"7\" fill=\"currentColor\" />\n              <path\n                d=\"M4.8 8.2l2.1 2.1 4.3-4.4\"\n                stroke=\"var(--surface-base)\"\n                stroke-width=\"1.5\"\n                stroke-linecap=\"round\"\n                stroke-linejoin=\"round\"\n              />\n            </template>\n            <template v-else-if=\"props.theme === 'amber'\">\n              <path\n                d=\"M7.1 1.7L1.1 12a1.7 1.7 0 001.5 2.5h10.8a1.7 1.7 0 001.5-2.5L8.9 1.7a1.1 1.1 0 00-1.8 0z\"\n                fill=\"currentColor\"\n              />\n              <path\n                d=\"M8 5.2v3.6\"\n                stroke=\"var(--surface-base)\"\n                stroke-width=\"1.5\"\n                stroke-linecap=\"round\"\n              />\n              <circle cx=\"8\" cy=\"11.4\" r=\".9\" fill=\"var(--surface-base)\" />\n            </template>\n            <template v-else-if=\"props.theme === 'red'\">\n              <circle cx=\"8\" cy=\"8\" r=\"7\" fill=\"currentColor\" />\n              <path\n                d=\"M5.5 5.5l5 5m0-5l-5 5\"\n                stroke=\"var(--surface-base)\"\n                stroke-width=\"1.5\"\n                stroke-linecap=\"round\"\n              />\n            </template>\n            <template v-else>\n              <circle cx=\"8\" cy=\"8\" r=\"7\" fill=\"currentColor\" />\n              <path\n                d=\"M8 7.2v4\"\n                stroke=\"var(--surface-base)\"\n                stroke-width=\"1.5\"\n                stroke-linecap=\"round\"\n              />\n              <circle cx=\"8\" cy=\"4.7\" r=\".9\" fill=\"var(--surface-base)\" />\n            </template>\n          </svg>\n          <span\n            v-else-if=\"isLucideIcon\"\n            class=\"size-4\"\n            :class=\"[props.icon, iconColorClass]\"\n            aria-hidden=\"true\"\n          />\n          <component\n            v-else-if=\"customComponent\"\n            :is=\"customComponent\"\n            class=\"size-4\"\n            :class=\"iconColorClass\"\n          />\n          <span v-else-if=\"customText\">{{ customText }}</span>\n        </slot>\n      </div>\n      <div\n        v-if=\"showTitle\"\n        data-slot=\"title\"\n        class=\"min-w-0 text-sm font-medium text-ink-gray-8\"\n      >\n        <slot name=\"title\">{{ props.title }}</slot>\n      </div>\n    </div>\n\n    <div v-if=\"showDescription || showBannerActions\" class=\"mt-1 flex flex-col items-start gap-3\">\n      <p v-if=\"showDescription\" data-slot=\"description\" class=\"text-sm text-ink-gray-6\">\n        <slot name=\"description\">{{ props.description }}</slot>\n      </p>\n      <div v-if=\"showBannerActions\" data-slot=\"actions\" class=\"flex items-center gap-1\">\n        <slot name=\"actions\" :dismiss=\"dismiss\">\n          <Button\n            v-if=\"props.primaryAction\"\n            v-bind=\"bannerPrimaryProps\"\n            :loading=\"primaryLoading\"\n            :class=\"bannerPrimaryClass\"\n            @click=\"handleAction('primary', props.primaryAction)\"\n          />\n          <Button\n            v-if=\"props.secondaryAction\"\n            v-bind=\"bannerSecondaryProps\"\n            :loading=\"secondaryLoading\"\n            :class=\"bannerSecondaryClass\"\n            @click=\"handleAction('secondary', props.secondaryAction)\"\n          />\n        </slot>\n      </div>\n    </div>\n\n    <Button\n      v-if=\"props.dismissible\"\n      data-slot=\"dismiss\"\n      class=\"absolute right-1.5 top-1.5\"\n      variant=\"ghost\"\n      theme=\"gray\"\n      size=\"xs\"\n      aria-label=\"Dismiss\"\n      @click=\"dismiss\"\n    >\n      <svg viewBox=\"0 0 16 16\" fill=\"none\" aria-hidden=\"true\" class=\"size-4\">\n        <path\n          d=\"M4 4l8 8m0-8l-8 8\"\n          stroke=\"currentColor\"\n          stroke-width=\"1.5\"\n          stroke-linecap=\"round\"\n        />\n      </svg>\n    </Button>\n  </div>\n</template>\n",
      "type": "registry:ui"
    },
