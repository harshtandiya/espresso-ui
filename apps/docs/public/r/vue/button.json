      "path": "components/ui/Button.vue",
      "content": "<script setup lang=\"ts\">\nimport { computed, type Component } from \"vue\";\nimport { ark } from \"@ark-ui/vue/factory\";\nimport { cva, type VariantProps } from \"class-variance-authority\";\nimport { cn } from \"@/lib/utils\";\n\nconst buttonVariants = cva(\n  \"inline-flex shrink-0 cursor-pointer items-center justify-center gap-2 whitespace-nowrap font-medium leading-tighter transition-colors focus-visible:outline-none disabled:pointer-events-none disabled:bg-surface-gray-2 disabled:text-ink-gray-4 disabled:border-transparent disabled:shadow-none [&_svg]:pointer-events-none [&_svg]:shrink-0\",\n  {\n    variants: {\n      theme: { gray: \"\", blue: \"\", green: \"\", red: \"\" },\n      variant: {\n        solid: \"\",\n        subtle: \"\",\n        outline: \"border\",\n        ghost: \"\",\n        link: \"bg-transparent underline-offset-4 hover:underline\",\n      },\n      size: {\n        xs: \"h-(--btn-xs-height) px-(--btn-xs-px) rounded-(--btn-xs-radius) [font-size:var(--btn-xs-font-size)] [&_svg]:size-3.5\",\n        sm: \"h-(--btn-sm-height) px-(--btn-sm-px) rounded-(--btn-sm-radius) [font-size:var(--btn-sm-font-size)] [&_svg]:size-4\",\n        md: \"h-(--btn-md-height) px-(--btn-md-px) rounded-(--btn-md-radius) [font-size:var(--btn-md-font-size)] [&_svg]:size-4.5\",\n        lg: \"h-(--btn-lg-height) px-(--btn-lg-px) rounded-(--btn-lg-radius) [font-size:var(--btn-lg-font-size)] [&_svg]:size-5\",\n      },\n    },\n    compoundVariants: [\n      { theme: \"gray\", variant: \"solid\", class: \"bg-surface-gray-10 text-ink-base hover:bg-surface-gray-9 active:bg-surface-gray-8 focus-visible:[outline:var(--focus-outline-default)]\" },\n      { theme: \"gray\", variant: \"subtle\", class: \"bg-surface-gray-2 text-ink-gray-8 hover:bg-surface-gray-3 active:bg-surface-gray-4 focus-visible:[outline:var(--focus-outline-default)]\" },\n      { theme: \"gray\", variant: \"outline\", class: \"border-outline-gray-2 bg-surface-base text-ink-gray-8 hover:border-outline-gray-3 active:border-outline-gray-3 active:bg-surface-gray-4 focus-visible:[outline:var(--focus-outline-default)]\" },\n      { theme: \"gray\", variant: \"ghost\", class: \"bg-transparent text-ink-gray-8 hover:bg-surface-gray-3 active:bg-surface-gray-4 focus-visible:[outline:var(--focus-outline-default)]\" },\n      { theme: \"gray\", variant: \"link\", class: \"text-ink-gray-8 focus-visible:[outline:var(--focus-outline-default)]\" },\n      { theme: \"blue\", variant: \"solid\", class: \"bg-surface-blue-6 text-ink-base hover:bg-surface-blue-7 active:bg-surface-blue-8 focus-visible:[outline:var(--focus-outline-blue)]\" },\n      { theme: \"blue\", variant: \"subtle\", class: \"bg-surface-blue-2 text-ink-blue-5 hover:bg-surface-blue-3 active:bg-surface-blue-4 focus-visible:[outline:var(--focus-outline-blue)]\" },\n      { theme: \"blue\", variant: \"outline\", class: \"border-outline-blue-1 bg-surface-base text-ink-blue-5 hover:border-outline-blue-4 active:border-outline-blue-4 active:bg-surface-blue-4 focus-visible:[outline:var(--focus-outline-blue)]\" },\n      { theme: \"blue\", variant: \"ghost\", class: \"bg-transparent text-ink-blue-5 hover:bg-surface-blue-3 active:bg-surface-blue-4 focus-visible:[outline:var(--focus-outline-blue)]\" },\n      { theme: \"blue\", variant: \"link\", class: \"text-ink-blue-5 focus-visible:[outline:var(--focus-outline-blue)]\" },\n      { theme: \"green\", variant: \"solid\", class: \"bg-surface-green-7 text-ink-base hover:bg-surface-green-8 active:bg-surface-green-9 focus-visible:[outline:var(--focus-outline-green)]\" },\n      { theme: \"green\", variant: \"subtle\", class: \"bg-surface-green-2 text-ink-green-8 hover:bg-surface-green-3 active:bg-surface-green-4 focus-visible:[outline:var(--focus-outline-green)]\" },\n      { theme: \"green\", variant: \"outline\", class: \"border-outline-green-3 bg-surface-base text-ink-green-8 hover:border-outline-green-5 active:border-outline-green-5 active:bg-surface-green-4 focus-visible:[outline:var(--focus-outline-green)]\" },\n      { theme: \"green\", variant: \"ghost\", class: \"bg-transparent text-ink-green-8 hover:bg-surface-green-3 active:bg-surface-green-4 focus-visible:[outline:var(--focus-outline-green)]\" },\n      { theme: \"green\", variant: \"link\", class: \"text-ink-green-8 focus-visible:[outline:var(--focus-outline-green)]\" },\n      { theme: \"red\", variant: \"solid\", class: \"bg-surface-red-7 text-ink-base hover:bg-surface-red-8 active:bg-surface-red-9 focus-visible:[outline:var(--focus-outline-red)]\" },\n      { theme: \"red\", variant: \"subtle\", class: \"bg-surface-red-2 text-ink-red-7 hover:bg-surface-red-3 active:bg-surface-red-4 focus-visible:[outline:var(--focus-outline-red)]\" },\n      { theme: \"red\", variant: \"outline\", class: \"border-outline-red-1 bg-surface-base text-ink-red-7 hover:border-outline-red-3 active:border-outline-red-3 active:bg-surface-red-3 focus-visible:[outline:var(--focus-outline-red)]\" },\n      { theme: \"red\", variant: \"ghost\", class: \"bg-transparent text-ink-red-7 hover:bg-surface-red-3 active:bg-surface-red-4 focus-visible:[outline:var(--focus-outline-red)]\" },\n      { theme: \"red\", variant: \"link\", class: \"text-ink-red-7 focus-visible:[outline:var(--focus-outline-red)]\" },\n    ],\n    defaultVariants: { theme: \"gray\", variant: \"subtle\", size: \"sm\" },\n  },\n);\n\ntype ButtonVariants = VariantProps<typeof buttonVariants>;\n\nconst props = withDefaults(\n  defineProps<{\n    theme?: ButtonVariants[\"theme\"];\n    variant?: ButtonVariants[\"variant\"];\n    size?: ButtonVariants[\"size\"];\n    disabled?: boolean;\n    asChild?: boolean;\n    href?: string;\n    icon?: string | Component;\n    iconLeft?: string | Component;\n    iconRight?: string | Component;\n    label?: string;\n    loading?: boolean;\n    loadingText?: string;\n    type?: \"button\" | \"submit\" | \"reset\";\n    class?: string;\n  }>(),\n  {\n    theme: \"gray\",\n    variant: \"subtle\",\n    size: \"sm\",\n    disabled: false,\n    asChild: false,\n    loading: false,\n    type: \"button\",\n  },\n);\n\nconst classes = computed(() =>\n  cn(buttonVariants({ theme: props.theme, variant: props.variant, size: props.size }), props.class),\n);\n</script>\n\n<template>\n  <a\n    v-if=\"props.href && !props.disabled\"\n    :href=\"props.href\"\n    target=\"_blank\"\n    rel=\"noreferrer noopener\"\n    :class=\"classes\"\n    :aria-busy=\"props.loading || undefined\"\n    v-bind=\"$attrs\"\n  >\n    <svg v-if=\"props.loading\" class=\"size-4 animate-spin\" viewBox=\"0 0 24 24\" fill=\"none\" aria-hidden=\"true\">\n      <circle cx=\"12\" cy=\"12\" r=\"9\" stroke=\"currentColor\" stroke-width=\"3\" class=\"opacity-25\" />\n      <path d=\"M21 12a9 9 0 0 0-9-9\" stroke=\"currentColor\" stroke-width=\"3\" stroke-linecap=\"round\" />\n    </svg>\n    <template v-else-if=\"props.iconLeft\">\n      <span v-if=\"typeof props.iconLeft === 'string'\" :class=\"props.iconLeft\" aria-hidden=\"true\" />\n      <component :is=\"props.iconLeft\" v-else />\n    </template>\n    <template v-else-if=\"props.icon\">\n      <span v-if=\"typeof props.icon === 'string'\" :class=\"props.icon\" aria-hidden=\"true\" />\n      <component :is=\"props.icon\" v-else />\n    </template>\n    <template v-if=\"props.loading && props.loadingText\">{{ props.loadingText }}</template>\n    <slot v-else>{{ props.label }}</slot>\n    <template v-if=\"!props.loading && props.iconRight\">\n      <span v-if=\"typeof props.iconRight === 'string'\" :class=\"props.iconRight\" aria-hidden=\"true\" />\n      <component :is=\"props.iconRight\" v-else />\n    </template>\n  </a>\n  <component\n    v-else\n    :is=\"ark.button\"\n    :as-child=\"props.asChild\"\n    :type=\"props.type\"\n    :disabled=\"props.disabled || props.loading\"\n    :aria-busy=\"props.loading || undefined\"\n    :class=\"classes\"\n    v-bind=\"$attrs\"\n  >\n    <svg v-if=\"props.loading\" class=\"size-4 animate-spin\" viewBox=\"0 0 24 24\" fill=\"none\" aria-hidden=\"true\">\n      <circle cx=\"12\" cy=\"12\" r=\"9\" stroke=\"currentColor\" stroke-width=\"3\" class=\"opacity-25\" />\n      <path d=\"M21 12a9 9 0 0 0-9-9\" stroke=\"currentColor\" stroke-width=\"3\" stroke-linecap=\"round\" />\n    </svg>\n    <template v-else-if=\"props.iconLeft\">\n      <span v-if=\"typeof props.iconLeft === 'string'\" :class=\"props.iconLeft\" aria-hidden=\"true\" />\n      <component :is=\"props.iconLeft\" v-else />\n    </template>\n    <template v-else-if=\"props.icon\">\n      <span v-if=\"typeof props.icon === 'string'\" :class=\"props.icon\" aria-hidden=\"true\" />\n      <component :is=\"props.icon\" v-else />\n    </template>\n    <template v-if=\"props.loading && props.loadingText\">{{ props.loadingText }}</template>\n    <slot v-else>{{ props.label }}</slot>\n    <template v-if=\"!props.loading && props.iconRight\">\n      <span v-if=\"typeof props.iconRight === 'string'\" :class=\"props.iconRight\" aria-hidden=\"true\" />\n      <component :is=\"props.iconRight\" v-else />\n    </template>\n  </component>\n</template>\n",
      "type": "registry:ui"
    },
    {
      "path": "components/ui/button.css",
      "content": "/* Button component tokens — override these to customise the button. */\n:root {\n  /* Size: xs */\n  --btn-xs-height: 24px;\n  --btn-xs-px: 6px;\n  --btn-xs-radius: var(--radius-3);\n  --btn-xs-font-size: 12px;\n\n  /* Size: sm */\n  --btn-sm-height: 28px;\n  --btn-sm-px: 8px;\n  --btn-sm-radius: var(--radius-4);\n  --btn-sm-font-size: 14px;\n\n  /* Size: md */\n  --btn-md-height: 32px;\n  --btn-md-px: 10px;\n  --btn-md-radius: var(--radius-4);\n  --btn-md-font-size: 14px;\n\n  /* Size: lg */\n  --btn-lg-height: 40px;\n  --btn-lg-px: 12px;\n  --btn-lg-radius: var(--radius-5);\n  --btn-lg-font-size: 16px;\n}\n",
