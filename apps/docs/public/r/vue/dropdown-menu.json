{
  "name": "dropdown-menu",
  "type": "registry:ui",
  "title": "DropdownMenu",
  "description": "espresso-ui DropdownMenu component (Vue)",
  "dependencies": [
    "@ark-ui/vue",
    "clsx",
    "tailwind-merge"
  ],
  "registryDependencies": [],
  "files": [
    {
      "path": "components/ui/DropdownMenu.vue",
      "content": "<script setup lang=\"ts\">\nimport { computed, type Component } from \"vue\";\nimport {\n  MenuContent,\n  MenuItem,\n  MenuItemGroup,\n  MenuItemGroupLabel,\n  MenuItemText,\n  MenuPortal,\n  MenuPositioner,\n  MenuRoot,\n  MenuSeparator,\n  MenuTrigger,\n} from \"@ark-ui/vue/menu\";\nimport { Portal } from \"@ark-ui/vue/portal\";\nimport { cn } from \"@/lib/utils\";\n\ntype DropdownMenuItem = {\n  label: string;\n  icon?: string | Component;\n  shortcut?: string;\n  disabled?: boolean;\n  danger?: boolean;\n  onSelect?: () => void;\n};\ntype DropdownMenuSeparator = { type: \"separator\" };\ntype DropdownMenuGroup = { type: \"group\"; label?: string; items: DropdownMenuItem[] };\ntype DropdownMenuEntry = DropdownMenuItem | DropdownMenuSeparator | DropdownMenuGroup;\n\ntype DropdownMenuRow =\n  | { kind: \"separator\"; key: string }\n  | { kind: \"group\"; key: string; label?: string; items: DropdownMenuItem[] }\n  | { kind: \"item\"; key: string; item: DropdownMenuItem };\n\nconst props = withDefaults(\n  defineProps<{\n    items?: DropdownMenuEntry[];\n    side?: \"top\" | \"right\" | \"bottom\" | \"left\";\n    align?: \"start\" | \"center\" | \"end\";\n    offset?: number;\n    class?: string;\n  }>(),\n  {\n    items: () => [],\n    side: \"bottom\",\n    align: \"start\",\n    offset: 6,\n  },\n);\n\nconst emit = defineEmits<{\n  select: [label: string];\n}>();\n\nconst slots = defineSlots<{\n  trigger?: () => unknown;\n  default?: () => unknown;\n}>();\n\nconst placement = computed(\n  () =>\n    (props.align === \"center\" ? props.side : `${props.side}-${props.align}`) as\n      | \"top\"\n      | \"right\"\n      | \"bottom\"\n      | \"left\"\n      | \"top-start\"\n      | \"top-end\"\n      | \"right-start\"\n      | \"right-end\"\n      | \"bottom-start\"\n      | \"bottom-end\"\n      | \"left-start\"\n      | \"left-end\",\n);\n\nconst positioning = computed(() => ({\n  placement: placement.value,\n  gutter: props.offset,\n}));\n\nconst itemClasses =\n  \"flex cursor-pointer select-none items-center gap-2 rounded-(--radius-3) px-2 py-1.5 text-sm text-ink-gray-7 outline-none transition-colors data-[highlighted]:bg-surface-gray-3 data-[highlighted]:text-ink-gray-8 data-[disabled]:pointer-events-none data-[disabled]:opacity-50\";\n\nfunction isSeparator(entry: DropdownMenuEntry): entry is DropdownMenuSeparator {\n  return \"type\" in entry && entry.type === \"separator\";\n}\n\nfunction isGroup(entry: DropdownMenuEntry): entry is DropdownMenuGroup {\n  return \"type\" in entry && entry.type === \"group\";\n}\n\nconst rows = computed<DropdownMenuRow[]>(() =>\n  props.items.map((entry, index) => {\n    if (isSeparator(entry)) return { kind: \"separator\", key: `separator-${index}` };\n    if (isGroup(entry)) {\n      return { kind: \"group\", key: `group-${index}`, label: entry.label, items: entry.items };\n    }\n    return { kind: \"item\", key: `item-${index}`, item: entry as DropdownMenuItem };\n  }),\n);\n\nfunction onSelect(item: DropdownMenuItem) {\n  item.onSelect?.();\n  emit(\"select\", item.label);\n}\n</script>\n\n<template>\n  <MenuRoot :positioning=\"positioning\" :lazy-mount=\"true\" :unmount-on-exit=\"true\">\n    <slot name=\"trigger\">\n      <MenuTrigger as-child>\n        <button type=\"button\" class=\"inline-flex items-center gap-1 text-sm text-ink-gray-8\">\n          Actions\n        </button>\n      </MenuTrigger>\n    </slot>\n\n    <Portal>\n      <MenuPositioner data-slot=\"dropdown-positioner\" class=\"[--z-index:50]!\">\n        <MenuContent\n          data-slot=\"dropdown-content\"\n          :class=\"\n            cn(\n              'min-w-[190px] rounded-4 border border-outline-gray-2 bg-surface-base p-1 shadow-lg outline-none',\n              props.class,\n            )\n          \"\n        >\n          <slot>\n            <template v-for=\"row in rows\" :key=\"row.key\">\n              <MenuSeparator\n                v-if=\"row.kind === 'separator'\"\n                data-slot=\"dropdown-separator\"\n                class=\"my-1 h-px bg-outline-gray-2\"\n              />\n              <MenuItemGroup v-else-if=\"row.kind === 'group'\" data-slot=\"dropdown-group\">\n                <MenuItemGroupLabel v-if=\"row.label\" class=\"px-2 py-1 text-xs text-ink-gray-5\">\n                  {{ row.label }}\n                </MenuItemGroupLabel>\n                <MenuItem\n                  v-for=\"item in row.items\"\n                  :key=\"item.label\"\n                  :value=\"item.label\"\n                  :disabled=\"item.disabled\"\n                  :class=\"\n                    cn(\n                      itemClasses,\n                      item.danger && 'text-ink-red-6 data-[highlighted]:text-ink-red-7',\n                    )\n                  \"\n                  @select=\"onSelect(item)\"\n                >\n                  <span\n                    v-if=\"item.icon\"\n                    class=\"flex size-4 items-center justify-center text-ink-gray-6\"\n                  >\n                    <span v-if=\"typeof item.icon === 'string'\" :class=\"item.icon\" />\n                    <component v-else :is=\"item.icon\" />\n                  </span>\n                  <MenuItemText>{{ item.label }}</MenuItemText>\n                  <span v-if=\"item.shortcut\" class=\"ms-auto text-xs text-ink-gray-5\">\n                    {{ item.shortcut }}\n                  </span>\n                </MenuItem>\n              </MenuItemGroup>\n              <MenuItem\n                v-else\n                :value=\"row.item.label\"\n                :disabled=\"row.item.disabled\"\n                :class=\"\n                  cn(\n                    itemClasses,\n                    row.item.danger && 'text-ink-red-6 data-[highlighted]:text-ink-red-7',\n                  )\n                \"\n                @select=\"onSelect(row.item)\"\n              >\n                <span\n                  v-if=\"row.item.icon\"\n                  class=\"flex size-4 items-center justify-center text-ink-gray-6\"\n                >\n                  <span\n                    v-if=\"typeof row.item.icon === 'string'\"\n                    :class=\"row.item.icon\"\n                  />\n                  <component v-else :is=\"row.item.icon\" />\n                </span>\n                <MenuItemText>{{ row.item.label }}</MenuItemText>\n                <span v-if=\"row.item.shortcut\" class=\"ms-auto text-xs text-ink-gray-5\">\n                  {{ row.item.shortcut }}\n                </span>\n              </MenuItem>\n            </template>\n          </slot>\n        </MenuContent>\n      </MenuPositioner>\n    </Portal>\n  </MenuRoot>\n</template>\n",
      "type": "registry:ui"
    },
    {
      "path": "components/ui/dropdown-menu.css",
      "content": "/* Rows highlight on hover and on keyboard focus, which Zag marks the same\n   way, so pointer and keyboard users see the same row. */\n[data-slot=\"dropdown-content\"] {\n  max-height: min(24rem, var(--radix-menu-content-available-height, 24rem));\n  overflow-y: auto;\n}\n",
      "type": "registry:style"
    }
  ]
}