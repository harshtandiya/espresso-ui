// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`error-message templates > renders React template 1`] = `
"import type { ComponentPropsWithoutRef } from "react";
import { cn } from "@/lib/utils";

export type ErrorMessageValue =
  | string
  | string[]
  | (Error & { messages?: string | string[] });

export type ErrorMessageProps = Omit<ComponentPropsWithoutRef<"div">, "children"> & {
  /** One message, several lines, or an Error. */
  message?: ErrorMessageValue | null;
};

function errorLines(value: ErrorMessageValue | null | undefined): string[] {
  if (!value) return [];
  if (typeof value === "string") return [value];
  if (Array.isArray(value)) return value.filter(Boolean).map(String);
  if (value instanceof Error) {
    const messages = value.messages;
    if (Array.isArray(messages) && messages.length) return messages.filter(Boolean).map(String);
    if (typeof messages === "string" && messages) return [messages];
    return value.message ? [value.message] : [];
  }
  return [String(value)];
}

export function ErrorMessage({ message, className, ...props }: ErrorMessageProps) {
  const lines = errorLines(message);
  if (lines.length === 0) return null;

  return (
    <div
      role="alert"
      className={cn("whitespace-pre-line text-sm text-ink-red-7", className)}
      {...props}
    >
      {lines.map((line, index) => (
        <p key={index}>{line}</p>
      ))}
    </div>
  );
}
"
`;

