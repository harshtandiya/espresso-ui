// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`textarea templates > renders React template 1`] = `
"import { forwardRef, useId } from "react";
import type { ComponentPropsWithoutRef, ReactNode } from "react";
import { cn } from "@/lib/utils";

const sizeClasses = {
  xs: "min-h-(--textarea-xs-min-height) rounded-(--input-xs-radius) px-1.5 py-1",
  sm: "min-h-(--textarea-sm-min-height) rounded-(--input-sm-radius) px-2 py-1.5",
  md: "min-h-(--textarea-md-min-height) rounded-(--input-md-radius) px-2.5 py-1.5",
  lg: "min-h-(--textarea-lg-min-height) rounded-(--input-lg-radius) px-3 py-1.5",
};

const variantClasses = {
  subtle:
    "border-surface-gray-2 bg-surface-gray-2 hover:border-outline-elevation-2 hover:bg-surface-gray-3 focus:border-outline-gray-4 focus:bg-surface-base focus:shadow-sm",
  outline:
    "border-outline-gray-2 bg-surface-base hover:border-outline-gray-3 hover:shadow-sm focus:border-outline-gray-4 focus:bg-surface-base focus:shadow-sm",
  ghost: "border-transparent bg-transparent focus:outline-none",
};

const requiredMark = (
  <>
    <span className="select-none [color:var(--label-required-color,var(--ink-red-5))]" aria-hidden="true">
      *
    </span>
    <span className="sr-only">(required)</span>
  </>
);

type TextareaSize = keyof typeof sizeClasses;
type TextareaVariant = keyof typeof variantClasses;

export type TextareaProps = Omit<ComponentPropsWithoutRef<"textarea">, "size"> & {
  /** Visual size of the textarea. */
  size?: TextareaSize;
  /** Surface treatment of the textarea. */
  variant?: TextareaVariant;
  /** Label rendered above the textarea. */
  label?: ReactNode;
  /** Helper text rendered below the textarea. Hidden when \`error\` is set. */
  description?: ReactNode;
  /** Error message; marks the textarea invalid. */
  error?: ReactNode;
  /** Marks the field as required and renders an asterisk. */
  required?: boolean;
};

export const Textarea = forwardRef<HTMLTextAreaElement, TextareaProps>(
  (
    {
      className,
      id,
      size = "sm",
      variant = "subtle",
      label,
      description,
      error,
      required,
      disabled,
      rows = 3,
      "aria-describedby": ariaDescribedBy,
      ...props
    },
    ref,
  ) => {
    const generatedId = useId();
    const inputId = id ?? generatedId;
    const descriptionId = \`\${inputId}-description\`;
    const errorId = \`\${inputId}-error\`;
    const hasError = Boolean(error);
    const hasLabeling = Boolean(label || description || error);
    const describedBy =
      [description && !hasError ? descriptionId : null, hasError ? errorId : null]
        .filter(Boolean)
        .join(" ") || ariaDescribedBy;

    return (
      <div className={cn(hasLabeling && "flex flex-col gap-1.5", hasLabeling && className)}>
        {label ? (
          <label
            htmlFor={inputId}
            className="block [font-size:var(--label-font-size,13px)] [font-weight:var(--label-font-weight,420)] leading-tighter [color:var(--label-color,var(--ink-gray-6))]"
          >
            {label}
            {required ? requiredMark : null}
          </label>
        ) : null}
        <textarea
          ref={ref}
          id={inputId}
          rows={rows}
          required={required}
          disabled={disabled}
          aria-required={required || undefined}
          aria-invalid={hasError || undefined}
          aria-errormessage={hasError ? errorId : undefined}
          aria-describedby={describedBy}
          data-slot="control"
          data-size={size}
          data-variant={variant}
          data-state={hasError ? "invalid" : "valid"}
          data-disabled={disabled ? "true" : undefined}
          data-required={required ? "true" : undefined}
          className={cn(
            "block w-full resize-y border [font-size:var(--textarea-font-size)] leading-tighter text-ink-gray-8 transition-colors outline-none placeholder:text-ink-gray-4 disabled:cursor-not-allowed disabled:border-surface-gray-2 disabled:bg-surface-gray-1 disabled:text-ink-gray-5 disabled:placeholder:text-ink-gray-3",
            sizeClasses[size],
            variantClasses[variant],
            !hasLabeling && className,
          )}
          {...props}
        />
        {description && !hasError ? (
          <p
            id={descriptionId}
            className="[font-size:var(--input-description-font-size)] leading-tighter text-ink-gray-5"
          >
            {description}
          </p>
        ) : null}
        {hasError ? (
          <p
            id={errorId}
            role="alert"
            className="[font-size:var(--input-description-font-size)] leading-tighter text-ink-red-7"
          >
            {error}
          </p>
        ) : null}
      </div>
    );
  },
);

Textarea.displayName = "Textarea";
"
`;

exports[`textarea templates > renders React template without TypeScript 1`] = `
"import { forwardRef, useId } from "react";
import { cn } from "@/lib/utils";

const sizeClasses = {
  xs: "min-h-(--textarea-xs-min-height) rounded-(--input-xs-radius) px-1.5 py-1",
