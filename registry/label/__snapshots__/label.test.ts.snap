// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`label templates > renders React template 1`] = `
"import { forwardRef } from "react";
import type { ComponentPropsWithoutRef, ReactNode } from "react";
import { cn } from "@/lib/utils";
export type LabelProps = ComponentPropsWithoutRef<"label"> & {
  disabled?: boolean;
  /** Text content of the label. Children take precedence. */
  label?: ReactNode;
  /** Marks the field as required with a red asterisk and hidden text. */
  required?: boolean;
};
export const Label = forwardRef<HTMLLabelElement, LabelProps>(
  ({ className, disabled, label, required, children, ...props }, ref) => {
    return (
      <label
        ref={ref}
        data-disabled={disabled || undefined}
        className={cn(
          "block [font-size:var(--label-font-size)] font-(--label-font-weight) leading-tighter text-(--label-color) data-[disabled]:cursor-not-allowed data-[disabled]:text-(--label-disabled-color)",
          className,
        )}
        {...props}
      >
        {children ?? label}
        {required ? (
          <>
            <span className="ms-0.5 select-none text-(--label-required-color)" aria-hidden="true">
              *
            </span>
            <span className="sr-only">(required)</span>
          </>
        ) : null}
      </label>
    );
  },
);

Label.displayName = "Label";
"
`;

