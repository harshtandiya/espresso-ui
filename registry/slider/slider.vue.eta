<script setup lang="ts">
import { computed, ref, useId } from "vue";
import {
  SliderControl,
  SliderHiddenInput,
  SliderRange,
  SliderRoot,
  SliderThumb,
  SliderTrack,
} from "@ark-ui/vue/slider";
import { cn } from "<%= it.utilsAlias %>/utils";
import ErrorMessage from "./ErrorMessage.vue";
import Label from "./Label.vue";

type SliderSize = "sm" | "md";
type SliderValue = number[];
type SliderError = string | string[] | (Error & { messages?: string | string[] }) | null;

const props = withDefaults(
  defineProps<{
    modelValue?: SliderValue;
    defaultValue?: SliderValue;
    min?: number;
    max?: number;
    step?: number;
    size?: SliderSize;
    disabled?: boolean;
    label?: string;
    description?: string;
    error?: SliderError;
    required?: boolean;
    class?: string;
  }>(),
  {
    min: 0,
    max: 100,
    step: 1,
    size: "sm",
    disabled: false,
    label: "",
    description: "",
    error: null,
    required: false,
  },
);

const emit = defineEmits<{
  "update:modelValue": [value: SliderValue];
  "value-commit": [value: SliderValue];
}>();

const baseId = useId().replace(/:/g, "");
const labelId = `${baseId}-label`;
const descriptionId = `${baseId}-description`;
const errorId = `${baseId}-error`;
const rootRef = ref<HTMLElement | null>(null);

const hasError = computed(() => {
  const error = props.error;
  if (!error) return false;
  if (Array.isArray(error)) return error.filter(Boolean).length > 0;
  if (error instanceof Error) return Boolean(error.message);
  return Boolean(error);
});
const hasLabeling = computed(() =>
  Boolean(props.label || props.description || hasError.value),
);

const values = computed(() => props.modelValue ?? props.defaultValue ?? [props.min]);
const thumbCount = computed(() => Math.max(1, values.value.length));
const isRange = computed(() => thumbCount.value > 1);
const parts = computed(() =>
  isRange.value
    ? thumbCount.value === 2
      ? ["minimum", "maximum"]
      : Array.from(
          { length: thumbCount.value },
          (_, index) => `value ${index + 1} of ${thumbCount.value}`,
        )
    : [],
);

const thumbNameIds = computed(() =>
  Array.from({ length: thumbCount.value }, (_, index) => `${baseId}-name-${index}`),
);

const thumbNames = computed(() =>
  parts.value.map((part) => {
    const text = props.label ? `${props.label} ${part}` : part;
    return text.charAt(0).toUpperCase() + text.slice(1);
  }),
);

const defaultAriaLabel = computed(() =>
  isRange.value
    ? thumbNames.value
    : props.label
      ? [props.label]
      : ["Value"],
);

const resolvedAriaLabelledBy = computed(() =>
  isRange.value ? thumbNameIds.value : props.label ? [labelId] : undefined,
);

const describedBy = computed(
  () =>
    [
      props.description && !hasError.value ? descriptionId : null,
      hasError.value ? errorId : null,
    ]
      .filter(Boolean)
      .join(" ") || undefined,
);

const sizeClasses = {
  sm: {
    control: "h-4",
    track: "h-1",
    thumb: "size-4",
  },
  md: {
    control: "h-5",
    track: "h-1.5",
    thumb: "size-5",
  },
};

const thumbClasses = computed(() =>
  cn(
    "block rounded-full bg-surface-base shadow-md ring-1 ring-outline-gray-3 transition-shadow duration-150 ease-out hover:ring-4 hover:ring-outline-gray-3/50 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ink-gray-8 focus-visible:ring-offset-2 focus-visible:ring-offset-surface-base",
    sizeClasses[props.size].thumb,
    props.disabled ? "cursor-not-allowed" : "cursor-grab active:cursor-grabbing",
  ),
);

const thumbIds = computed(() => ({
  thumb: (index: number) => `${baseId}-thumb-${index}`,
}));

function focusFirstThumb(): void {
  rootRef.value?.querySelector<HTMLElement>('[role="slider"]')?.focus();
}

function onUpdateModelValue(next: number[]): void {
  emit("update:modelValue", next);
}

function onValueChangeEnd(details: { value: number[] }): void {
  emit("value-commit", details.value);
}
</script>

<template>
  <div :class="cn(hasLabeling && 'flex flex-col gap-1.5', hasLabeling && props.class)">
    <Label v-if="props.label" :id="labelId" :required="props.required" @click="focusFirstThumb">
      {{ props.label }}
    </Label>

    <div ref="rootRef" :class="cn(!hasLabeling && props.class)">
      <span
        v-for="(name, index) in thumbNames"
        v-show="isRange"
        :key="thumbNameIds[index]"
        :id="thumbNameIds[index]"
        class="sr-only"
      >
        {{ name }}
      </span>
      <SliderRoot
        :model-value="props.modelValue"
        :default-value="props.modelValue === undefined ? (props.defaultValue ?? [props.min]) : undefined"
        :min="props.min"
        :max="props.max"
        :step="props.step"
        :disabled="props.disabled"
        :invalid="hasError"
        :origin="props.min < 0 && props.max > 0 ? 'center' : 'start'"
        :aria-label="resolvedAriaLabelledBy ? undefined : defaultAriaLabel"
        :aria-labelledby="resolvedAriaLabelledBy"
        :ids="thumbIds"
        data-slot="slider"
        :data-size="props.size"
        :data-state="hasError ? 'invalid' : 'valid'"
        class="w-full"
        @update:model-value="onUpdateModelValue"
        @value-change-end="onValueChangeEnd"
      >
        <SliderControl
          data-slot="control"
          :class="cn('relative flex w-full touch-none select-none items-center', sizeClasses[props.size].control)"
        >
          <SliderTrack
            data-slot="track"
            :class="
              cn(
                'relative w-full grow rounded-4',
                sizeClasses[props.size].track,
                props.disabled ? 'bg-surface-gray-2' : 'bg-surface-gray-3',
              )
            "
          >
            <SliderRange
              data-slot="range"
              :class="
                cn(
                  'absolute h-full rounded-4',
                  props.disabled ? 'bg-surface-gray-4' : 'bg-surface-gray-10',
                )
              "
            />
          </SliderTrack>
          <SliderThumb
            v-for="index in thumbCount"
            :key="index"
            :index="index - 1"
            data-slot="thumb"
            :aria-describedby="describedBy"
            :aria-invalid="hasError || undefined"
            :aria-errormessage="hasError ? errorId : undefined"
            :class="thumbClasses"
          >
            <SliderHiddenInput />
          </SliderThumb>
        </SliderControl>
      </SliderRoot>
    </div>

    <p
      v-if="props.description && !hasError"
      :id="descriptionId"
      class="[font-size:var(--input-description-font-size)] leading-tighter text-ink-gray-5"
    >
      {{ props.description }}
    </p>
    <ErrorMessage v-if="hasError" :id="errorId" :message="props.error" />
  </div>
</template>
