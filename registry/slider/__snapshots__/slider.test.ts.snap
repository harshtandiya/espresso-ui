"import { useId, useRef } from "react";
import { Slider as ArkSlider } from "@ark-ui/react/slider";
import { cn } from "@/lib/utils";
import { ErrorMessage } from "./ErrorMessage";
import { Label } from "./Label";


const sizeClasses = {
