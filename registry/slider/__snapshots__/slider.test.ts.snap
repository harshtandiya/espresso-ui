  const resolvedAriaLabelledBy =
    ariaLabelledBy ?? (isRange ? thumbNameIds : labelText ? [labelId] : undefined);
  const resolvedAriaLabel = ariaLabel ?? (resolvedAriaLabelledBy ? undefined : defaultAriaLabel);

  const describedBy =
