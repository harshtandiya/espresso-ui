        <ArkSlider.Root
          value={value}
          defaultValue={value === undefined ? (defaultValue ?? [min]) : undefined}
          onValueChange={(details) => onValueChange?.(details.value)}
          onValueChangeEnd={(details) => onValueCommit?.(details.value)}
          min={min}
          max={max}
          step={step}
          disabled={disabled}
          invalid={hasError}
          origin={min < 0 && max > 0 ? "center" : "start"}
          aria-label={resolvedAriaLabel as string[] | undefined}
          aria-labelledby={resolvedAriaLabelledBy as string[] | undefined}
          ids={{ thumb: (index) => \`\${baseId}-thumb-\${index}\` }}
          data-slot="slider"
