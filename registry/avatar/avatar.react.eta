import { forwardRef, useEffect, useState } from "react";
import { cva<% if (it.typescript) { %>, type VariantProps<% } %> } from "class-variance-authority";
import { User } from "lucide-react";
<% if (it.typescript) { %>import type { ComponentPropsWithoutRef, ReactNode } from "react";
<% } %>import { cn } from "<%= it.utilsAlias %>/utils";

const avatarFaceVariants = cva(
  "inline-flex shrink-0 items-center justify-center overflow-hidden font-medium",
  {
    variants: {
      size: {
        xs: "size-(--avatar-xs-size) [font-size:var(--avatar-xs-font-size)]",
        sm: "size-(--avatar-sm-size) [font-size:var(--avatar-sm-font-size)]",
        md: "size-(--avatar-md-size) [font-size:var(--avatar-md-font-size)]",
        lg: "size-(--avatar-lg-size) [font-size:var(--avatar-lg-font-size)]",
        xl: "size-(--avatar-xl-size) [font-size:var(--avatar-xl-font-size)]",
        "2xl": "size-(--avatar-2xl-size) [font-size:var(--avatar-2xl-font-size)]",
        "3xl": "size-(--avatar-3xl-size) [font-size:var(--avatar-3xl-font-size)]",
      },
      shape: {
        squircle: "",
        circle: "rounded-full",
      },
    },
    compoundVariants: [
      { shape: "squircle", size: "xs", class: "rounded-(--avatar-xs-radius)" },
      { shape: "squircle", size: "sm", class: "rounded-(--avatar-sm-radius)" },
      { shape: "squircle", size: "md", class: "rounded-(--avatar-md-radius)" },
      { shape: "squircle", size: "lg", class: "rounded-(--avatar-lg-radius)" },
      { shape: "squircle", size: "xl", class: "rounded-(--avatar-xl-radius)" },
      { shape: "squircle", size: "2xl", class: "rounded-(--avatar-2xl-radius)" },
      { shape: "squircle", size: "3xl", class: "rounded-(--avatar-3xl-radius)" },
    ],
    defaultVariants: {
      size: "md",
      shape: "circle",
    },
  },
);

const avatarThemeClasses = {
  gray: "bg-surface-gray-2 text-ink-gray-5",
  blue: "bg-surface-blue-2 text-ink-blue-7",
  green: "bg-surface-green-2 text-ink-green-7",
  amber: "bg-surface-amber-2 text-ink-amber-7",
  red: "bg-surface-red-2 text-ink-red-7",
  violet: "bg-surface-violet-2 text-ink-violet-7",
} as const;

const fallbackIconSizeClasses = {
  xs: "[width:var(--avatar-xs-icon-size)] [height:var(--avatar-xs-icon-size)]",
  sm: "[width:var(--avatar-sm-icon-size)] [height:var(--avatar-sm-icon-size)]",
  md: "[width:var(--avatar-md-icon-size)] [height:var(--avatar-md-icon-size)]",
  lg: "[width:var(--avatar-lg-icon-size)] [height:var(--avatar-lg-icon-size)]",
  xl: "[width:var(--avatar-xl-icon-size)] [height:var(--avatar-xl-icon-size)]",
  "2xl": "[width:var(--avatar-2xl-icon-size)] [height:var(--avatar-2xl-icon-size)]",
  "3xl": "[width:var(--avatar-3xl-icon-size)] [height:var(--avatar-3xl-icon-size)]",
} as const;

const indicatorShellClasses = {
  xs: "-mr-[.1rem] -mb-[.1rem] size-2",
  sm: "-mr-[.1rem] -mb-[.1rem] size-[9px]",
  md: "-mr-[.1rem] -mb-[.1rem] size-2.5",
  lg: "-mr-[.1rem] -mb-[.1rem] size-3",
  xl: "-mr-[.1rem] -mb-[.1rem] size-3",
  "2xl": "-mr-[.1rem] -mb-[.1rem] size-3.5",
  "3xl": "-mr-[.2rem] -mb-[.2rem] size-4",
} as const;

<% if (it.typescript) { %>
type AvatarSize = NonNullable<VariantProps<typeof avatarFaceVariants>["size"]>;
type AvatarShape = NonNullable<VariantProps<typeof avatarFaceVariants>["shape"]> | "square";
type AvatarTheme = keyof typeof avatarThemeClasses;

export type AvatarProps = Omit<ComponentPropsWithoutRef<"span">, "children"> & {
  /** Image URL used for the avatar. */
  image?: string;
  /** Full name used for the fallback initial and the accessible label. */
  label?: string;
  /** Visual colour theme used for the fallback. */
  theme?: AvatarTheme;
  /** @deprecated Use `image`. */
  src?: string;
  /** @deprecated Use `label`. */
  alt?: string;
  /** @deprecated Use `label`. */
  fallback?: string;
  size?: AvatarSize;
  shape?: AvatarShape;
  /** Optional content shown at the bottom-right of the avatar. */
  indicator?: ReactNode;
  /** @deprecated Use `indicator`. */
  status?: ReactNode;
  /** Optional classes applied to the indicator shell. */
  statusClassName?: string;
  /** Custom fallback content shown instead of the initial. */
  children?: ReactNode;
};
<% } %>

export const <%= it.componentName %> = forwardRef<% if (it.typescript) { %><HTMLSpanElement, AvatarProps><% } %>(
  (
    {
      className,
      image,
      label,
      theme = "gray",
      src = "",
      alt = "",
      fallback = "",
      size = "md",
      shape = "circle",
      indicator,
      status,
      statusClassName,
      children,
      ...props
    },
    ref,
  ) => {
    const [imageError, setImageError] = useState(false);
    const imageSrc = image ?? src;
    const displayLabel = label ?? fallback ?? alt;
    const accessibleLabel = displayLabel || "User avatar";
    const initial = displayLabel.trim().slice(0, 1).toUpperCase();
    const showImage = Boolean(imageSrc) && !imageError;
    const shapeVariant = shape === "square" ? "squircle" : shape;
    const indicatorContent = indicator ?? status;

    useEffect(() => {
      setImageError(false);
    }, [imageSrc]);

    return (
      <span
        ref={ref}
        role="img"
        aria-label={accessibleLabel}
        data-size={size}
        data-shape={shape}
        data-theme={theme}
        className={cn("relative inline-flex shrink-0 select-none", className)}
        {...props}
      >
        <span className={cn(avatarFaceVariants({ size, shape: shapeVariant }), !showImage && avatarThemeClasses[theme])}>
          {showImage ? (
            <img
              src={imageSrc}
              alt=""
              className="size-full object-cover"
              onError={() => {
                setImageError(true);
              }}
            />
          ) : children ? (
            <span className={cn("inline-flex items-center justify-center", fallbackIconSizeClasses[size])}>
              {children}
            </span>
          ) : initial ? (
            <span aria-hidden="true">{initial}</span>
          ) : (
            <User className={cn(fallbackIconSizeClasses[size], "text-current")} aria-hidden="true" />
          )}
        </span>
        {indicatorContent ? (
          <span
            aria-hidden="true"
            className={cn(
              "absolute bottom-0 right-0 grid place-items-center rounded-full bg-(--avatar-status-bg) [box-shadow:0_0_0_var(--avatar-status-ring-width)_var(--avatar-status-ring)]",
              indicatorShellClasses[size],
              statusClassName,
            )}
          >
            <span className="grid size-full place-items-center">{indicatorContent}</span>
          </span>
        ) : null}
      </span>
    );
  },
);

<%= it.componentName %>.displayName = "<%= it.componentName %>";
