import { useState } from "react";
<% if (it.typescript) { %>import type { KeyboardEvent } from "react";
<% } %>import { Eye, EyeOff } from "lucide-react";
import { KeyboardShortcut } from "./KeyboardShortcut";
import { TextInput } from "./TextInput";
<% if (it.typescript) { %>import type { TextInputProps } from "./TextInput";
<% } %>import { Tooltip } from "./Tooltip";

<% if (it.typescript) { %>
export type PasswordProps = Omit<TextInputProps, "type" | "suffix"> & {
  /** Show the value from the start. */
  defaultVisible?: boolean;
  /** Hide the reveal button. */
  showEye?: boolean;
};
<% } %>

export function <%= it.componentName %>({
  defaultVisible = false,
  showEye = true,
  onKeyDown,
  ...props
}<% if (it.typescript) { %>: PasswordProps<% } %>) {
  const [visible, setVisible] = useState(defaultVisible);
  const toggle = () => setVisible((current) => !current);
  const toggleLabel = visible ? "Hide password" : "Show password";

  function handleKeyDown(event<% if (it.typescript) { %>: KeyboardEvent<HTMLInputElement><% } %>) {
    onKeyDown?.(event);
    if (event.defaultPrevented) return;
    if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === "i") {
      event.preventDefault();
      toggle();
    }
  }

  return (
    <TextInput
      {...props}
      type={visible ? "text" : "password"}
      onKeyDown={handleKeyDown}
      suffix={
        showEye ? (
          <Tooltip
            content={
              <span className="flex items-center gap-1.5">
                {toggleLabel}
                <KeyboardShortcut combo="Mod+I" />
              </span>
            }
          >
            <button
              type="button"
              data-slot="password-toggle"
              aria-label={toggleLabel}
              disabled={props.disabled}
              onPointerDown={(event) => event.preventDefault()}
              onClick={toggle}
              className="grid size-5 place-items-center rounded-3 text-ink-gray-5 hover:bg-surface-gray-3 hover:text-ink-gray-7 disabled:pointer-events-none"
            >
              {visible ? (
                <EyeOff aria-hidden="true" className="size-3.5" />
              ) : (
                <Eye aria-hidden="true" className="size-3.5" />
              )}
            </button>
          </Tooltip>
        ) : undefined
      }
    />
  );
}
