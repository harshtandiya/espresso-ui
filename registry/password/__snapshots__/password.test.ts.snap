exports[`password templates > renders Vue template 1`] = `
"<script setup lang="ts">
import { computed, ref } from "vue";
import { Eye, EyeOff } from "@lucide/vue";
import KeyboardShortcut from "./KeyboardShortcut.vue";
import TextInput from "./TextInput.vue";
import Tooltip from "./Tooltip.vue";

defineOptions({ inheritAttrs: false });

const props = withDefaults(
  defineProps<{
    defaultVisible?: boolean;
    showEye?: boolean;
  }>(),
  {
    defaultVisible: false,
    showEye: true,
  },
);

const visible = ref(props.defaultVisible);
const toggleLabel = computed(() => (visible.value ? "Hide password" : "Show password"));

function toggle() {
  visible.value = !visible.value;
}

function onKeydown(event: KeyboardEvent) {
  if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === "i") {
    event.preventDefault();
    toggle();
  }
}
</script>

<template>
  <TextInput
    v-bind="$attrs"
    :type="visible ? 'text' : 'password'"
    @keydown="onKeydown"
  >
    <template v-if="props.showEye" #suffix>
      <Tooltip>
        <template #content>
          <span class="flex items-center gap-1.5">
            {{ toggleLabel }}
            <KeyboardShortcut combo="Mod+I" />
          </span>
        </template>
        <button
          type="button"
          data-slot="password-toggle"
          :aria-label="toggleLabel"
          :disabled="$attrs.disabled as boolean | undefined"
          class="grid size-5 place-items-center rounded-3 text-ink-gray-5 hover:bg-surface-gray-3 hover:text-ink-gray-7 disabled:pointer-events-none"
          @pointerdown.prevent
          @click="toggle"
        >
          <EyeOff v-if="visible" aria-hidden="true" class="size-3.5" />
          <Eye v-else aria-hidden="true" class="size-3.5" />
        </button>
      </Tooltip>
    </template>
  </TextInput>
</template>
"
`;
