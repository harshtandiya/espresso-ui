import { ark } from "@ark-ui/react/factory";
import { cva<% if (it.typescript) { %>, type VariantProps<% } %> } from "class-variance-authority";
<% if (it.typescript) { %>import type { ComponentPropsWithoutRef, ReactNode } from "react";
<% } %>import { cn } from "<%= it.utilsAlias %>/utils";

const badgeVariants = cva(
  "inline-flex shrink-0 select-none items-center gap-(--badge-gap) overflow-clip whitespace-nowrap rounded-(--badge-radius) leading-tighter [&_svg]:pointer-events-none [&_svg]:shrink-0",
  {
    variants: {
      theme: {
        gray: "",
        blue: "",
        green: "",
        amber: "",
        red: "",
        violet: "",
      },
      variant: {
        solid: "",
        subtle: "",
        outline: "border bg-transparent",
        ghost: "bg-transparent",
      },
      size: {
        sm: "h-(--badge-sm-height) px-(--badge-sm-px) [font-size:var(--badge-sm-font-size)] [&_svg]:size-(--badge-sm-icon-size)",
        md: "h-(--badge-md-height) px-(--badge-md-px) [font-size:var(--badge-md-font-size)] [&_svg]:size-(--badge-md-icon-size)",
        lg: "h-(--badge-lg-height) px-(--badge-lg-px) [font-size:var(--badge-lg-font-size)] [&_svg]:size-(--badge-lg-icon-size)",
      },
    },
    compoundVariants: [
      { theme: "gray", variant: "solid", class: "bg-surface-gray-10 text-ink-base" },
      { theme: "gray", variant: "subtle", class: "bg-surface-gray-2 text-ink-gray-6" },
      { theme: "gray", variant: "outline", class: "border-outline-gray-2 text-ink-gray-6" },
      { theme: "gray", variant: "ghost", class: "text-ink-gray-6" },
      { theme: "blue", variant: "solid", class: "bg-surface-blue-7 text-white" },
      { theme: "blue", variant: "subtle", class: "bg-surface-blue-2 text-ink-blue-7" },
      { theme: "blue", variant: "outline", class: "border-outline-blue-3 text-ink-blue-7" },
      { theme: "blue", variant: "ghost", class: "text-ink-blue-7" },
      { theme: "green", variant: "solid", class: "bg-surface-green-7 text-white" },
      { theme: "green", variant: "subtle", class: "bg-surface-green-2 text-ink-green-7" },
      { theme: "green", variant: "outline", class: "border-outline-green-3 text-ink-green-7" },
      { theme: "green", variant: "ghost", class: "text-ink-green-7" },
      { theme: "amber", variant: "solid", class: "bg-surface-amber-7 text-white" },
      { theme: "amber", variant: "subtle", class: "bg-surface-amber-2 text-ink-amber-7" },
      { theme: "amber", variant: "outline", class: "border-outline-amber-3 text-ink-amber-7" },
      { theme: "amber", variant: "ghost", class: "text-ink-amber-7" },
      { theme: "red", variant: "solid", class: "bg-surface-red-7 text-white" },
      { theme: "red", variant: "subtle", class: "bg-surface-red-2 text-ink-red-7" },
      { theme: "red", variant: "outline", class: "border-outline-red-3 text-ink-red-7" },
      { theme: "red", variant: "ghost", class: "text-ink-red-7" },
      { theme: "violet", variant: "solid", class: "bg-surface-violet-7 text-white" },
      { theme: "violet", variant: "subtle", class: "bg-surface-violet-2 text-ink-violet-7" },
      { theme: "violet", variant: "outline", class: "border-outline-violet-3 text-ink-violet-7" },
      { theme: "violet", variant: "ghost", class: "text-ink-violet-7" },
    ],
    defaultVariants: {
      theme: "gray",
      variant: "subtle",
      size: "md",
    },
  },
);

const themeAliases = {
  default: "gray",
  error: "red",
  warning: "amber",
  success: "green",
  info: "blue",
} as const;

type CanonicalBadgeTheme = NonNullable<VariantProps<typeof badgeVariants>["theme"]>;
type BadgeTheme = CanonicalBadgeTheme | keyof typeof themeAliases;

<% if (it.typescript) { %>
export type BadgeProps = Omit<ComponentPropsWithoutRef<typeof ark.span>, "prefix" | "suffix"> &
  Omit<VariantProps<typeof badgeVariants>, "theme"> & {
    theme?: BadgeTheme;
    label?: string | number;
    prefix?: ReactNode;
    suffix?: ReactNode;
  };
<% } %>
export function <%= it.componentName %>({
  className,
  theme = "gray",
  variant,
  size,
  label,
  prefix,
  suffix,
  children,
  ...props
}<% if (it.typescript) { %>: BadgeProps<% } %>) {
  const resolvedTheme = ((themeAliases as Record<string, string>)[theme] ?? theme) as CanonicalBadgeTheme;

  return (
    <ark.span
      className={cn(badgeVariants({ theme: resolvedTheme, variant, size }), className)}
      {...props}
    >
      {prefix ? <span className="inline-flex shrink-0 items-center justify-center">{prefix}</span> : null}
      {children ?? label}
      {suffix ? <span className="inline-flex shrink-0 items-center justify-center">{suffix}</span> : null}
    </ark.span>
  );
}
