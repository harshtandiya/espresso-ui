// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`spinner templates > renders React template 1`] = `
"import { forwardRef } from "react";
import type { ComponentPropsWithoutRef } from "react";
import { cn } from "@/lib/utils";

const sizeMap = {
  xs: { px: 12, thickness: 1.5, inset: 0.9 },
  sm: { px: 14, thickness: 2, inset: 1.05 },
  md: { px: 16, thickness: 2, inset: 1.2 },
  lg: { px: 20, thickness: 2, inset: 1.5 },
};

const colorClasses = {
  gray: "text-ink-gray-8",
  red: "text-ink-red-7",
};

type SpinnerSize = keyof typeof sizeMap;
type SpinnerTheme = keyof typeof colorClasses;

export type SpinnerProps = Omit<ComponentPropsWithoutRef<"svg">, "color"> & {
  /** Diameter: xs 12px, sm 14px, md 16px, lg 20px. */
  size?: SpinnerSize;
  /** Fixed color. Omit to inherit the current text color. */
  theme?: SpinnerTheme;
  /** Draws a faint full-circle track behind the arc. */
  track?: boolean;
};

export const Spinner = forwardRef<SVGSVGElement, SpinnerProps>(
  ({ className, size, theme, track = false, style, ...props }, ref) => {
    const dimensions = size ? sizeMap[size] : undefined;
    const spinnerStyle = dimensions
      ? {
          width: \`\${dimensions.px}px\`,
          height: \`\${dimensions.px}px\`,
          "--spinner-thickness": \`\${dimensions.thickness}px\`,
          "--spinner-mask-thickness": \`\${dimensions.thickness}px\`,
          "--spinner-inset": \`\${dimensions.inset}px\`,
        }
      : {};
    const rootStyle = { ...spinnerStyle, ...style };

    return (
      <svg
        ref={ref}
        width="16"
        height="16"
        role="status"
        aria-label="Loading"
        className={cn(
          "espresso-spinner inline-block shrink-0",
          theme && colorClasses[theme],
          track && "espresso-spinner--track",
          className,
        )}
        style={rootStyle}
        {...props}
      />
    );
  },
);

Spinner.displayName = "Spinner";
"
`;

