import { useState } from "react";
<% if (it.typescript) { %>import type { ReactNode } from "react";
<% } %>import { Dialog as ArkDialog } from "@ark-ui/react/dialog";
import { Portal } from "@ark-ui/react/portal";
import { X } from "lucide-react";
import { Button } from "./Button";
import { cn } from "<%= it.utilsAlias %>/utils";

<% if (it.typescript) { %>
export type DialogSize =
  | "xs"
  | "sm"
  | "md"
  | "lg"
  | "xl"
  | "2xl"
  | "3xl"
  | "4xl"
  | "5xl"
  | "6xl"
  | "7xl";
export type DialogTheme = "gray" | "blue" | "green" | "amber" | "red";
export type DialogPosition = "center" | "top";

export type DialogAction = {
  /** Button label. */
  label: string;
  /** Button theme. */
  theme?: "gray" | "blue" | "green" | "red";
  /** Button variant. */
  variant?: "solid" | "subtle" | "outline" | "ghost" | "link";
  /** Button size. */
  size?: "xs" | "sm" | "md" | "lg";
  /** Disables the button. */
  disabled?: boolean;
  /** Runs when the button is pressed. A promise shows a spinner until it settles. */
  onClick?: () => void | Promise<void>;
};

export type DialogProps = {
  /** Whether the dialog is open. Omit for uncontrolled use. */
  open?: boolean;
  /** Initially open, for uncontrolled use. */
  defaultOpen?: boolean;
  /** Called when the open state changes. */
  onOpenChange?: (open: boolean) => void;
  /** Title shown in the header. */
  title?: ReactNode;
  /** Short paragraph under the title. */
  message?: ReactNode;
  /** Icon shown in a badge next to the title. */
  icon?: ReactNode;
  /** Tone of the icon badge. */
  theme?: DialogTheme;
  /** Maximum width of the dialog. */
  size?: DialogSize;
  /** Vertical placement. */
  position?: DialogPosition;
  /** Allow Escape and an outside click to close the dialog. */
  dismissible?: boolean;
  /** Show the close button in the header. */
  showCloseButton?: boolean;
  /** Drop the header, the padded card and the action row. */
  bare?: boolean;
  /** Buttons shown in the footer. */
  actions?: DialogAction[];
  /** Element that opens the dialog. */
  trigger?: ReactNode;
  /** Body content. */
  children?: ReactNode;
  /** Class applied to the dialog card. */
  className?: string;
};
<% } %>

const sizeClasses = {
  xs: "max-w-xs",
  sm: "max-w-sm",
  md: "max-w-md",
  lg: "max-w-lg",
  xl: "max-w-xl",
  "2xl": "max-w-2xl",
  "3xl": "max-w-3xl",
  "4xl": "max-w-4xl",
  "5xl": "max-w-5xl",
  "6xl": "max-w-6xl",
  "7xl": "max-w-7xl",
};

const iconBadgeClasses = {
  gray: "bg-surface-gray-2 text-ink-gray-7",
  blue: "bg-surface-blue-2 text-ink-blue-7",
  green: "bg-surface-green-2 text-ink-green-7",
  amber: "bg-surface-amber-2 text-ink-amber-7",
  red: "bg-surface-red-2 text-ink-red-7",
};

export function <%= it.componentName %>({
  open,
  defaultOpen = false,
  onOpenChange,
  title,
  message,
  icon,
  theme = "gray",
  size = "lg",
  position = "center",
  dismissible = true,
  showCloseButton = true,
  bare = false,
  actions = [],
  trigger,
  children,
  className,
}<% if (it.typescript) { %>: DialogProps<% } %>) {
  const [internalOpen, setInternalOpen] = useState(defaultOpen);
  const [loadingIndex, setLoadingIndex] = useState<% if (it.typescript) { %><number | null><% } %>(null);
  const isControlled = open !== undefined;
  const isOpen = isControlled ? open : internalOpen;

  function setOpen(next<% if (it.typescript) { %>: boolean<% } %>) {
    if (!isControlled) setInternalOpen(next);
    onOpenChange?.(next);
  }

  async function runAction(action<% if (it.typescript) { %>: DialogAction<% } %>, index<% if (it.typescript) { %>: number<% } %>) {
    if (!action.onClick) return;
    const result = action.onClick();
    if (!result || typeof (result as Promise<void>).then !== "function") return;
    setLoadingIndex(index);
    try {
      await result;
    } finally {
      setLoadingIndex(null);
    }
  }

  return (
    <ArkDialog.Root
      open={isOpen}
      onOpenChange={(details) => setOpen(details.open)}
      closeOnEscape={dismissible}
      closeOnInteractOutside={dismissible}
      lazyMount
      unmountOnExit
    >
      {trigger ? <ArkDialog.Trigger asChild>{trigger}</ArkDialog.Trigger> : null}
      <Portal>
        <ArkDialog.Backdrop
          data-slot="dialog-overlay"
          className="fixed inset-0 z-50 bg-black-overlay-200 outline-none"
        />
        <ArkDialog.Positioner
          data-slot="dialog-positioner"
          className={cn(
            "fixed inset-0 z-50 flex justify-center overflow-y-auto p-4",
            position === "top" ? "items-start pt-16" : "items-center",
          )}
        >
          <ArkDialog.Content
            data-slot="dialog-content"
            className={cn(
              "w-full rounded-7 bg-surface-elevation-1 text-start shadow-xl outline-none",
              sizeClasses[size],
              className,
            )}
          >
            {bare ? (
              children
            ) : (
              <>
                <div className="px-4 pb-6 pt-5 sm:px-6">
                  <div className="flex items-center justify-between gap-2">
                    <div className="flex flex-1 items-center gap-2">
                      {icon ? (
                        <span
                          data-slot="dialog-icon"
                          className={cn(
                            "flex size-7 shrink-0 items-center justify-center rounded-full",
                            iconBadgeClasses[theme],
                          )}
                        >
                          {icon}
                        </span>
                      ) : null}
                      <ArkDialog.Title asChild>
                        <h3 className="flex-1 text-lg font-semibold leading-6 text-ink-gray-8">
                          {title}
                        </h3>
                      </ArkDialog.Title>
                    </div>
                    {showCloseButton ? (
                      <ArkDialog.CloseTrigger asChild>
                        <Button
                          variant="ghost"
                          theme="gray"
                          aria-label="Close"
                          icon={<X aria-hidden="true" className="size-4 text-ink-gray-9" />}
                        />
                      </ArkDialog.CloseTrigger>
                    ) : null}
                  </div>
                  {message ? (
                    <ArkDialog.Description asChild>
                      <p className="mt-2 text-sm text-ink-gray-7">{message}</p>
                    </ArkDialog.Description>
                  ) : null}
                  {children}
                </div>
                {actions.length ? (
                  <div
                    data-slot="dialog-actions"
                    className="flex justify-end gap-2 px-4 pb-7 pt-4 sm:px-6"
                  >
                    {actions.map((action, index) => (
                      <Button
                        key={action.label}
                        theme={action.theme ?? "gray"}
                        variant={action.variant ?? "subtle"}
                        size={action.size ?? "sm"}
                        label={action.label}
                        disabled={action.disabled}
                        loading={loadingIndex === index}
                        onClick={() => runAction(action, index)}
                      />
                    ))}
                  </div>
                ) : null}
              </>
            )}
          </ArkDialog.Content>
        </ArkDialog.Positioner>
      </Portal>
    </ArkDialog.Root>
  );
}
