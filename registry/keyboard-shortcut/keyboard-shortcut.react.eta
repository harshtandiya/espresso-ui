import { Fragment, useMemo } from "react";
<% if (it.typescript) { %>import type { ReactNode } from "react";
<% } %>import {
  ArrowBigRightDash,
  ArrowBigUp,
  ArrowDown,
  ArrowLeft,
  ArrowRight,
  ArrowUp,
  Command,
  CornerDownLeft,
  Delete,
  Option,
} from "lucide-react";
import { cn } from "<%= it.utilsAlias %>/utils";

<% if (it.typescript) { %>
export type KeyboardShortcutProps = {
  /** Shortcut combo, e.g. `"Mod+Shift+K"`. `Mod` is Cmd on macOS, Ctrl elsewhere. */
  combo?: string;
  /** Draw the keys as background chips. */
  bg?: boolean;
  /** Draw `+` between keys. `"auto"` only puts it between two text keys. */
  showPlus?: boolean | "auto";
  /** Alternative combos shown after a `/`. */
  altCombos?: string[];
  /** Draw icons for the arrow, Enter, Backspace and Delete keys. */
  useIcons?: boolean;
  /** Content shown when no `combo` is given. */
  children?: ReactNode;
  /** Class applied to the root element. */
  className?: string;
};

type ShortcutPart = {
  type: "cmd" | "ctrl" | "shift" | "alt" | "key";
  display: string;
  spell: string;
  icon: "command" | "shift" | "alt" | "up" | "down" | "left" | "right" | "enter" | "backspace" | "delete" | null;
};
<% } %>

const iconMap = {
  command: Command,
  shift: ArrowBigUp,
  alt: Option,
  up: ArrowUp,
  down: ArrowDown,
  left: ArrowLeft,
  right: ArrowRight,
  enter: CornerDownLeft,
  backspace: Delete,
  delete: ArrowBigRightDash,
};

const namedKeys: Record<string, { display: string; spell: string; icon: ShortcutPart["icon"] }> = {
  enter: { display: "↵", spell: "Enter", icon: "enter" },
  return: { display: "↵", spell: "Enter", icon: "enter" },
  escape: { display: "Esc", spell: "Escape", icon: null },
  esc: { display: "Esc", spell: "Escape", icon: null },
  backspace: { display: "⌫", spell: "Backspace", icon: "backspace" },
  delete: { display: "⌦", spell: "Delete", icon: "delete" },
  del: { display: "⌦", spell: "Delete", icon: "delete" },
  tab: { display: "Tab", spell: "Tab", icon: null },
  space: { display: "Space", spell: "Space", icon: null },
  up: { display: "↑", spell: "Up", icon: "up" },
  arrowup: { display: "↑", spell: "Up", icon: "up" },
  down: { display: "↓", spell: "Down", icon: "down" },
  arrowdown: { display: "↓", spell: "Down", icon: "down" },
  left: { display: "←", spell: "Left", icon: "left" },
  arrowleft: { display: "←", spell: "Left", icon: "left" },
  right: { display: "→", spell: "Right", icon: "right" },
  arrowright: { display: "→", spell: "Right", icon: "right" },
};

function isMacPlatform() {
  if (typeof navigator === "undefined") return false;
  const platform =
    (navigator as Navigator & { userAgentData?: { platform?: string } }).userAgentData?.platform ??
    navigator.platform ??
    navigator.userAgent;
  return /mac|iphone|ipad|ipod/i.test(platform);
}

function parseCombo(combo<% if (it.typescript) { %>: string<% } %>, isMac<% if (it.typescript) { %>: boolean<% } %>)<% if (it.typescript) { %>: ShortcutPart[]<% } %> {
  const parts: ShortcutPart[] = [];
  const tokens = combo
    .split("+")
    .map((token) => token.trim())
    .filter(Boolean);

  for (const token of tokens) {
    const lower = token.toLowerCase();
    if (lower === "mod") {
      parts.push(
        isMac
          ? { type: "cmd", display: "⌘", spell: "Command", icon: "command" }
          : { type: "ctrl", display: "Ctrl", spell: "Control", icon: null },
      );
      continue;
    }
    if (lower === "cmd" || lower === "command" || lower === "meta") {
      parts.push({ type: "cmd", display: "⌘", spell: "Command", icon: "command" });
      continue;
    }
    if (lower === "ctrl" || lower === "control") {
      parts.push({ type: "ctrl", display: "Ctrl", spell: "Control", icon: null });
      continue;
    }
    if (lower === "shift") {
      parts.push({ type: "shift", display: "⇧", spell: "Shift", icon: "shift" });
      continue;
    }
    if (lower === "alt" || lower === "option" || lower === "opt") {
      parts.push({ type: "alt", display: "⌥", spell: "Alt", icon: "alt" });
      continue;
    }
    const named = namedKeys[lower];
    if (named) {
      parts.push({ type: "key", ...named });
      continue;
    }
    const display = token.length === 1 ? token.toUpperCase() : token;
    parts.push({ type: "key", display, spell: display, icon: null });
  }

  return parts;
}

function spellOut(parts<% if (it.typescript) { %>: ShortcutPart[]<% } %>) {
  return parts.map((part) => part.spell).join(" plus ");
}

export function <%= it.componentName %>({
  combo,
  bg = false,
  showPlus = "auto",
  altCombos = [],
  useIcons = true,
  children,
  className,
  ...props
}<% if (it.typescript) { %>: KeyboardShortcutProps<% } %>) {
  const isMac = isMacPlatform();
  const parts = useMemo(() => (combo ? parseCombo(combo, isMac) : []), [combo, isMac]);
  const altParts = useMemo(
    () => altCombos.map((alt) => parseCombo(alt, isMac)),
    [altCombos, isMac],
  );

  const uniqueAltParts = useMemo(() => {
    const seen = new Set([parts.map((part) => part.display).join("+")]);
    return altParts.filter((alt) => {
      const key = alt.map((part) => part.display).join("+");
      if (seen.has(key)) return false;
      seen.add(key);
      return true;
    });
  }, [altParts, parts]);

  const plusAfter = parts.slice(0, -1).map((part, index) => {
    if (showPlus === "auto") {
      const next = parts[index + 1];
      const partDrawsIcon = part.icon !== null || part.type === "cmd" || part.type === "shift" || part.type === "alt";
      const nextDrawsIcon = next.icon !== null || next.type === "cmd" || next.type === "shift" || next.type === "alt";
      return !(partDrawsIcon || nextDrawsIcon);
    }
    return showPlus;
  });

  const ariaLabel = parts.length
    ? `Shortcut ${[spellOut(parts), ...uniqueAltParts.map((alt) => spellOut(alt))].join(", or ")}`
    : undefined;

  function renderPart(part<% if (it.typescript) { %>: ShortcutPart<% } %>, mode<% if (it.typescript) { %>: "plain" | "chip"<% } %>) {
    const Icon = part.icon ? iconMap[part.icon] : null;
    const isModifier = part.type === "cmd" || part.type === "shift" || part.type === "alt";
    const showIcon = Boolean(Icon) && (isModifier || useIcons);

    if (mode === "chip") {
      const chipIcon = part.type === "cmd" ? "command" : useIcons ? part.icon : null;
      const ChipIcon = chipIcon ? iconMap[chipIcon] : null;
      return (
        <kbd
          data-slot="key"
          data-key-type={part.type}
          className="inline-flex h-6 min-w-[1.5rem] items-center justify-center rounded-4 bg-surface-gray-2 px-1.5 text-xs-medium text-ink-gray-7"
        >
          {ChipIcon ? <ChipIcon aria-hidden="true" className="size-3" /> : part.display}
        </kbd>
      );
    }

    return (
      <span data-slot="key" data-key-type={part.type}>
        {showIcon && Icon ? (
          <Icon aria-hidden="true" className="size-3" />
        ) : (
          <span className="leading-none uppercase">{part.display}</span>
        )}
      </span>
    );
  }

  if (!parts.length) {
    return (
      <span
        data-slot="keyboard-shortcut"
        className={cn("inline-flex items-center gap-0.5 text-sm text-ink-gray-5", className)}
        {...props}
      >
        {children}
      </span>
    );
  }

  return (
    <span
      data-slot="keyboard-shortcut"
      data-bg={bg ? "true" : undefined}
      aria-label={ariaLabel}
      role={ariaLabel ? "img" : undefined}
      className={cn("inline-flex items-center gap-0.5", !bg && "text-sm text-ink-gray-5", className)}
      {...props}
    >
      {parts.map((part, index) => (
        <Fragment key={`${part.type}-${part.display}-${index}`}>
          {renderPart(part, bg ? "chip" : "plain")}
          {plusAfter[index] ? (
            <span
              data-slot="separator"
              aria-hidden="true"
              className="font-mono text-[10px] leading-none opacity-60"
            >
              +
            </span>
          ) : null}
        </Fragment>
      ))}
      {uniqueAltParts.length ? (
        <span data-slot="alt-combos" className="ms-1 inline-flex items-center gap-1.5">
          {uniqueAltParts.map((alt, altIndex) => (
            <Fragment key={`alt-${altIndex}`}>
              <span aria-hidden="true" className="text-xs text-ink-gray-4">
                /
              </span>
              <span className="inline-flex items-center gap-0.5">
                {alt.map((part, index) => (
                  <Fragment key={`${part.type}-${part.display}-${index}`}>
                    {renderPart(part, bg ? "chip" : "plain")}
                  </Fragment>
                ))}
              </span>
            </Fragment>
          ))}
        </span>
      ) : null}
    </span>
  );
}
