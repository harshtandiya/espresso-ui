exports[`tabs templates > renders Vue list template 1`] = `
"<script lang="ts">
import type { ComputedRef, InjectionKey } from "vue";
import type { TabsOrientation, TabsSize, TabsVariant } from "./Tabs.vue";

export type TabListContext = {
  variant: ComputedRef<TabsVariant>;
  size: ComputedRef<TabsSize>;
  orientation: ComputedRef<TabsOrientation>;
};

export const TAB_LIST_KEY: InjectionKey<TabListContext> = Symbol.for(
  "espresso-ui.tab-list",
);
</script>

<script setup lang="ts">
import { computed, inject, onMounted, provide, ref } from "vue";
import { cn } from "@/lib/utils";
import { TABS_KEY } from "./Tabs.vue";

const props = withDefaults(
  defineProps<{
    variant?: TabsVariant;
    size?: TabsSize;
    class?: string;
  }>(),
  {},
);

const context = inject(TABS_KEY);
if (!context) throw new Error("<TabList> must be used inside <Tabs>.");

const variant = computed(() => props.variant ?? context.variant.value);
const size = computed(() => props.size ?? context.size.value);
const orientation = computed(() => context.orientation.value);
const isVertical = computed(() => orientation.value === "vertical");
const listRef = ref<HTMLElement | null>(null);

provide(TAB_LIST_KEY, { variant, size, orientation });

const listVariantClasses = {
  underline: {
    horizontal: "relative flex items-center border-b border-outline-gray-2",
    vertical: "relative flex flex-col border-r border-outline-gray-2",
  },
  subtle: {
    horizontal: "inline-flex items-center gap-1 rounded-(--radius-4) bg-surface-gray-2 p-1",
    vertical:
      "inline-flex flex-col items-stretch gap-1 rounded-(--radius-4) bg-surface-gray-2 p-1",
  },
  ghost: {
    horizontal: "inline-flex items-center gap-1 rounded-(--radius-4) p-1",
    vertical: "inline-flex flex-col items-stretch gap-1 rounded-(--radius-4) p-1",
  },
  "browser-tab": {
    horizontal: "relative flex items-end gap-1 border-b border-outline-gray-2",
    vertical: "relative flex flex-col gap-1 border-r border-outline-gray-2",
  },
};

const classes = computed(() =>
  cn(
    listVariantClasses[variant.value][orientation.value],
    isVertical.value && "self-start",
    props.class,
  ),
);

onMounted(() => {
  if (context.selected.value !== undefined) return;
  const first = listRef.value?.querySelector<HTMLButtonElement>(
    '[role="tab"]:not(:disabled)',
  );
  first?.click();
});

function onKeydown(event: KeyboardEvent) {
  const tabs = Array.from(
    listRef.value?.querySelectorAll<HTMLButtonElement>('[role="tab"]:not(:disabled)') ?? [],
  );
  if (!tabs.length) return;

  const currentIndex = tabs.indexOf(document.activeElement as HTMLButtonElement);
  const nextKeys = isVertical.value ? ["ArrowDown", "ArrowUp"] : ["ArrowRight", "ArrowLeft"];
  let nextIndex = currentIndex;

  if (event.key === "Home") nextIndex = 0;
  else if (event.key === "End") nextIndex = tabs.length - 1;
  else if (event.key === nextKeys[0] || event.key === nextKeys[1]) {
    const direction = event.key === nextKeys[0] ? 1 : -1;
    nextIndex = (Math.max(currentIndex, 0) + direction + tabs.length) % tabs.length;
  } else {
    return;
  }

  event.preventDefault();
  const next = tabs[nextIndex];
  next.focus();
  next.click();
}
</script>

<template>
  <div
    ref="listRef"
    role="tablist"
    :aria-orientation="orientation"
    data-slot="tab-list"
    :data-variant="variant"
    :data-size="size"
    :class="classes"
    @keydown="onKeydown"
  >
    <slot />
  </div>
</template>
"
`;

exports[`tabs templates > renders Vue panel template 1`] = `
"<script setup lang="ts">
import { computed, inject } from "vue";
import { cn } from "@/lib/utils";
import { TABS_KEY, panelId, tabId, type TabValue } from "./Tabs.vue";

const props = withDefaults(
  defineProps<{
    value: TabValue;
    keepMounted?: boolean;
    class?: string;
  }>(),
  {
    keepMounted: false,
  },
);

const context = inject(TABS_KEY);
if (!context) throw new Error("<TabPanel> must be used inside <Tabs>.");

const selected = computed(() => context.selected.value === props.value);
</script>

<template>
  <div
    v-if="selected || props.keepMounted"
    v-show="selected"
    role="tabpanel"
    :id="panelId(context.baseId, props.value)"
    :aria-labelledby="tabId(context.baseId, props.value)"
    tabindex="0"
    data-slot="tab-panel"
    :class="cn('outline-none', props.class)"
  >
    <slot />
  </div>
</template>
"
`;

exports[`tabs templates > renders Vue root template 1`] = `
"<script lang="ts">
import type { ComputedRef, InjectionKey } from "vue";

export type TabValue = string | number;
export type TabsVariant = "underline" | "subtle" | "ghost" | "browser-tab";
export type TabsSize = "sm" | "md";
export type TabsOrientation = "horizontal" | "vertical";

export type TabsContext = {
  selected: ComputedRef<TabValue | undefined>;
  select: (value: TabValue) => void;
  orientation: ComputedRef<TabsOrientation>;
  variant: ComputedRef<TabsVariant>;
  size: ComputedRef<TabsSize>;
  baseId: string;
};

export const TABS_KEY: InjectionKey<TabsContext> = Symbol.for("espresso-ui.tabs");

export function tabId(baseId: string, value: TabValue) {
  return \`\${baseId}-tab-\${String(value).replace(/[^a-zA-Z0-9_-]/g, "-")}\`;
}

export function panelId(baseId: string, value: TabValue) {
  return \`\${baseId}-panel-\${String(value).replace(/[^a-zA-Z0-9_-]/g, "-")}\`;
}
</script>

<script setup lang="ts">
import { computed, provide, ref, useId } from "vue";
import { cn } from "@/lib/utils";

const props = withDefaults(
  defineProps<{
    modelValue?: TabValue;
    defaultValue?: TabValue;
    variant?: TabsVariant;
    size?: TabsSize;
    vertical?: boolean;
    orientation?: TabsOrientation;
    class?: string;
  }>(),
  {
    variant: "underline",
    size: "sm",
    vertical: false,
  },
);

const emit = defineEmits<{
  "update:modelValue": [value: TabValue];
}>();

const internalValue = ref<TabValue | undefined>(props.defaultValue);
const selected = computed(() =>
  props.modelValue !== undefined ? props.modelValue : internalValue.value,
);
const orientation = computed<TabsOrientation>(
  () => props.orientation ?? (props.vertical ? "vertical" : "horizontal"),
);
const variant = computed(() => props.variant);
const size = computed(() => props.size);
const baseId = useId().replace(/:/g, "");

function select(value: TabValue) {
  if (props.modelValue === undefined) internalValue.value = value;
  emit("update:modelValue", value);
}

provide(TABS_KEY, { selected, select, orientation, variant, size, baseId });
</script>

<template>
  <div
    data-slot="tabs"
    :data-orientation="orientation"
    :data-variant="variant"
    :data-size="size"
    :class="cn('min-w-0', props.class)"
  >
    <slot />
  </div>
</template>
"
`;

exports[`tabs templates > renders Vue trigger template 1`] = `
"<script setup lang="ts">
import { computed, inject, type Component } from "vue";
import { cn } from "@/lib/utils";
import { TABS_KEY, panelId, tabId, type TabValue } from "./Tabs.vue";
import { TAB_LIST_KEY } from "./TabList.vue";

const props = withDefaults(
  defineProps<{
    value: TabValue;
    label?: string;
    icon?: string | Component;
    disabled?: boolean;
    class?: string;
  }>(),
  {
    label: "",
    disabled: false,
  },
);

const slots = defineSlots<{
  prefix?: () => unknown;
  default?: () => unknown;
  suffix?: () => unknown;
}>();

const context = inject(TABS_KEY);
if (!context) throw new Error("<TabTrigger> must be used inside <Tabs>.");
const list = inject(TAB_LIST_KEY);
if (!list) throw new Error("<TabTrigger> must be used inside <TabList>.");

const selected = computed(() => context.selected.value === props.value);
const isVertical = computed(() => list.orientation.value === "vertical");

const sizeClasses = {
  sm: "h-8 px-2.5 text-sm",
  md: "h-9 px-3 text-sm",
};

const triggerVariantClasses = {
  underline: {
    base: "text-ink-gray-5 hover:text-ink-gray-7",
    selected:
      "text-ink-gray-8 after:absolute after:inset-x-0 after:-bottom-px after:h-px after:bg-outline-gray-8",
    verticalSelected:
      "text-ink-gray-8 after:absolute after:inset-y-0 after:-right-px after:w-px after:bg-outline-gray-8",
  },
  subtle: {
    base: "rounded-(--radius-3) text-ink-gray-5 hover:text-ink-gray-7",
    selected: "rounded-(--radius-3) bg-surface-base text-ink-gray-8 shadow-sm",
    verticalSelected: "rounded-(--radius-3) bg-surface-base text-ink-gray-8 shadow-sm",
  },
  ghost: {
    base: "rounded-(--radius-3) text-ink-gray-5 hover:text-ink-gray-7",
    selected: "rounded-(--radius-3) bg-surface-gray-3 text-ink-gray-8",
    verticalSelected: "rounded-(--radius-3) bg-surface-gray-3 text-ink-gray-8",
  },
  "browser-tab": {
    base: "rounded-t-(--radius-4) text-ink-gray-5 hover:text-ink-gray-7",
    selected:
      "-mb-px rounded-t-(--radius-4) border border-outline-gray-2 border-b-surface-base bg-surface-base text-ink-gray-8",
    verticalSelected:
      "-mr-px rounded-l-(--radius-4) border border-outline-gray-2 border-r-surface-base bg-surface-base text-ink-gray-8",
  },
};

const classes = computed(() => {
  const variantClasses = triggerVariantClasses[list.variant.value];
  return cn(
    "relative inline-flex items-center justify-center gap-1.5 whitespace-nowrap font-medium outline-none transition-colors focus-visible:ring-2 focus-visible:ring-outline-gray-4 disabled:cursor-not-allowed disabled:opacity-50",
    sizeClasses[list.size.value],
    variantClasses.base,
    selected.value &&
      (isVertical.value
        ? variantClasses.verticalSelected
        : variantClasses.selected),
    list.variant.value === "browser-tab" && "px-3",
    isVertical.value && "w-full justify-start",
    props.class,
  );
});

function onClick() {
  if (props.disabled) return;
  context.select(props.value);
}
</script>

<template>
  <button
    type="button"
    role="tab"
    :id="tabId(context.baseId, props.value)"
    :aria-selected="selected"
    :aria-controls="panelId(context.baseId, props.value)"
    :aria-label="props.label && !slots.default ? props.label : undefined"
    :tabindex="props.disabled ? -1 : selected ? 0 : -1"
    :disabled="props.disabled"
    data-slot="tab-trigger"
    :data-state="selected ? 'active' : 'inactive'"
    :class="classes"
    @click="onClick"
  >
    <slot name="prefix" />
    <span
      v-if="typeof props.icon === 'string'"
      :class="props.icon"
      class="size-3.5"
      aria-hidden="true"
    />
    <component
      v-else-if="props.icon"
      :is="props.icon"
      class="size-3.5"
      aria-hidden="true"
    />
    <slot>{{ props.label }}</slot>
    <slot name="suffix" />
  </button>
</template>
"
`;
