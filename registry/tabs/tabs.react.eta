<% if (it.typescript) { %>import {
  createContext,
  useContext,
  useEffect,
  useId,
  useRef,
  useState,
  type ButtonHTMLAttributes,
  type HTMLAttributes,
  type KeyboardEvent,
  type ReactNode,
} from "react";
<% } else { %>import { createContext, useContext, useEffect, useId, useRef, useState } from "react";
<% } %>import { cn } from "<%= it.utilsAlias %>/utils";

<% if (it.typescript) { %>
export type TabValue = string | number;
export type TabsVariant = "underline" | "subtle" | "ghost" | "browser-tab";
export type TabsSize = "sm" | "md";
export type TabsOrientation = "horizontal" | "vertical";

type TabsContextValue = {
  value: TabValue | undefined;
  select: (value: TabValue) => void;
  orientation: TabsOrientation;
  variant: TabsVariant;
  size: TabsSize;
  baseId: string;
};

type TabListContextValue = {
  variant: TabsVariant;
  size: TabsSize;
  orientation: TabsOrientation;
};

export type TabsProps = Omit<HTMLAttributes<HTMLDivElement>, "defaultValue" | "onChange"> & {
  /** Selected tab value. Omit for uncontrolled use. */
  value?: TabValue;
  /** Initially selected tab for uncontrolled use. */
  defaultValue?: TabValue;
  /** Called when the selected tab changes. */
  onValueChange?: (value: TabValue) => void;
  /** Visual treatment of the trigger row. */
  variant?: TabsVariant;
  /** Height and padding of the triggers. */
  size?: TabsSize;
  /** Render the list vertically instead of horizontally. */
  vertical?: boolean;
  /** Explicit orientation; wins over `vertical`. */
  orientation?: TabsOrientation;
};

export type TabListProps = HTMLAttributes<HTMLDivElement> & {
  variant?: TabsVariant;
  size?: TabsSize;
};

export type TabTriggerProps = Omit<ButtonHTMLAttributes<HTMLButtonElement>, "value"> & {
  /** Value this trigger selects. */
  value: TabValue;
  /** Visible label. Children take precedence. */
  label?: ReactNode;
  /** Leading icon before the label. */
  icon?: ReactNode;
  /** Content before the icon and label. */
  prefix?: ReactNode;
  /** Content after the label, such as a count. */
  suffix?: ReactNode;
};

export type TabPanelProps = HTMLAttributes<HTMLDivElement> & {
  /** Value of the trigger that owns this panel. */
  value: TabValue;
  /** Keep the panel mounted while hidden. */
  keepMounted?: boolean;
};
<% } %>

const TabsContext = createContext<% if (it.typescript) { %><TabsContextValue | null><% } %>(null);
const TabListContext = createContext<% if (it.typescript) { %><TabListContextValue | null><% } %>(null);

function useTabsContext() {
  const context = useContext(TabsContext);
  if (!context) throw new Error("Tabs parts must be used inside <Tabs>.");
  return context;
}

function useTabListContext() {
  const context = useContext(TabListContext);
  if (!context) throw new Error("<TabTrigger> must be used inside <TabList>.");
  return context;
}

function slug(value<% if (it.typescript) { %>: TabValue<% } %>) {
  return String(value).replace(/[^a-zA-Z0-9_-]/g, "-");
}

function tabId(baseId<% if (it.typescript) { %>: string<% } %>, value<% if (it.typescript) { %>: TabValue<% } %>) {
  return `${baseId}-tab-${slug(value)}`;
}

function panelId(baseId<% if (it.typescript) { %>: string<% } %>, value<% if (it.typescript) { %>: TabValue<% } %>) {
  return `${baseId}-panel-${slug(value)}`;
}

const sizeClasses = {
  sm: "h-8 px-2.5 text-sm",
  md: "h-9 px-3 text-sm",
};

const triggerVariantClasses = {
  underline: {
    base: "text-ink-gray-5 hover:text-ink-gray-7",
    selected:
      "text-ink-gray-8 after:absolute after:inset-x-0 after:-bottom-px after:h-px after:bg-outline-gray-8",
    verticalSelected:
      "text-ink-gray-8 after:absolute after:inset-y-0 after:-right-px after:w-px after:bg-outline-gray-8",
  },
  subtle: {
    base: "rounded-(--radius-3) text-ink-gray-5 hover:text-ink-gray-7",
    selected: "rounded-(--radius-3) bg-surface-base text-ink-gray-8 shadow-sm",
    verticalSelected: "rounded-(--radius-3) bg-surface-base text-ink-gray-8 shadow-sm",
  },
  ghost: {
    base: "rounded-(--radius-3) text-ink-gray-5 hover:text-ink-gray-7",
    selected: "rounded-(--radius-3) bg-surface-gray-3 text-ink-gray-8",
    verticalSelected: "rounded-(--radius-3) bg-surface-gray-3 text-ink-gray-8",
  },
  "browser-tab": {
    base: "rounded-t-(--radius-4) text-ink-gray-5 hover:text-ink-gray-7",
    selected:
      "-mb-px rounded-t-(--radius-4) border border-outline-gray-2 border-b-surface-base bg-surface-base text-ink-gray-8",
    verticalSelected:
      "-mr-px rounded-l-(--radius-4) border border-outline-gray-2 border-r-surface-base bg-surface-base text-ink-gray-8",
  },
};

const listVariantClasses = {
  underline: {
    horizontal: "relative flex items-center border-b border-outline-gray-2",
    vertical: "relative flex flex-col border-r border-outline-gray-2",
  },
  subtle: {
    horizontal: "inline-flex items-center gap-1 rounded-(--radius-4) bg-surface-gray-2 p-1",
    vertical: "inline-flex flex-col items-stretch gap-1 rounded-(--radius-4) bg-surface-gray-2 p-1",
  },
  ghost: {
    horizontal: "inline-flex items-center gap-1 rounded-(--radius-4) p-1",
    vertical: "inline-flex flex-col items-stretch gap-1 rounded-(--radius-4) p-1",
  },
  "browser-tab": {
    horizontal: "relative flex items-end gap-1 border-b border-outline-gray-2",
    vertical: "relative flex flex-col gap-1 border-r border-outline-gray-2",
  },
};

export function Tabs({
  value,
  defaultValue,
  onValueChange,
  variant = "underline",
  size = "sm",
  vertical = false,
  orientation,
  className,
  children,
  ...props
}<% if (it.typescript) { %>: TabsProps<% } %>) {
  const [internalValue, setInternalValue] = useState(defaultValue);
  const selected = value !== undefined ? value : internalValue;
  const resolvedOrientation = orientation ?? (vertical ? "vertical" : "horizontal");
  const baseId = useId().replace(/:/g, "");

  function select(next<% if (it.typescript) { %>: TabValue<% } %>) {
    if (value === undefined) setInternalValue(next);
    onValueChange?.(next);
  }

  return (
    <TabsContext.Provider
      value={{ value: selected, select, orientation: resolvedOrientation, variant, size, baseId }}
    >
      <div
        data-slot="tabs"
        data-orientation={resolvedOrientation}
        data-variant={variant}
        data-size={size}
        className={cn("min-w-0", className)}
        {...props}
      >
        {children}
      </div>
    </TabsContext.Provider>
  );
}

export function TabList({ variant, size, className, children, onKeyDown, ...props }<% if (it.typescript) { %>: TabListProps<% } %>) {
  const context = useTabsContext();
  const rootRef = useRef<% if (it.typescript) { %><HTMLDivElement><% } %>(null);
  const listVariant = variant ?? context.variant;
  const listSize = size ?? context.size;
  const isVertical = context.orientation === "vertical";

  useEffect(() => {
    if (context.value !== undefined) return;
    const first = rootRef.current?.querySelector<% if (it.typescript) { %><HTMLButtonElement><% } %>('[role="tab"]:not(:disabled)');
    first?.click();
  }, [context.value]);

  function handleKeyDown(event<% if (it.typescript) { %>: KeyboardEvent<HTMLDivElement><% } %>) {
    onKeyDown?.(event);
    if (event.defaultPrevented) return;

    const tabs = Array.from(
      rootRef.current?.querySelectorAll<% if (it.typescript) { %><HTMLButtonElement><% } %>('[role="tab"]:not(:disabled)') ?? [],
    );
    if (!tabs.length) return;

    const currentIndex = tabs.indexOf(document.activeElement<% if (it.typescript) { %> as HTMLButtonElement<% } %>);
    const nextKey = isVertical ? ["ArrowDown", "ArrowUp"] : ["ArrowRight", "ArrowLeft"];
    let nextIndex = currentIndex;

    if (event.key === "Home") nextIndex = 0;
    else if (event.key === "End") nextIndex = tabs.length - 1;
    else if (event.key === nextKey[0] || event.key === nextKey[1]) {
      const direction = event.key === nextKey[0] ? 1 : -1;
      nextIndex = (Math.max(currentIndex, 0) + direction + tabs.length) % tabs.length;
    } else {
      return;
    }

    event.preventDefault();
    const next = tabs[nextIndex];
    next.focus();
    next.click();
  }

  return (
    <TabListContext.Provider
      value={{ variant: listVariant, size: listSize, orientation: context.orientation }}
    >
      <div
        ref={rootRef}
        role="tablist"
        aria-orientation={context.orientation}
        data-slot="tab-list"
        data-variant={listVariant}
        data-size={listSize}
        className={cn(
          listVariantClasses[listVariant][context.orientation],
          isVertical && "self-start",
          className,
        )}
        onKeyDown={handleKeyDown}
        {...props}
      >
        {children}
      </div>
    </TabListContext.Provider>
  );
}

export function TabTrigger({
  value,
  label,
  icon,
  prefix,
  suffix,
  disabled = false,
  className,
  children,
  onClick,
  ...props
}<% if (it.typescript) { %>: TabTriggerProps<% } %>) {
  const context = useTabsContext();
  const list = useTabListContext();
  const selected = context.value === value;
  const isVertical = list.orientation === "vertical";
  const variantClasses = triggerVariantClasses[list.variant];

  return (
    <button
      type="button"
      role="tab"
      id={tabId(context.baseId, value)}
      aria-selected={selected}
      aria-controls={panelId(context.baseId, value)}
      tabIndex={disabled ? -1 : selected ? 0 : -1}
      disabled={disabled}
      data-slot="tab-trigger"
      data-state={selected ? "active" : "inactive"}
      className={cn(
        "relative inline-flex items-center justify-center gap-1.5 whitespace-nowrap font-medium outline-none transition-colors focus-visible:ring-2 focus-visible:ring-outline-gray-4 disabled:cursor-not-allowed disabled:opacity-50",
        sizeClasses[list.size],
        variantClasses.base,
        selected && (isVertical && variantClasses.verticalSelected
          ? variantClasses.verticalSelected
          : variantClasses.selected),
        list.variant === "browser-tab" && "px-3",
        isVertical && "w-full justify-start",
        className,
      )}
      onClick={(event) => {
        onClick?.(event);
        if (!event.defaultPrevented) context.select(value);
      }}
      {...props}
    >
      {prefix}
      {icon}
      {children ?? label}
      {suffix}
    </button>
  );
}

export function TabPanel({ value, keepMounted = false, className, children, ...props }<% if (it.typescript) { %>: TabPanelProps<% } %>) {
  const context = useTabsContext();
  const selected = context.value === value;

  if (!selected && !keepMounted) return null;

  return (
    <div
      role="tabpanel"
      id={panelId(context.baseId, value)}
      aria-labelledby={tabId(context.baseId, value)}
      tabIndex={0}
      hidden={!selected}
      data-slot="tab-panel"
      className={cn("outline-none", className)}
      {...props}
    >
      {children}
    </div>
  );
}
