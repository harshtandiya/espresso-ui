<script lang="ts">
import type { ComputedRef, InjectionKey } from "vue";
import type { TabsOrientation, TabsSize, TabsVariant } from "./Tabs.vue";

export type TabListContext = {
  variant: ComputedRef<TabsVariant>;
  size: ComputedRef<TabsSize>;
  orientation: ComputedRef<TabsOrientation>;
};

export const TAB_LIST_KEY: InjectionKey<TabListContext> = Symbol.for(
  "espresso-ui.tab-list",
);
</script>

<script setup lang="ts">
import { computed, inject, onMounted, provide, ref } from "vue";
import { cn } from "<%= it.utilsAlias %>/utils";
import { TABS_KEY } from "./Tabs.vue";

const props = withDefaults(
  defineProps<{
    variant?: TabsVariant;
    size?: TabsSize;
    class?: string;
  }>(),
  {},
);

const context = inject(TABS_KEY);
if (!context) throw new Error("<TabList> must be used inside <Tabs>.");

const variant = computed(() => props.variant ?? context.variant.value);
const size = computed(() => props.size ?? context.size.value);
const orientation = computed(() => context.orientation.value);
const isVertical = computed(() => orientation.value === "vertical");
const listRef = ref<HTMLElement | null>(null);

provide(TAB_LIST_KEY, { variant, size, orientation });

const listVariantClasses = {
  underline: {
    horizontal: "relative flex items-center border-b border-outline-gray-2",
    vertical: "relative flex flex-col border-r border-outline-gray-2",
  },
  subtle: {
    horizontal: "inline-flex items-center gap-1 rounded-(--radius-4) bg-surface-gray-2 p-1",
    vertical:
      "inline-flex flex-col items-stretch gap-1 rounded-(--radius-4) bg-surface-gray-2 p-1",
  },
  ghost: {
    horizontal: "inline-flex items-center gap-1 rounded-(--radius-4) p-1",
    vertical: "inline-flex flex-col items-stretch gap-1 rounded-(--radius-4) p-1",
  },
  "browser-tab": {
    horizontal: "relative flex items-end gap-1 border-b border-outline-gray-2",
    vertical: "relative flex flex-col gap-1 border-r border-outline-gray-2",
  },
};

const classes = computed(() =>
  cn(
    listVariantClasses[variant.value][orientation.value],
    isVertical.value && "self-start",
    props.class,
  ),
);

onMounted(() => {
  if (context.selected.value !== undefined) return;
  const first = listRef.value?.querySelector<HTMLButtonElement>(
    '[role="tab"]:not(:disabled)',
  );
  first?.click();
});

function onKeydown(event: KeyboardEvent) {
  const tabs = Array.from(
    listRef.value?.querySelectorAll<HTMLButtonElement>('[role="tab"]:not(:disabled)') ?? [],
  );
  if (!tabs.length) return;

  const currentIndex = tabs.indexOf(document.activeElement as HTMLButtonElement);
  const nextKeys = isVertical.value ? ["ArrowDown", "ArrowUp"] : ["ArrowRight", "ArrowLeft"];
  let nextIndex = currentIndex;

  if (event.key === "Home") nextIndex = 0;
  else if (event.key === "End") nextIndex = tabs.length - 1;
  else if (event.key === nextKeys[0] || event.key === nextKeys[1]) {
    const direction = event.key === nextKeys[0] ? 1 : -1;
    nextIndex = (Math.max(currentIndex, 0) + direction + tabs.length) % tabs.length;
  } else {
    return;
  }

  event.preventDefault();
  const next = tabs[nextIndex];
  next.focus();
  next.click();
}
</script>

<template>
  <div
    ref="listRef"
    role="tablist"
    :aria-orientation="orientation"
    data-slot="tab-list"
    :data-variant="variant"
    :data-size="size"
    :class="classes"
    @keydown="onKeydown"
  >
    <slot />
  </div>
</template>
